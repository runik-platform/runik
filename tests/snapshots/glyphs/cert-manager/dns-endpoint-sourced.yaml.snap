# Source: kaster/templates/kaster.yaml
kind: ConfigMap
apiVersion: v1
metadata:
  name: update-dns-sh
  labels:
    app.kubernetes.io/name: test-dkim-record-updater
    app.kubernetes.io/instance: test
    app.kubernetes.io/managed-by: Helm
    spell: test-dkim-record-updater
data:
  
  update-dns-sh: |
    
    #!/bin/bash
    set -e
    echo "DNSEndpoint Updater for default._domainkey.test.example.com"
    echo "====================================="
    
    # Wait for Secret to exist (VaultSecret syncs from Vault)
    echo "Waiting for Secret test-dkim..."
    until kubectl get secret test-dkim -n glyphs-release > /dev/null 2>&1; do
      echo "  Secret not found yet, retrying in 5s..."
      sleep 5
    done
    echo "Secret found!"
    
    # Extract target value from Secret
    echo "Reading value from Secret key: public_key_base64"
    TARGET_VALUE=$(kubectl get secret test-dkim -n glyphs-release -o jsonpath='{.data.public_key_base64}' | base64 -d)
    
    if [ -z "$TARGET_VALUE" ]; then
      echo "ERROR: Secret key 'public_key_base64' is empty or doesn't exist"
      exit 1
    fi
    
    echo "Raw value (first 80 chars): ${TARGET_VALUE:0:80}..."
    
    # Format DNS record if format string provided
    DNS_VALUE=$(printf "v=DKIM1; k=ed25519; p=%s" "$TARGET_VALUE")
    echo "Formatted DNS record: ${DNS_VALUE:0:80}..."
    
    # Patch DNSEndpoint with actual value
    echo "Updating DNSEndpoint test-dkim-record..."
    kubectl patch dnsendpoint test-dkim-record -n glyphs-release \
      --type=json \
      -p="[{\"op\": \"replace\", \"path\": \"/spec/endpoints/0/targets/0\", \"value\": \"$DNS_VALUE\"}]"
    
    echo "DNSEndpoint updated successfully!"
    echo ""
    echo "DNS record will be created by external-dns:"
    echo "   Name: default._domainkey.test.example.com"
    echo "   Type: TXT"
    echo "   Value: ${DNS_VALUE:0:100}..."
---
