# Source: kaster/templates/kaster.yaml
apiVersion: batch/v1
kind: Job
metadata:
  name: test-dkim-record-updater
  labels:
    app.kubernetes.io/name: test-dkim-record-updater
    app.kubernetes.io/instance: test
    app.kubernetes.io/managed-by: Helm
    spell: test-dkim-record-updater
spec:
  backoffLimit: 5
  template:
    metadata:
      labels:
        app.kubernetes.io/name: test-dkim-record-updater
        app.kubernetes.io/instance: test
      
      annotations:
        checksum/configmap-updater-script: 6abb950c80e5c83691bc6dea3eaa7c6999dd3a5a23a8c91c0b0a4f33e8984308
        helm.sh/hook: post-install,post-upgrade
        helm.sh/hook-delete-policy: before-hook-creation
        helm.sh/hook-weight: "0"
    spec:
      serviceAccountName: test-dkim-record-updater
      restartPolicy: OnFailure
      
      containers:
        
        - name: test-dkim-record-updater-test-dkim-record-updater
          image: docker.io/bitnami/kubectl:latest
          imagePullPolicy: IfNotPresent
          command:
            - /bin/bash
          args:
            - /scripts/update-dns.sh
          
          resources:
            limits:
              cpu: 100m
              memory: 128Mi
            requests:
              cpu: 50m
              memory: 64Mi
          
          volumeMounts:
          
            - name: update-dns-sh
              
              mountPath: /scripts/update-dns.sh
              
              subPath: update-dns-sh
          
          
          
      
      volumes:
      
        - name: update-dns-sh
          configMap:
            name: update-dns-sh
---
