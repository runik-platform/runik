# Source: kaster/templates/kaster.yaml
kind: Certificate
apiVersion: cert-manager.io/v1
metadata:
  name: app-tls-letsencrypt-production-cert
  labels:
    app.kubernetes.io/name: test
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: my-app
    app.kubernetes.io/managed-by: Helm
    spelbook: my-app
    chapter: production
    spell: kaster
spec:
  commonName: myapp.com
  dnsNames:
  - myapp.com
  issuerRef:
    kind: ClusterIssuer
    name: letsencrypt-production
  secretName: test-app-tls-cert
