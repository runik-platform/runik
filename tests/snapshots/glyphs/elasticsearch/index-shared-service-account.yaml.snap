# Source: kaster/templates/kaster.yaml
apiVersion: redhatcop.redhat.io/v1alpha1
kind: Policy
metadata:
  name: fulltext
  namespace: vault
  labels:
    app.kubernetes.io/name: fulltext
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: test-book
    app.kubernetes.io/managed-by: Helm
    spelbook: test-book
    chapter: huly
    spell: fulltext
  annotations:
    argocd.argoproj.io/sync-wave: "-5"
spec:
  authentication:
    path: test-book
    role: vault
    serviceAccount:
      name: vault
  connection:
    address: http://vault.vault.svc:8200
    tLSConfig:
      skipVerify: false
  policy: |
    path "secret/data/test-book/huly/glyphs-release/*" {
      capabilities = ["create","read","update","delete","list"]
    }
    path "secret/metadata/test-book/huly/glyphs-release/*" {
      capabilities = ["create","read","update","delete","list"]
    }
    path "secret/data/test-book/huly/publics/*" {
      capabilities = ["read","list"]
    }
    path "secret/metadata/test-book/huly/publics/*" {
      capabilities = ["read","list"]
    }
    path "secret/data/test-book/publics/*" {
      capabilities = ["read","list"]
    }
    path "secret/metadata/test-book/publics/*" {
      capabilities = ["read","list"]
    }
    path "secret/data/test-book/pipelines/*" {
      capabilities = ["read","list"]
    }
    path "secret/metadata/test-book/pipelines/*" {
      capabilities = ["read","list"]
    }
    path "sys/policies/password/*" {
      capabilities = ["read","list"]
    }
    path "db/test-book/huly/fulltext/creds/*" {
      capabilities = ["read"]
    }
    path "db/test-book/huly/fulltext/static-creds/*" {
      capabilities = ["read"]
    }
    path "sys/mounts" {
      capabilities = ["read"]
    }
    path "sys/mounts/db/test-book/huly/fulltext" {
      capabilities = ["create","read","update","delete"]
    }
---
