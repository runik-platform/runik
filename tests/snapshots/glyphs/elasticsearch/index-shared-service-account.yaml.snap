# Source: kaster/templates/kaster.yaml
apiVersion: redhatcop.redhat.io/v1alpha1
kind: DatabaseSecretEngineConfig
metadata:
  name: fulltext-elastic-infra
  namespace: elastic-infra
  labels:
    app.kubernetes.io/name: fulltext
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: test-book
    app.kubernetes.io/managed-by: Helm
    spelbook: test-book
    chapter: huly
    spell: fulltext
  annotations:
    argocd.argoproj.io/sync-wave: "-2"
spec:
  authentication:
    path: test-book
    role: elastic-infra
    serviceAccount:
      name: elastic-infra
  connection:
    address: http://vault.vault.svc:8200
    tLSConfig:
      skipVerify: false
  pluginName: elasticsearch-database-plugin
  allowedRoles:
    - search
  passwordAuthentication: "password"
  databaseSpecificConfig:
    url: http://elastic-infra-es-http.elastic-infra.svc:9200
  verifyConnection: true
  username: elastic
  rootCredentials:
    secret:
      name: elastic-infra-es-elastic-user
    passwordKey: elastic
    usernameKey: username
  path: db/test-book/huly/fulltext
  rootPasswordRotation:
    rotationPeriod: "0s"
---
