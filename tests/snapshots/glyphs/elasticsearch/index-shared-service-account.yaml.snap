apiVersion: redhatcop.redhat.io/v1alpha1
kind: DatabaseSecretEngineRole
metadata:
  name: search
  namespace: vault
  labels:
    app.kubernetes.io/name: fulltext
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: test-book
    app.kubernetes.io/managed-by: Helm
    spelbook: test-book
    chapter: huly
    spell: fulltext
spec:
  authentication:
    path: test-book
    role: vault
    serviceAccount:
      name: vault
  connection:
    address: http://vault.vault.svc:8200
    tLSConfig:
      skipVerify: false
  path: db/test-book/huly/fulltext
  dBName: fulltext-elastic-infra
  creationStatements:
    - '{"elasticsearch_role_definition":{"indices":[{"names":["huly-production","huly-production-*"],"privileges":["read","write","create_index","view_index_metadata"]}]}}'
