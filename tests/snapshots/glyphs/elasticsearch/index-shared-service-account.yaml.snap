apiVersion: redhatcop.redhat.io/v1alpha1
kind: SecretEngineMount
metadata:
  name: fulltext
  namespace: glyphs-release
  labels:
    app.kubernetes.io/name: fulltext
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: test-book
    app.kubernetes.io/managed-by: Helm
    spelbook: test-book
    chapter: huly
    spell: fulltext
  annotations:
    argocd.argoproj.io/sync-wave: "-3"
spec:
  authentication:
    path: test-book
    role: fulltext
    serviceAccount:
      name: huly
  connection:
    address: http://vault.vault.svc:8200
    tLSConfig:
      skipVerify: false
  type: database
  path: db/test-book/huly
  description: "Runik database credentials for test-book/huly/fulltext"
  config:
    listingVisibility: hidden
---
# Source: kaster/templates/kaster.yaml
apiVersion: redhatcop.redhat.io/v1alpha1
kind: VaultSecret
metadata:
  name: search
  labels:
    app.kubernetes.io/name: fulltext
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: test-book
    app.kubernetes.io/managed-by: Helm
    spelbook: test-book
    chapter: huly
    spell: fulltext
spec:
  refreshThreshold: 90
  refreshPeriod: 30m0s
  vaultSecretDefinitions:
    - name: secret
      requestType: GET
      path: db/test-book/huly/fulltext/creds/search
      authentication:
        path: test-book
        role: fulltext
        serviceAccount:
          name: huly
      connection:
        address: http://vault.vault.svc:8200
        tLSConfig:
          skipVerify: false
  output:
    name: search
    labels:
      app.kubernetes.io/name: fulltext
      app.kubernetes.io/instance: test
      app.kubernetes.io/part-of: test-book
      app.kubernetes.io/managed-by: Helm
      spelbook: test-book
      chapter: huly
      spell: fulltext
    stringData: #tiene q haber una forma de hacer q esto funcione con un range del lado del operator para q no hagan falta las keys
        USERNAME: '{{ .secret.username }}'
        PASSWORD: '{{ .secret.password }}'
        HOST: "elastic-infra-es-http.elastic-infra.svc"
        INDEX: "huly-production"
        PORT: "9200"
        SCHEME: "http"
        URL: "http://elastic-infra-es-http.elastic-infra.svc:9200"
    type: Opaque
