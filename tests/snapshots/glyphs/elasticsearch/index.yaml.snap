# Source: kaster/templates/kaster.yaml
apiVersion: redhatcop.redhat.io/v1alpha1
kind: DatabaseSecretEngineConfig
metadata:
  name: search-app-shared-elastic
  namespace: elastic-infra
  labels:
    app.kubernetes.io/name: search-app
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: test-book
    app.kubernetes.io/managed-by: Helm
    spelbook: test-book
    chapter: apps
    spell: search-app
  annotations:
    argocd.argoproj.io/sync-wave: "-2"
spec:
  authentication:
    path: the-yaml-life
    role: shared-elastic
    serviceAccount:
      name: shared-elastic
  connection:
    address: http://vault.vault.svc:8200
    tLSConfig:
      skipVerify: false
  pluginName: elasticsearch-database-plugin
  allowedRoles:
    - search-app
  passwordAuthentication: "password"
  databaseSpecificConfig:
    url: http://shared-elastic-es-http.elastic-infra.svc:9200
  verifyConnection: true
  username: elastic
  rootCredentials:
    secret:
      name: shared-elastic-es-elastic-user
    passwordKey: elastic
    usernameKey: username
  path: db/test-book/apps/search-app
  rootPasswordRotation:
    rotationPeriod: "0s"
