# Source: kaster/templates/kaster.yaml
apiVersion: redhatcop.redhat.io/v1alpha1
kind: SecretEngineMount
metadata:
  name: search-app
  namespace: glyphs-release
  labels:
    app.kubernetes.io/name: search-app
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: test-book
    app.kubernetes.io/managed-by: Helm
    spelbook: test-book
    chapter: apps
    spell: search-app
  annotations:
    argocd.argoproj.io/sync-wave: "-3"
spec:
  authentication:
    path: the-yaml-life
    role: search-app
    serviceAccount:
      name: search-app
  connection:
    address: http://vault.vault.svc:8200
    tLSConfig:
      skipVerify: false
  type: database
  path: db/test-book/apps
  description: "Runik database credentials for test-book/apps/search-app"
  config:
    listingVisibility: hidden
---
# Source: kaster/templates/kaster.yaml
apiVersion: redhatcop.redhat.io/v1alpha1
kind: VaultSecret
metadata:
  name: search-app
  labels:
    app.kubernetes.io/name: search-app
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: test-book
    app.kubernetes.io/managed-by: Helm
    spelbook: test-book
    chapter: apps
    spell: search-app
spec:
  refreshThreshold: 90
  refreshPeriod: 30m0s
  vaultSecretDefinitions:
    - name: secret
      requestType: GET
      path: db/test-book/apps/search-app/creds/search-app
      authentication:
        path: the-yaml-life
        role: search-app
        serviceAccount:
          name: search-app
      connection:
        address: http://vault.vault.svc:8200
        tLSConfig:
          skipVerify: false
  output:
    name: search-app
    labels:
      app.kubernetes.io/name: search-app
      app.kubernetes.io/instance: test
      app.kubernetes.io/part-of: test-book
      app.kubernetes.io/managed-by: Helm
      spelbook: test-book
      chapter: apps
      spell: search-app
    stringData: #tiene q haber una forma de hacer q esto funcione con un range del lado del operator para q no hagan falta las keys
        USERNAME: '{{ .secret.username }}'
        PASSWORD: '{{ .secret.password }}'
        HOST: "shared-elastic-es-http.elastic-infra.svc"
        INDEX: "search-app"
        PORT: "9200"
        SCHEME: "http"
        URL: "http://shared-elastic-es-http.elastic-infra.svc:9200"
    type: Opaque
