kind: DatabaseSecretEngineRole
metadata:
  name: search-app
  namespace: vault
  labels:
    app.kubernetes.io/name: search-app
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: test-book
    app.kubernetes.io/managed-by: Helm
    spelbook: test-book
    chapter: apps
    spell: search-app
spec:
  authentication:
    path: the-yaml-life
    role: vault
    serviceAccount:
      name: vault
  connection:
    address: http://vault.vault.svc:8200
    tLSConfig:
      skipVerify: false
  path: db/test-book/apps/search-app
  dBName: search-app-shared-elastic
  creationStatements:
    - '{"elasticsearch_role_definition":{"indices":[{"names":["search-app","search-app-*"],"privileges":["read","write","create_index","view_index_metadata"]}]}}'
