---
# Source: kaster/templates/kaster.yaml
apiVersion: argoproj.io/v1alpha1
kind: Sensor
metadata:
  name: repository-ci
  namespace: argo-events
  labels:
    app.kubernetes.io/name: repository-ci
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: example
    app.kubernetes.io/managed-by: Helm
spec:
  eventBusName: shared-events
  template:
    serviceAccountName: repository-ci
  dependencies:
    
    - name: push
      eventSourceName: forgejo
      eventName: webhook
  triggers:
    - template:
        name: repository-workflow
        argoWorkflow:
          operation: submit
          args:
            - --parameter=ci-sha=
          source:
            git:
              filePath: .argo/workflow.yaml
              ref: HEAD
              url: ssh://git@git.example.test/owner/repository.git
          
          parameters:
            - dest: metadata.namespace
              src:
                dependencyName: push
                value: repository-workflows
      parameters:
        - dest: argoWorkflow.source.git.ref
          src:
            dataKey: body.after
            dependencyName: push
        - dest: argoWorkflow.args.0
          src:
            dataTemplate: --parameter=ci-sha={{ .Input.body.after }}
            dependencyName: push
