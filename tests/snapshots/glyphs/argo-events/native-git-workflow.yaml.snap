apiVersion: v1
metadata:
  name: git-known-hosts
  namespace: argo-events
  labels:
    app.kubernetes.io/name: repository-ci
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: example
    app.kubernetes.io/managed-by: Helm
    spelbook: example
    chapter: workflows
    spell: repository-ci
data:
  
  ssh_known_hosts: "git.example.test ssh-ed25519 example-public-key"
