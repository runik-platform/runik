# Source: kaster/templates/kaster.yaml
apiVersion: argoproj.io/v1alpha1
kind: EventSource
metadata:
  name: secret-annotation-source
  labels:
    app.kubernetes.io/name: resource-secret-annotation-monitor
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: example-book
    app.kubernetes.io/managed-by: Helm
spec:
  eventBusName: monitoring-eventbus
  resource:
    secret-monitoring:
      namespace: default
      version: v1
      resource: secrets
      eventTypes:
        - UPDATE
      filter:
        expression: |
          has(body.metadata.annotations) &&
          has(body.metadata.annotations['runik.ing/rotate']) &&
          body.metadata.annotations['runik.ing/rotate'] == 'true'
---
# Source: kaster/templates/kaster.yaml
apiVersion: argoproj.io/v1alpha1
kind: Sensor
metadata:
  name: secret-rotation-sensor
  labels:
    app.kubernetes.io/name: resource-secret-annotation-monitor
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: example-book
    app.kubernetes.io/managed-by: Helm
spec:
  eventBusName: monitoring-eventbus
  template:
    serviceAccountName: secret-rotator
  dependencies:
    
    - name: secret-rotation-event
      eventSourceName: secret-annotation-source
      eventName: secret-monitoring
      filters:
        data:
          - path: body.metadata.annotations.runik\.io/rotate
            type: string
            value:
              - "true"
  triggers:
    - template:
        name: rotate-secret-workflow
        argoWorkflow:
          operation: submit
          source:
            resource:
              apiVersion: argoproj.io/v1alpha1
              kind: Workflow
              metadata:
                generateName: rotate-secret-
                namespace: default
              spec:
                arguments:
                  parameters:
                  - name: secret-name
                    value: default-secret
                  - name: secret-namespace
                    value: default
                entrypoint: rotate
                serviceAccountName: secret-rotator
                templates:
                - container:
                    args:
                    - |
                      echo "Rotating secret {{workflow.parameters.secret-name}} in namespace {{workflow.parameters.secret-namespace}}"
                      kubectl get secret {{workflow.parameters.secret-name}} -n {{workflow.parameters.secret-namespace}}
                    command:
                    - sh
                    - -c
                    image: bitnami/kubectl:latest
                  name: rotate
          
          parameters:
            - src:
                dependencyName: secret-rotation-event
                dataKey: body.metadata.name
              dest: spec.arguments.parameters.0.value
            - src:
                dependencyName: secret-rotation-event
                dataKey: body.metadata.namespace
              dest: spec.arguments.parameters.1.value
