# Source: kaster/templates/kaster.yaml
apiVersion: argoproj.io/v1alpha1
kind: Sensor
metadata:
  name: workflow-sensor
  labels:
    app.kubernetes.io/name: workflow-parameter-propagation
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: example-book
    app.kubernetes.io/managed-by: Helm
spec:
  eventBusName: automation-eventbus
  template:
    serviceAccountName: workflow-sensor
  dependencies:
    
    - name: webhook-event
      eventSourceName: webhook-source
      eventName: generic-hook
  triggers:
    - template:
        name: build-workflow
        argoWorkflow:
          operation: submit
          source:
            resource:
              apiVersion: argoproj.io/v1alpha1
              kind: Workflow
              metadata:
                generateName: build-
                namespace: builds
              spec:
                arguments:
                  parameters:
                  - name: revision
                    value: ""
                workflowTemplateRef:
                  name: build
          
          parameters:
            - src:
                dependencyName: webhook-event
                dataKey: body.after
              dest: spec.arguments.parameters.0.value
