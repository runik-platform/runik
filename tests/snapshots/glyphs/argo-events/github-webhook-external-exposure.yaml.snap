---
# Source: kaster/templates/kaster.yaml
apiVersion: v1
kind: Service
metadata:
  name: github-external-source
  labels:
    app.kubernetes.io/name: argo-events-github-external
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: example-book
    app.kubernetes.io/managed-by: Helm
spec:
  type: ClusterIP
  ports:
    - name: webhook
      port: 12000
      targetPort: 12000
      protocol: TCP
  selector:
    eventsource-name: github-external-source
---
