spec:
  refreshThreshold: 90
  refreshPeriod: 3m0s
  vaultSecretDefinitions:
    - name: secret
      requestType: GET
      path: secret/data/test-book/publics/crdb-insecure-vault-manager
      authentication:
        path: test-book
