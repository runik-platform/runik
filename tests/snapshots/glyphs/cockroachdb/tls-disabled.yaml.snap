---
# Source: kaster/templates/kaster.yaml
apiVersion: batch/v1
kind: Job
metadata:
  name: crdb-insecure-bootstrap
  namespace: cockroachdb
  labels:
    app.kubernetes.io/name: insecure-consumer
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: test-book
    app.kubernetes.io/managed-by: Helm
    spelbook: test-book
    chapter: development
    spell: insecure-consumer
  annotations:
    argocd.argoproj.io/hook: Sync
    argocd.argoproj.io/hook-delete-policy: BeforeHookCreation
    argocd.argoproj.io/sync-wave: "0"
spec:
  backoffLimit: 20
  activeDeadlineSeconds: 1800
  template:
    metadata:
      labels:
        app.kubernetes.io/name: insecure-consumer
        app.kubernetes.io/instance: test
    spec:
      automountServiceAccountToken: false
      restartPolicy: OnFailure
      containers:
        - name: bootstrap
          image: cockroachdb/cockroach:v26.2.5
          imagePullPolicy: IfNotPresent
          args:
            - sql
            - --host=crdb-insecure-public.cockroachdb.svc:26257
            - --user=root
            - --file=/bootstrap/bootstrap.sql
            - --insecure
          resources:
            limits:
              cpu: 250m
              memory: 256Mi
            requests:
              cpu: 50m
              memory: 64Mi
          volumeMounts:
            - name: bootstrap
              mountPath: /bootstrap
              readOnly: true
      volumes:
        - name: bootstrap
          secret:
            secretName: crdb-insecure-vault-manager
            items:
              - key: bootstrap.sql
                path: bootstrap.sql
---
