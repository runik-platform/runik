# Source: kaster/templates/kaster.yaml
apiVersion: redhatcop.redhat.io/v1alpha1
kind: VaultSecret
metadata:
  name: insecure-consumer
  labels:
    app.kubernetes.io/name: insecure-consumer
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: test-book
    app.kubernetes.io/managed-by: Helm
    spelbook: test-book
    chapter: development
    spell: insecure-consumer
  annotations:
    runik.ing/cockroachdb-cluster: crdb-insecure
spec:
  refreshThreshold: 80
  vaultSecretDefinitions:
    - name: secret
      requestType: GET
      path: db/test-book/development/insecure-consumer/creds/insecure-consumer
      authentication:
        path: test-book
        role: insecure-consumer
        serviceAccount:
          name: insecure-consumer
      connection:
        address: http://vault.vault.svc:8200
        tLSConfig:
          skipVerify: false
  output:
    name: insecure-consumer
    labels:
      app.kubernetes.io/name: insecure-consumer
      app.kubernetes.io/instance: test
      app.kubernetes.io/part-of: test-book
      app.kubernetes.io/managed-by: Helm
      spelbook: test-book
      chapter: development
      spell: insecure-consumer
    annotations:
      runik.ing/cockroachdb-cluster: crdb-insecure
    stringData: #tiene q haber una forma de hacer q esto funcione con un range del lado del operator para q no hagan falta las keys
        USERNAME: '{{ .secret.username }}'
        PASSWORD: '{{ .secret.password }}'
        DATABASE: insecure-consumer
        DBNAME: insecure-consumer
        HOST: crdb-insecure-public.cockroachdb.svc
        PORT: "26257"
        SSLMODE: disable
    type: Opaque
