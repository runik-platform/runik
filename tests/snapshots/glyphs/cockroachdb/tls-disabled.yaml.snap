# Source: kaster/templates/kaster.yaml
apiVersion: redhatcop.redhat.io/v1alpha1
kind: VaultSecret
metadata:
  name: crdb-insecure-vault-manager
  namespace: cockroachdb
  labels:
    app.kubernetes.io/name: insecure-consumer
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: test-book
    app.kubernetes.io/managed-by: Helm
    spelbook: test-book
    chapter: development
    spell: insecure-consumer
  annotations:
    runik.ing/cockroachdb-cluster: crdb-insecure
spec:
  refreshThreshold: 90
  refreshPeriod: 3m0s
  vaultSecretDefinitions:
    - name: secret
      requestType: GET
      path: secret/data/test-book/publics/crdb-insecure-vault-manager
      authentication:
        path: test-book
        role: crdb-insecure
        serviceAccount:
          name: crdb-insecure
      connection:
        address: http://vault.vault.svc:8200
        tLSConfig:
          skipVerify: false
  output:
    name: crdb-insecure-vault-manager
    labels:
      app.kubernetes.io/name: insecure-consumer
      app.kubernetes.io/instance: test
      app.kubernetes.io/part-of: test-book
      app.kubernetes.io/managed-by: Helm
      spelbook: test-book
      chapter: development
      spell: insecure-consumer
    annotations:
      runik.ing/cockroachdb-cluster: crdb-insecure
    stringData:
        username: vault_mgr
        bootstrap.sql: "CREATE ROLE IF NOT EXISTS \"vault_mgr\" WITH LOGIN CREATEDB CREATEROLE CREATELOGIN;\nALTER ROLE \"vault_mgr\" WITH LOGIN CREATEDB CREATEROLE CREATELOGIN;\nCREATE SCHEDULE IF NOT EXISTS crdb_insecure_s3_backup\nFOR BACKUP INTO 's3://example-backups?AUTH=implicit&AWS_ENDPOINT=http://s3.s3.svc:7070&AWS_REGION=us-east-1&AWS_USE_PATH_STYLE=true'\nWITH revision_history\nRECURRING '@daily'\nFULL BACKUP '@weekly'\nWITH SCHEDULE OPTIONS first_run = 'now', on_execution_failure = 'retry', on_previous_running = 'wait', updates_cluster_last_backup_time_metric;"
        password: '{{ .secret.password }}'
    type: kubernetes.io/basic-auth
---
