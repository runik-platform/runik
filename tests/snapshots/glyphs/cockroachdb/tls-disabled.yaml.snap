# Source: kaster/templates/kaster.yaml
apiVersion: redhatcop.redhat.io/v1alpha1
kind: DatabaseSecretEngineRole
metadata:
  name: insecure-consumer
  namespace: vault
  labels:
    app.kubernetes.io/name: insecure-consumer
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: test-book
    app.kubernetes.io/managed-by: Helm
    spelbook: test-book
    chapter: development
    spell: insecure-consumer
spec:
  authentication:
    path: test-book
    role: vault
    serviceAccount:
      name: vault
  connection:
    address: http://vault.vault.svc:8200
    tLSConfig:
      skipVerify: false
  path: db/test-book/development/insecure-consumer
  dBName: insecure-consumer-crdb-insecure
  creationStatements:
    - CREATE DATABASE IF NOT EXISTS "insecure-consumer";
    - CREATE ROLE "{{name}}" WITH LOGIN VALID UNTIL '{{expiration}}';
    - GRANT ALL ON DATABASE "insecure-consumer" TO "{{name}}";
  revocationStatements:
    - REVOKE ALL ON DATABASE "insecure-consumer" FROM "{{name}}";
    - DROP ROLE IF EXISTS "{{name}}";
  renewStatements:
    - ALTER ROLE "{{name}}" VALID UNTIL '{{expiration}}';
  defaultTTL: 1h
  maxTTL: 24h
