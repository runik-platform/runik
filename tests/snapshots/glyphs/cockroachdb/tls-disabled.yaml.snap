# Source: kaster/templates/kaster.yaml
apiVersion: redhatcop.redhat.io/v1alpha1
kind: DatabaseSecretEngineConfig
metadata:
  name: crdb-insecure
  namespace: vault
  labels:
    app.kubernetes.io/name: insecure-consumer
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: test-book
    app.kubernetes.io/managed-by: Helm
    spelbook: test-book
    chapter: development
    spell: insecure-consumer
spec:
  authentication:
    path: test-book
    role: vault
    serviceAccount:
      name: vault
  connection:
    address: http://vault.vault.svc:8200
    tLSConfig:
      skipVerify: false
  pluginName: postgresql-database-plugin
  allowedRoles:
    - '*'
  connectionURL: postgresql://{{username}}:{{password}}@crdb-insecure-public.cockroachdb.svc:26257/defaultdb?sslmode=disable
  passwordAuthentication: "password"
  verifyConnection: true
  rootCredentials:
    secret:
      name: crdb-insecure-vault-manager-root
    passwordKey: password
    usernameKey: username
  path: database
  rootPasswordRotation:
    rotationPeriod: "0s"
