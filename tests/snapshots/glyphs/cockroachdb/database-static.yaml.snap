kind: SecretEngineMount
metadata:
  name: hildy-static
  namespace: glyphs-release
  labels:
    app.kubernetes.io/name: hildy-static
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: test-book
    app.kubernetes.io/managed-by: Helm
    spelbook: test-book
    chapter: living-the-life
    spell: hildy-static
  annotations:
    argocd.argoproj.io/sync-wave: "-3"
    runik.ing/example: database-static
spec:
  authentication:
    path: test-book
    role: hildy-static
    serviceAccount:
      name: hildy-static
  connection:
    address: http://vault.vault.svc:8200
    tLSConfig:
      skipVerify: false
  type: database
  path: db/test-book/living-the-life
  description: "Runik database credentials for test-book/living-the-life/hildy-static"
  config:
    listingVisibility: hidden
