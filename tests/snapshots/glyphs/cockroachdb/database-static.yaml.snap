# Source: kaster/templates/kaster.yaml
apiVersion: redhatcop.redhat.io/v1alpha1
kind: VaultSecret
metadata:
  name: hildy-static
  labels:
    app.kubernetes.io/name: hildy-static
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: test-book
    app.kubernetes.io/managed-by: Helm
    spelbook: test-book
    chapter: living-the-life
    spell: hildy-static
  annotations:
    runik.ing/cockroachdb-cluster: crdb-main
    runik.ing/credentials: static
    runik.ing/example: database-static
spec:
  refreshThreshold: 80
  vaultSecretDefinitions:
    - name: secret
      requestType: GET
      path: db/test-book/living-the-life/hildy-static/static-creds/hildy-static
      authentication:
        path: test-book
        role: hildy-static
        serviceAccount:
          name: hildy-static
      connection:
        address: http://vault.vault.svc:8200
        tLSConfig:
          skipVerify: false
  output:
    name: hildy-static
    labels:
      app.kubernetes.io/name: hildy-static
      app.kubernetes.io/instance: test
      app.kubernetes.io/part-of: test-book
      app.kubernetes.io/managed-by: Helm
      spelbook: test-book
      chapter: living-the-life
      spell: hildy-static
    annotations:
      runik.ing/cockroachdb-cluster: crdb-main
      runik.ing/credentials: static
      runik.ing/example: database-static
    stringData: #tiene q haber una forma de hacer q esto funcione con un range del lado del operator para q no hagan falta las keys
        USERNAME: '{{ .secret.username }}'
        PASSWORD: '{{ .secret.password }}'
        DATABASE: hildy-static
        DBNAME: hildy-static
        HOST: crdb-main-public.cockroachdb.svc
        PORT: "26257"
        SSLMODE: require
    type: Opaque
