# Source: kaster/templates/kaster.yaml
apiVersion: redhatcop.redhat.io/v1alpha1
kind: DatabaseSecretEngineConfig
metadata:
  name: hildy-static-crdb-main
  namespace: vault
  labels:
    app.kubernetes.io/name: hildy-static
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: test-book
    app.kubernetes.io/managed-by: Helm
    spelbook: test-book
    chapter: living-the-life
    spell: hildy-static
  annotations:
    argocd.argoproj.io/sync-wave: "-2"
    runik.ing/example: database-static
spec:
  authentication:
    path: test-book
    role: vault
    serviceAccount:
      name: vault
  connection:
    address: http://vault.vault.svc:8200
    tLSConfig:
      skipVerify: false
  pluginName: postgresql-database-plugin
  allowedRoles:
    - hildy-static
  connectionURL: postgresql://{{username}}:{{password}}@crdb-main-public.cockroachdb.svc:26257/defaultdb?sslmode=require
  passwordAuthentication: "password"
  rootCredentials:
    secret:
      name: crdb-main-vault-manager-root
    passwordKey: password
    usernameKey: username
  path: db/test-book/living-the-life/hildy-static
  rootPasswordRotation:
    rotationPeriod: "0s"
---
# Source: kaster/templates/kaster.yaml
apiVersion: redhatcop.redhat.io/v1alpha1
kind: DatabaseSecretEngineStaticRole
metadata:
  name: hildy-static
  namespace: vault
  labels:
    app.kubernetes.io/name: hildy-static
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: test-book
    app.kubernetes.io/managed-by: Helm
    spelbook: test-book
    chapter: living-the-life
    spell: hildy-static
  annotations:
    runik.ing/example: database-static
spec:
  authentication:
    path: test-book
    role: vault
    serviceAccount:
      name: vault
  connection:
    address: http://vault.vault.svc:8200
    tLSConfig:
      skipVerify: false
  path: db/test-book/living-the-life/hildy-static
  dBName: hildy-static-crdb-main
  username: "hildy"
  rotationPeriod: 86400
  rotationStatements:
    - CREATE DATABASE IF NOT EXISTS "hildy-static";
    - CREATE ROLE IF NOT EXISTS "{{name}}" WITH LOGIN;
    - ALTER ROLE "{{name}}" WITH LOGIN PASSWORD '{{password}}';
    - GRANT ALL ON DATABASE "hildy-static" TO "{{name}}";
  credentialType: password
  passwordCredentialConfig:
    passwordPolicy: short-policy
