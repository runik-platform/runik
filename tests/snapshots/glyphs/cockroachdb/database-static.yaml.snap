# Source: kaster/templates/kaster.yaml
apiVersion: redhatcop.redhat.io/v1alpha1
kind: Policy
metadata:
  name: hildy-static
  namespace: vault
  labels:
    app.kubernetes.io/name: hildy-static
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: test-book
    app.kubernetes.io/managed-by: Helm
    spelbook: test-book
    chapter: living-the-life
    spell: hildy-static
  annotations:
    argocd.argoproj.io/sync-wave: "-5"
    runik.ing/example: database-static
spec:
  authentication:
    path: test-book
    role: vault
    serviceAccount:
      name: vault
  connection:
    address: http://vault.vault.svc:8200
    tLSConfig:
      skipVerify: false
  policy: |
    path "secret/data/test-book/living-the-life/glyphs-release/*" {
      capabilities = ["create","read","update","delete","list"]
    }
    path "secret/metadata/test-book/living-the-life/glyphs-release/*" {
      capabilities = ["create","read","update","delete","list"]
    }
    path "secret/data/test-book/living-the-life/publics/*" {
      capabilities = ["read","list"]
    }
    path "secret/metadata/test-book/living-the-life/publics/*" {
      capabilities = ["read","list"]
    }
    path "secret/data/test-book/publics/*" {
      capabilities = ["read","list"]
    }
    path "secret/metadata/test-book/publics/*" {
      capabilities = ["read","list"]
    }
    path "secret/data/test-book/pipelines/*" {
      capabilities = ["read","list"]
    }
    path "secret/metadata/test-book/pipelines/*" {
      capabilities = ["read","list"]
    }
    path "sys/policies/password/*" {
      capabilities = ["read","list"]
    }
    path "db/test-book/living-the-life/hildy-static/creds/*" {
      capabilities = ["read"]
    }
    path "db/test-book/living-the-life/hildy-static/static-creds/*" {
      capabilities = ["read"]
    }
    path "sys/mounts" {
      capabilities = ["read"]
    }
    path "sys/mounts/db/test-book/living-the-life/hildy-static" {
      capabilities = ["create","read","update","delete"]
    }
---
