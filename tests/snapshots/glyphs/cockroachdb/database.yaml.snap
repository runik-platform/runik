apiVersion: redhatcop.redhat.io/v1alpha1
kind: SecretEngineMount
metadata:
  name: hildy
  namespace: glyphs-release
  labels:
    app.kubernetes.io/name: hildy
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: test-book
    app.kubernetes.io/managed-by: Helm
    spelbook: test-book
    chapter: living-the-life
    spell: hildy
  annotations:
    argocd.argoproj.io/sync-wave: "-3"
spec:
  authentication:
    path: test-book
    role: hildy
    serviceAccount:
      name: hildy
  connection:
    address: http://vault.vault.svc:8200
    tLSConfig:
      skipVerify: false
  type: database
  path: db/test-book/living-the-life
  description: "Runik database credentials for test-book/living-the-life/hildy"
  config:
    listingVisibility: hidden
---
# Source: kaster/templates/kaster.yaml
apiVersion: redhatcop.redhat.io/v1alpha1
kind: VaultSecret
metadata:
  name: hildy
  labels:
    app.kubernetes.io/name: hildy
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: test-book
    app.kubernetes.io/managed-by: Helm
    spelbook: test-book
    chapter: living-the-life
    spell: hildy
  annotations:
    runik.ing/cockroachdb-cluster: crdb-main
spec:
  refreshThreshold: 80
  vaultSecretDefinitions:
    - name: secret
      requestType: GET
      path: db/test-book/living-the-life/hildy/creds/hildy
      authentication:
        path: test-book
        role: hildy
        serviceAccount:
          name: hildy
      connection:
        address: http://vault.vault.svc:8200
        tLSConfig:
          skipVerify: false
  output:
    name: hildy
    labels:
      app.kubernetes.io/name: hildy
      app.kubernetes.io/instance: test
      app.kubernetes.io/part-of: test-book
      app.kubernetes.io/managed-by: Helm
      spelbook: test-book
      chapter: living-the-life
      spell: hildy
    annotations:
      runik.ing/cockroachdb-cluster: crdb-main
    stringData: #tiene q haber una forma de hacer q esto funcione con un range del lado del operator para q no hagan falta las keys
        USERNAME: '{{ .secret.username }}'
        PASSWORD: '{{ .secret.password }}'
        DATABASE: hildy
        DBNAME: hildy
        HOST: crdb-main-public.cockroachdb.svc
        PORT: "26257"
        SSLMODE: require
    type: Opaque
