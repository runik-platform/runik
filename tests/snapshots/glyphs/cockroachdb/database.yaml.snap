# Source: kaster/templates/kaster.yaml
apiVersion: redhatcop.redhat.io/v1alpha1
kind: DatabaseSecretEngineConfig
metadata:
  name: hildy-crdb-main
  namespace: vault
  labels:
    app.kubernetes.io/name: hildy
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: test-book
    app.kubernetes.io/managed-by: Helm
    spelbook: test-book
    chapter: living-the-life
    spell: hildy
  annotations:
    argocd.argoproj.io/sync-wave: "-2"
spec:
  authentication:
    path: test-book
    role: vault
    serviceAccount:
      name: vault
  connection:
    address: http://vault.vault.svc:8200
    tLSConfig:
      skipVerify: false
  pluginName: postgresql-database-plugin
  allowedRoles:
    - hildy
  connectionURL: postgresql://{{username}}:{{password}}@crdb-main-public.cockroachdb.svc:26257/defaultdb?sslmode=require
  passwordAuthentication: "password"
  rootCredentials:
    secret:
      name: crdb-main-vault-manager-root
    passwordKey: password
    usernameKey: username
  path: db/test-book/living-the-life/hildy
  rootPasswordRotation:
    rotationPeriod: "0s"
---
# Source: kaster/templates/kaster.yaml
apiVersion: redhatcop.redhat.io/v1alpha1
kind: DatabaseSecretEngineRole
metadata:
  name: hildy
  namespace: vault
  labels:
    app.kubernetes.io/name: hildy
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: test-book
    app.kubernetes.io/managed-by: Helm
    spelbook: test-book
    chapter: living-the-life
    spell: hildy
spec:
  authentication:
    path: test-book
    role: vault
    serviceAccount:
      name: vault
  connection:
    address: http://vault.vault.svc:8200
    tLSConfig:
      skipVerify: false
  path: db/test-book/living-the-life/hildy
  dBName: hildy-crdb-main
  creationStatements:
    - CREATE DATABASE IF NOT EXISTS "hildy";
    - CREATE ROLE "{{name}}" WITH LOGIN PASSWORD '{{password}}' VALID UNTIL '{{expiration}}';
    - GRANT ALL ON DATABASE "hildy" TO "{{name}}";
  revocationStatements:
    - REVOKE ALL ON DATABASE "hildy" FROM "{{name}}";
    - DROP ROLE IF EXISTS "{{name}}";
  renewStatements:
    - ALTER ROLE "{{name}}" VALID UNTIL '{{expiration}}';
  defaultTTL: 1h
  maxTTL: 24h
