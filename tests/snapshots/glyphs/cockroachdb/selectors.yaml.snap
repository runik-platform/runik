# Source: kaster/templates/kaster.yaml
apiVersion: redhatcop.redhat.io/v1alpha1
kind: DatabaseSecretEngineConfig
metadata:
  name: analytics-consumers-crdb-analytics
  namespace: vault
  labels:
    app.kubernetes.io/name: analytics-consumers
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: test-book
    app.kubernetes.io/managed-by: Helm
    spelbook: test-book
    chapter: reporting
    spell: analytics-consumers
  annotations:
    argocd.argoproj.io/sync-wave: "-2"
spec:
  authentication:
    path: test-book
    role: vault
    serviceAccount:
      name: vault
  connection:
    address: http://vault.vault.svc:8200
    tLSConfig:
      skipVerify: false
  pluginName: postgresql-database-plugin
  allowedRoles:
    - analytics-consumers
  connectionURL: postgresql://{{username}}:{{password}}@crdb-analytics-public.cockroachdb-analytics.svc:26257/defaultdb?sslmode=require
  passwordAuthentication: "password"
  rootCredentials:
    secret:
      name: crdb-analytics-vault-manager-root
    passwordKey: password
    usernameKey: username
  path: db/test-book/reporting/analytics-consumers
  rootPasswordRotation:
    rotationPeriod: "0s"
---
# Source: kaster/templates/kaster.yaml
apiVersion: redhatcop.redhat.io/v1alpha1
kind: DatabaseSecretEngineRole
metadata:
  name: analytics-consumers
  namespace: vault
  labels:
    app.kubernetes.io/name: analytics-consumers
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: test-book
    app.kubernetes.io/managed-by: Helm
    spelbook: test-book
    chapter: reporting
    spell: analytics-consumers
spec:
  authentication:
    path: test-book
    role: vault
    serviceAccount:
      name: vault
  connection:
    address: http://vault.vault.svc:8200
    tLSConfig:
      skipVerify: false
  path: db/test-book/reporting/analytics-consumers
  dBName: analytics-consumers-crdb-analytics
  creationStatements:
    - CREATE DATABASE IF NOT EXISTS "analytics-consumers";
    - CREATE ROLE "{{name}}" WITH LOGIN PASSWORD '{{password}}' VALID UNTIL '{{expiration}}';
    - GRANT ALL ON DATABASE "analytics-consumers" TO "{{name}}";
  revocationStatements:
    - REVOKE ALL ON DATABASE "analytics-consumers" FROM "{{name}}";
    - DROP ROLE IF EXISTS "{{name}}";
  renewStatements:
    - ALTER ROLE "{{name}}" VALID UNTIL '{{expiration}}';
  defaultTTL: 1h
  maxTTL: 24h
