# Source: kaster/templates/kaster.yaml
apiVersion: redhatcop.redhat.io/v1alpha1
kind: VaultSecret
metadata:
  name: analytics-consumers
  labels:
    app.kubernetes.io/name: analytics-consumers
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: test-book
    app.kubernetes.io/managed-by: Helm
    spelbook: test-book
    chapter: reporting
    spell: analytics-consumers
  annotations:
    runik.ing/cockroachdb-cluster: crdb-analytics
spec:
  refreshThreshold: 80
  vaultSecretDefinitions:
    - name: secret
      requestType: GET
      path: db/test-book/reporting/analytics-consumers/creds/analytics-consumers
      authentication:
        path: test-book
        role: analytics-consumers
        serviceAccount:
          name: analytics-consumers
      connection:
        address: http://vault.vault.svc:8200
        tLSConfig:
          skipVerify: false
  output:
    name: analytics-consumers
    labels:
      app.kubernetes.io/name: analytics-consumers
      app.kubernetes.io/instance: test
      app.kubernetes.io/part-of: test-book
      app.kubernetes.io/managed-by: Helm
      spelbook: test-book
      chapter: reporting
      spell: analytics-consumers
    annotations:
      runik.ing/cockroachdb-cluster: crdb-analytics
    stringData: #tiene q haber una forma de hacer q esto funcione con un range del lado del operator para q no hagan falta las keys
        USERNAME: '{{ .secret.username }}'
        PASSWORD: '{{ .secret.password }}'
        DATABASE: analytics-consumers
        DBNAME: analytics-consumers
        HOST: crdb-analytics-public.cockroachdb-analytics.svc
        PORT: "26257"
        SSLMODE: require
    type: Opaque
