apiVersion: redhatcop.redhat.io/v1alpha1
kind: SecretEngineMount
metadata:
  name: analytics-consumers
  namespace: glyphs-release
  labels:
    app.kubernetes.io/name: analytics-consumers
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: test-book
    app.kubernetes.io/managed-by: Helm
    spelbook: test-book
    chapter: reporting
    spell: analytics-consumers
  annotations:
    argocd.argoproj.io/sync-wave: "-3"
spec:
  authentication:
    path: test-book
    role: analytics-consumers
    serviceAccount:
      name: analytics-consumers
  connection:
    address: http://vault.vault.svc:8200
    tLSConfig:
      skipVerify: false
  type: database
  path: db/test-book/reporting
  description: "Runik database credentials for test-book/reporting/analytics-consumers"
  config:
    listingVisibility: hidden
