# Source: kaster/templates/kaster.yaml
apiVersion: redhatcop.redhat.io/v1alpha1
kind: RandomSecret
metadata:
  name: s3-identities-seaweedfs-my-data-aws-access-key-id
  namespace: glyphs-release
  labels:
    app.kubernetes.io/name: my-app
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: the-yaml-life
    app.kubernetes.io/managed-by: Helm
    spelbook: the-yaml-life
    chapter: staging
    spell: my-app
    runik.ing/identity-name: the-yaml-life-staging-my-data
    runik.ing/s3-identity: "true"
    runik.ing/s3-provider: seaweedfs
spec:
  authentication:
    path: the-yaml-life
    role: my-app
    serviceAccount:
      name: my-app
  connection:
    address: http://vault.vault.svc:8200
    tLSConfig:
      skipVerify: false
  isKVSecretsEngineV2: true
  path: kv/data/the-yaml-life/staging/glyphs-release/publics/
  secretKey: AWS_ACCESS_KEY_ID
  secretFormat:
    passwordPolicyName: short-policy
