# Source: kaster/templates/kaster.yaml
apiVersion: redhatcop.redhat.io/v1alpha1
kind: VaultSecret
metadata:
  name: s3-identities-seaweedfs-my-data
  namespace: seaweedfs
  labels:
    app.kubernetes.io/name: my-app
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: the-yaml-life
    app.kubernetes.io/managed-by: Helm
    spelbook: the-yaml-life
    chapter: staging
    spell: my-app
    runik.ing/identity-name: the-yaml-life-staging-my-data
    runik.ing/s3-identity: "true"
    runik.ing/s3-provider: seaweedfs
    runik.ing/source-namespace: glyphs-release
spec:
  refreshThreshold: 90
  refreshPeriod: 3m0s
  vaultSecretDefinitions:
    - name: aws-access-key-id
      requestType: GET
      path: kv/data/the-yaml-life/staging/glyphs-release/publics/s3-identities-seaweedfs-my-data-aws-access-key-id
      authentication:
        path: the-yaml-life
        role: seaweedfs-s3-aggregator-pod
        serviceAccount:
          name: seaweedfs-s3-aggregator-pod
      connection:
        address: http://vault.vault.svc:8200
        tLSConfig:
          skipVerify: false
    - name: aws-secret-access-key
      requestType: GET
      path: kv/data/the-yaml-life/staging/glyphs-release/publics/s3-identities-seaweedfs-my-data-aws-secret-access-key
      authentication:
        path: the-yaml-life
        role: seaweedfs-s3-aggregator-pod
        serviceAccount:
          name: seaweedfs-s3-aggregator-pod
      connection:
        address: http://vault.vault.svc:8200
        tLSConfig:
          skipVerify: false
  output:
    name: the-yaml-life-staging-my-data
    labels:
      app.kubernetes.io/name: my-app
      app.kubernetes.io/instance: test
      app.kubernetes.io/part-of: the-yaml-life
      app.kubernetes.io/managed-by: Helm
      spelbook: the-yaml-life
      chapter: staging
      spell: my-app
      runik.ing/identity-name: the-yaml-life-staging-my-data
      runik.ing/s3-identity: "true"
      runik.ing/s3-provider: seaweedfs
      runik.ing/source-namespace: glyphs-release
    stringData:
        BUCKETS: the-yaml-life-staging-my-data
        IDENTITY_NAME: the-yaml-life-staging-my-data
        PERMISSIONS: Admin
        AWS_ACCESS_KEY_ID: '{{ index . "aws-access-key-id" "AWS_ACCESS_KEY_ID" }}'
        AWS_SECRET_ACCESS_KEY: '{{ index . "aws-secret-access-key" "AWS_SECRET_ACCESS_KEY" }}'
    type: Opaque
