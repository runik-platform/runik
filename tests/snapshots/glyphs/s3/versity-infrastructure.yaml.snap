# Source: kaster/templates/kaster.yaml
apiVersion: argoproj.io/v1alpha1
kind: EventSource
metadata:
  name: gateway-s3-secrets
  namespace: argo-events
  labels:
    app.kubernetes.io/name: s3
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: the-yaml-life
    app.kubernetes.io/managed-by: Helm
spec:
  eventBusName: default-eventbus
  template:
    serviceAccountName: gateway-s3-aggregator
  resource:
    s3-identity-changes:
      namespace: glyphs-release
      version: v1
      resource: secrets
      eventTypes:
        - ADD
        - UPDATE
        - DELETE
      filter:
        labels:
          - key: runik.ing/s3-identity
            operation: =
            value: "true"
        afterStart: true
---
# Source: kaster/templates/kaster.yaml
apiVersion: redhatcop.redhat.io/v1alpha1
kind: KubernetesAuthEngineRole
metadata:
  name: gateway-s3-identities
  namespace: vault
  labels:
    app.kubernetes.io/name: s3
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: the-yaml-life
    app.kubernetes.io/managed-by: Helm
    spelbook: the-yaml-life
    chapter: intro
    spell: s3
spec:
  authentication:
    path: the-yaml-life
    role: vault
    serviceAccount:
      name: vault
  connection:
    address: http://vault.vault.svc:8200
    tLSConfig:
      skipVerify: true
  path: the-yaml-life
  policies:
    - gateway-s3-identities
  targetServiceAccounts:
    - gateway-s3-aggregator-pod
  targetNamespaces:
    targetNamespaces:
      - glyphs-release
