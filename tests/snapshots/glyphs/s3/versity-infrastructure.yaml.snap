# Source: kaster/templates/kaster.yaml
apiVersion: redhatcop.redhat.io/v1alpha1
kind: Policy
metadata:
  name: gateway-s3-identities
  namespace: vault
  labels:
    app.kubernetes.io/name: s3
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: the-yaml-life
    app.kubernetes.io/managed-by: Helm
    spelbook: the-yaml-life
    chapter: intro
    spell: s3
spec:
  authentication:
    path: the-yaml-life
    role: vault
    serviceAccount:
      name: vault
  connection:
    address: http://vault.vault.svc:8200
    tLSConfig:
      skipVerify: true
  policy: |
    path "secret/data/the-yaml-life/intro/gateway-s3-identities/*" {
      capabilities = ["create","read","update","delete","list"]
    }
    path "secret/metadata/the-yaml-life/intro/gateway-s3-identities/*" {
      capabilities = ["create","read","update","delete","list"]
    }
    path "secret/data/the-yaml-life/intro/publics/*" {
      capabilities = ["read","list"]
    }
    path "secret/metadata/the-yaml-life/intro/publics/*" {
      capabilities = ["read","list"]
    }
    path "secret/data/the-yaml-life/publics/*" {
      capabilities = ["read","list"]
    }
    path "secret/metadata/the-yaml-life/publics/*" {
      capabilities = ["read","list"]
    }
    path "secret/data/the-yaml-life/pipelines/*" {
      capabilities = ["read","list"]
    }
    path "secret/metadata/the-yaml-life/pipelines/*" {
      capabilities = ["read","list"]
    }
    path "sys/policies/password/*" {
      capabilities = ["read","list"]
    }
    path "secret/data/the-yaml-life/+/publics/s3-identities-gateway-*" {
      capabilities = ["read","list"]
    }
    path "secret/metadata/the-yaml-life/+/publics/s3-identities-gateway-*" {
      capabilities = ["read","list"]
    }
    path "secret/data/the-yaml-life/+/+/publics/s3-identities-gateway-*" {
      capabilities = ["read","list"]
    }
    path "secret/metadata/the-yaml-life/+/+/publics/s3-identities-gateway-*" {
      capabilities = ["read","list"]
    }
    path "secret/data/the-yaml-life/+/+/+/publics/s3-identities-gateway-*" {
      capabilities = ["read","list"]
    }
    path "secret/metadata/the-yaml-life/+/+/+/publics/s3-identities-gateway-*" {
      capabilities = ["read","list"]
    }
---
# Source: kaster/templates/kaster.yaml
apiVersion: argoproj.io/v1alpha1
kind: Sensor
metadata:
  name: gateway-s3-aggregator
  namespace: argo-events
  labels:
    app.kubernetes.io/name: s3
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: the-yaml-life
    app.kubernetes.io/managed-by: Helm
    provider: gateway
    purpose: s3-identity-reconciliation
spec:
  eventBusName: default-eventbus
  template:
    serviceAccountName: gateway-s3-aggregator
  dependencies:
    
    - name: s3-secret-event
      eventSourceName: gateway-s3-secrets
      eventName: s3-identity-changes
  triggers:
    - template:
        name: run-aggregator
        conditions: s3-secret-event
        argoWorkflow:
          operation: submit
          source:
            resource:
              apiVersion: argoproj.io/v1alpha1
              kind: Workflow
              metadata:
                generateName: gateway-s3-aggregator-
                namespace: glyphs-release
              spec:
                workflowTemplateRef:
                  name: gateway-s3-reconcile
          
      rateLimit:
        unit: Minute
        requestsPerUnit: 1
---
# Source: kaster/templates/kaster.yaml
apiVersion: argoproj.io/v1alpha1
kind: WorkflowTemplate
metadata:
  name: gateway-s3-reconcile
  namespace: glyphs-release
  labels:
    app.kubernetes.io/name: s3
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: the-yaml-life
    app.kubernetes.io/managed-by: Helm
    spelbook: the-yaml-life
    chapter: intro
    spell: s3
    runik.ing/s3-backend: versity
    runik.ing/s3-provider: gateway
spec:
  entrypoint: reconcile
  podGC:
    deleteDelayDuration: 30m
    strategy: OnWorkflowCompletion
  templates:
  - containerSet:
      containers:
      - command:
        - sh
        - /scripts/aggregator.sh
        env:
        - name: NAMESPACE
          value: glyphs-release
        - name: ADMIN_ENDPOINT
          value: http://s3.glyphs-release.svc:7071
        - name: BUCKETS_ROOT
          value: /storage/cargo-hold/buckets
        envFrom:
        - secretRef:
            name: s3-root
        image: ghcr.io/versity/versitygw:v1.7.0
        name: aggregator
        resources:
          limits:
            cpu: 300m
            memory: 256Mi
          requests:
            cpu: 50m
            memory: 64Mi
        securityContext:
          runAsGroup: 1069
          runAsUser: 1042
        volumeMounts:
        - mountPath: /scripts
          name: script
        - mountPath: /storage/cargo-hold
          name: buckets
        - mountPath: /shared
          name: shared
      - command:
        - sh
        - /scripts/acl.sh
        dependencies:
        - aggregator
        env:
        - name: S3_ENDPOINT
          value: http://s3.glyphs-release.svc:7070
        - name: AWS_EC2_METADATA_DISABLED
          value: "true"
        - name: AWS_REQUEST_CHECKSUM_CALCULATION
          value: when_required
        - name: AWS_RESPONSE_CHECKSUM_VALIDATION
          value: when_required
        envFrom:
        - secretRef:
            name: s3-root
        image: public.ecr.aws/aws-cli/aws-cli:2.27.41
        name: acl
        volumeMounts:
        - mountPath: /scripts
          name: script
        - mountPath: /shared
          name: shared
    name: reconcile
    serviceAccountName: gateway-s3-aggregator-pod
    tolerations:
    - effect: NoSchedule
      key: role
      operator: Equal
      value: system
    volumes:
    - configMap:
        name: gateway-s3-aggregator-script
      name: script
    - hostPath:
        path: /var/mnt/cargo-hold
      name: buckets
    - emptyDir: {}
      name: shared
  ttlStrategy:
    secondsAfterFailure: 604800
    secondsAfterSuccess: 86400
