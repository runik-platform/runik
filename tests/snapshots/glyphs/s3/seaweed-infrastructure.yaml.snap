# Source: kaster/templates/kaster.yaml
apiVersion: redhatcop.redhat.io/v1alpha1
kind: Policy
metadata:
  name: seaweedfs-s3-identities
  namespace: vault
  labels:
    app.kubernetes.io/name: seaweedfs-s3-infrastructure
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: the-yaml-life
    app.kubernetes.io/managed-by: Helm
    spelbook: the-yaml-life
    chapter: intro
    spell: seaweedfs-s3-infrastructure
spec:
  authentication:
    path: the-yaml-life
    role: vault
    serviceAccount:
      name: vault
  connection:
    address: http://vault.vault.svc:8200
    tLSConfig:
      skipVerify: true
  policy: |
    path "kv/data/the-yaml-life/intro/seaweedfs-s3-identities/*" {
      capabilities = ["create","read","update","delete","list"]
    }
    path "kv/metadata/the-yaml-life/intro/seaweedfs-s3-identities/*" {
      capabilities = ["create","read","update","delete","list"]
    }
    path "kv/data/the-yaml-life/intro/publics/*" {
      capabilities = ["read","list"]
    }
    path "kv/metadata/the-yaml-life/intro/publics/*" {
      capabilities = ["read","list"]
    }
    path "kv/data/the-yaml-life/publics/*" {
      capabilities = ["read","list"]
    }
    path "kv/metadata/the-yaml-life/publics/*" {
      capabilities = ["read","list"]
    }
    path "kv/data/the-yaml-life/pipelines/*" {
      capabilities = ["read","list"]
    }
    path "kv/metadata/the-yaml-life/pipelines/*" {
      capabilities = ["read","list"]
    }
    path "sys/policies/password/*" {
      capabilities = ["read","list"]
    }
    path "kv/data/the-yaml-life/+/publics/s3-identities-seaweedfs-*" {
      capabilities = ["read","list"]
    }
    path "kv/metadata/the-yaml-life/+/publics/s3-identities-seaweedfs-*" {
      capabilities = ["read","list"]
    }
    path "kv/data/the-yaml-life/+/+/publics/s3-identities-seaweedfs-*" {
      capabilities = ["read","list"]
    }
    path "kv/metadata/the-yaml-life/+/+/publics/s3-identities-seaweedfs-*" {
      capabilities = ["read","list"]
    }
    path "kv/data/the-yaml-life/+/+/+/publics/s3-identities-seaweedfs-*" {
      capabilities = ["read","list"]
    }
    path "kv/metadata/the-yaml-life/+/+/+/publics/s3-identities-seaweedfs-*" {
      capabilities = ["read","list"]
    }
---
# Source: kaster/templates/kaster.yaml
apiVersion: argoproj.io/v1alpha1
kind: Sensor
metadata:
  name: seaweedfs-s3-aggregator
  labels:
    app.kubernetes.io/name: seaweedfs-s3-infrastructure
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: the-yaml-life
    app.kubernetes.io/managed-by: Helm
spec:
  eventBusName: default-eventbus
  template:
    serviceAccountName: seaweedfs-s3-aggregator
  dependencies:
    
    - name: s3-secret-event
      eventSourceName: seaweedfs-s3-secrets
      eventName: s3-identity-changes
  triggers:
    - template:
        name: run-aggregator
        k8s:
          version: v1
          resource: pods
          operation: create
          source:
            resource:
              apiVersion: v1
              kind: Pod
              metadata:
                generateName: seaweedfs-s3-aggregator-
                namespace: glyphs-release
              spec:
                containers:
                - command:
                  - /bin/sh
                  - -c
                  - source /scripts/aggregator.sh
                  env:
                  - name: NAMESPACE
                    value: glyphs-release
                  image: alpine/kubectl:latest
                  name: aggregator
                  resources:
                    limits:
                      cpu: 200m
                      memory: 128Mi
                    requests:
                      cpu: 50m
                      memory: 64Mi
                  volumeMounts:
                  - mountPath: /scripts
                    name: script
                restartPolicy: Never
                serviceAccountName: seaweedfs-s3-aggregator-pod
                volumes:
                - configMap:
                    name: seaweedfs-s3-aggregator-script
                  name: script
      rateLimit:
        unit: Minute
        requestsPerUnit: 1
