kind: SecretEngineMount
metadata:
  name: database-test-book-base-system
  labels:
    app.kubernetes.io/name: postgresql-engine-test
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: test-book
    app.kubernetes.io/managed-by: Helm
    spelbook: test-book
    chapter: base-system
    spell: postgresql-engine-test
spec:
  authentication:
    path: the-yaml-life
    role: postgresql-engine-test
    serviceAccount:
      name: postgresql-engine-test
  connection:
    address: http://vault.vault.svc:8200
    tLSConfig:
      skipVerify: true
  type: database
  description: "Database secrets engine for PostgreSQL dynamic credentials"
  config:
    listingVisibility: hidden
