apiVersion: redhatcop.redhat.io/v1alpha1
kind: KubernetesAuthEngineRole
metadata:
  name: rooted-access
  namespace: vault
  labels:
    app.kubernetes.io/name: test
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: default
    app.kubernetes.io/managed-by: Helm
    spelbook: default
    chapter: default
    spell: kaster
spec:
  authentication:
    path: k8s-path-auth
    role: vault
    serviceAccount:
      name: vault
  connection:
    address: http://vault.vault.svc:8200
    tLSConfig:
      skipVerify: false
  path: default
  policies:
    - rooted-access
  targetServiceAccounts:
    - test
  targetNamespaces:
    targetNamespaces:
      - glyphs-release
---
# Source: kaster/templates/kaster.yaml
apiVersion: redhatcop.redhat.io/v1alpha1
kind: Policy
metadata:
  name: rooted-access
  namespace: vault
  labels:
    app.kubernetes.io/name: test
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: default
    app.kubernetes.io/managed-by: Helm
    spelbook: default
    chapter: default
    spell: kaster
spec:
  authentication:
    path: k8s-path-auth
    role: vault
    serviceAccount:
      name: vault
  connection:
    address: http://vault.vault.svc:8200
    tLSConfig:
      skipVerify: false
  policy: |
    path "kv/data/acme/prod/default/rooted-access/*" {
      capabilities = ["create","read","update","delete","list"]
    }
    path "kv/metadata/acme/prod/default/rooted-access/*" {
      capabilities = ["create","read","update","delete","list"]
    }
    path "kv/data/acme/prod/default/publics/*" {
      capabilities = ["read","list"]
    }
    path "kv/metadata/acme/prod/default/publics/*" {
      capabilities = ["read","list"]
    }
    path "kv/data/acme/prod/publics/*" {
      capabilities = ["read","list"]
    }
    path "kv/metadata/acme/prod/publics/*" {
      capabilities = ["read","list"]
    }
    path "kv/data/acme/prod/pipelines/*" {
      capabilities = ["read","list"]
    }
    path "kv/metadata/acme/prod/pipelines/*" {
      capabilities = ["read","list"]
    }
    path "sys/policies/password/*" {
      capabilities = ["read","list"]
    }
---
# Source: kaster/templates/kaster.yaml
apiVersion: redhatcop.redhat.io/v1alpha1
kind: Policy
metadata:
  name: developer
  namespace: vault
  labels:
    app.kubernetes.io/name: test
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: default
    app.kubernetes.io/managed-by: Helm
    spelbook: default
    chapter: default
    spell: kaster
spec:
  authentication:
    path: k8s-path-auth
    role: vault
    serviceAccount:
      name: vault
  connection:
    address: http://vault.vault.svc:8200
    tLSConfig:
      skipVerify: false
  policy: |
    path "kv/data/acme/prod/publics/*" {
      capabilities = [ "read", "list"]
    }
    path "secret/data/develop/**/publics/*" {
      capabilities = [ "read", "list"]
    }
