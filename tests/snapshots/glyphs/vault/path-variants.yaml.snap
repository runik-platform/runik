apiVersion: redhatcop.redhat.io/v1alpha1
kind: AuthEngineMount
metadata:
  name: oidc
  namespace: vault
  labels:
    app.kubernetes.io/name: test
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: default
    app.kubernetes.io/managed-by: Helm
    spelbook: default
    chapter: default
    spell: kaster
spec:
  authentication:
    path: k8s-path-auth
    role: vault
    serviceAccount:
      name: vault
  connection:
    address: http://vault.vault.svc:8200
    tLSConfig:
      skipVerify: false
  type: oidc
---
# Source: kaster/templates/kaster.yaml
apiVersion: redhatcop.redhat.io/v1alpha1
kind: JWTOIDCAuthEngineConfig
metadata:
  name: rooted-oidc
  namespace: vault
  labels:
    app.kubernetes.io/name: test
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: default
    app.kubernetes.io/managed-by: Helm
    spelbook: default
    chapter: default
    spell: kaster
spec:
  authentication:
    path: k8s-path-auth
    role: vault
    serviceAccount:
      name: vault
  connection:
    address: http://vault.vault.svc:8200
    tLSConfig:
      skipVerify: false
  OIDCCredentials:
    secret:
      name: oidc-client
    usernameKey: username
    passwordKey: password
  path: oidc
  OIDCDiscoveryURL: https://identity.example.test/realms/test
  defaultRole: developer
---
# Source: kaster/templates/kaster.yaml
apiVersion: redhatcop.redhat.io/v1alpha1
kind: JWTOIDCAuthEngineRole
metadata:
  name: rooted-oidc-admins
  namespace: vault
  labels:
    app.kubernetes.io/name: test
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: default
    app.kubernetes.io/managed-by: Helm
    spelbook: default
    chapter: default
    spell: kaster
spec:
  authentication:
    path: k8s-path-auth
    role: vault
    serviceAccount:
      name: vault
  connection:
    address: http://vault.vault.svc:8200
    tLSConfig:
      skipVerify: false
  name: admin
  path: oidc
  roleType: oidc
  userClaim: "preferred_username"
  groupsClaim: "groups"
  tokenPolicies:
    - "admin"
    - "vault"
  allowedRedirectURIs:
    - "vault.example.test/ui/vault/auth/oidc/oidc/callback"
  boundClaims:
    groups:
      - "vault-admins"
