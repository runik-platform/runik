# Source: kaster/templates/kaster.yaml
apiVersion: redhatcop.redhat.io/v1alpha1
kind: PasswordPolicy
metadata:
  name: no-ambiguous-chars
  namespace: vault
  labels:
    app.kubernetes.io/name: test
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: default
    app.kubernetes.io/managed-by: Helm
    spelbook: default
    chapter: default
    spell: kaster
spec:
  authentication:
    path: k8s-path-auth
    role: vault
    serviceAccount:
      name: vault
  connection:
    address: http://vault.vault.svc:8200
    tLSConfig:
      skipVerify: true
  passwordPolicy: |
    length = 20
    rule "charset" {
      # Lowercase without ambiguous chars (no l, o)
      charset = "abcdefghijkmnpqrstuvwxyz"
      min-chars = 5
    }
    rule "charset" {
      # Uppercase without ambiguous chars (no I, O)
      charset = "ABCDEFGHJKLMNPQRSTUVWXYZ"
      min-chars = 5
    }
    rule "charset" {
      # Numbers without ambiguous chars (no 0, 1)
      charset = "23456789"
      min-chars = 4
    }
    rule "charset" {
      # Safe special characters
      charset = "!@#$%^&*"
      min-chars = 2
    }
---
