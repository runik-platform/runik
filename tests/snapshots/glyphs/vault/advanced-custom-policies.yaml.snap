# Source: kaster/templates/kaster.yaml
apiVersion: redhatcop.redhat.io/v1alpha1
kind: PasswordPolicy
metadata:
  name: database-safe
  namespace: vault
  labels:
    app.kubernetes.io/name: test
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: default
    app.kubernetes.io/managed-by: Helm
    spelbook: default
    chapter: default
    spell: kaster
spec:
  authentication:
    path: k8s-path-auth
    role: vault
    serviceAccount:
      name: vault
  connection:
    address: http://vault.vault.svc:8200
    tLSConfig:
      skipVerify: true
  passwordPolicy: |
    length = 24
    rule "charset" {
      charset = "abcdefghijklmnopqrstuvwxyz"
      min-chars = 6
    }
    rule "charset" {
      charset = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
      min-chars = 6
    }
    rule "charset" {
      charset = "0123456789"
      min-chars = 6
    }
    rule "charset" {
      # Special chars safe for SQL (no quotes or semicolons)
      charset = "!@#$%^&*()_+-=[]{}|:<>?"
      min-chars = 6
    }
---
