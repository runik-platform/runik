  vaultSecretDefinitions:
    - name: secret
      requestType: GET
      path: kv/data/default/default/glyphs-release/publics/app-credentials-apikey
      authentication:
        path: k8s-path-auth
        role: test
        serviceAccount:
          name: test
      connection:
        address: http://vault.vault.svc:8200
        tLSConfig:
          skipVerify: true
  output:
    name: app-credentials-apikey
    labels:
      app.kubernetes.io/name: test
      app.kubernetes.io/instance: test
      app.kubernetes.io/part-of: default
      app.kubernetes.io/managed-by: Helm
      spelbook: default
      chapter: default
      spell: kaster
    stringData:
        api-scope: read-write
        component: main-app
        api-key: '{{ index .secret "api-key" }}'
    type: Opaque
