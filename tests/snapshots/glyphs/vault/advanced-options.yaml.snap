# Source: kaster/templates/kaster.yaml
apiVersion: redhatcop.redhat.io/v1alpha1
kind: VaultSecret
metadata:
  name: custom-sa-secret
  labels:
    app.kubernetes.io/name: test
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: default
    app.kubernetes.io/managed-by: Helm
    spelbook: default
    chapter: default
    spell: kaster
spec:
  refreshThreshold: 90
  refreshPeriod: 5m0s
  vaultSecretDefinitions:
    - name: secret
      requestType: GET
      path: kv/data/default/default/glyphs-release/publics/custom-sa-secret
      authentication:
        path: k8s-path-auth
        role: custom-vault-sa
        serviceAccount:
          name: custom-vault-sa
      connection:
        address: http://vault.vault.svc:8200
        tLSConfig:
          skipVerify: true
  output:
    name: custom-sa-secret
    labels:
      app.kubernetes.io/name: test
      app.kubernetes.io/instance: test
      app.kubernetes.io/part-of: default
      app.kubernetes.io/managed-by: Helm
      spelbook: default
      chapter: default
      spell: kaster
    stringData:
        token: '{{ .secret.token }}'
    type: Opaque
---
