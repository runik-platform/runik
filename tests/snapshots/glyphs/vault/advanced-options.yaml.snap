# Source: kaster/templates/kaster.yaml
apiVersion: redhatcop.redhat.io/v1alpha1
kind: VaultSecret
metadata:
  name: complex-advanced-secret
  labels:
    app.kubernetes.io/name: test
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: default
    app.kubernetes.io/managed-by: Helm
    spelbook: default
    chapter: default
    spell: kaster
    app: web-application
    component: database
    environment: production
    tier: backend
  annotations:
    vault.io/agent-inject: "true"
    vault.io/role: database-reader
spec:
  refreshThreshold: 90
  refreshPeriod: 10m0s
  vaultSecretDefinitions:
    - name: secret
      requestType: GET
      path: kv/data/default/default/glyphs-release/publics/complex-advanced-secret
      authentication:
        path: k8s-path-auth
        role: production-vault-reader
        serviceAccount:
          name: production-vault-reader
      connection:
        address: http://vault.vault.svc:8200
        tLSConfig:
          skipVerify: true
  output:
    name: production-db-credentials
    labels:
      app.kubernetes.io/name: test
      app.kubernetes.io/instance: test
      app.kubernetes.io/part-of: default
      app.kubernetes.io/managed-by: Helm
      spelbook: default
      chapter: default
      spell: kaster
      app: web-application
      component: database
      environment: production
      tier: backend
    annotations:
      vault.io/agent-inject: "true"
      vault.io/role: database-reader
    stringData: #tiene q haber una forma de hacer q esto funcione con un range del lado del operator para q no hagan falta las keys
        DATABASE_HOST: '{{ .secret.database-host }}'
        DATABASE_USER: '{{ .secret.database-user }}'
        DATABASE_NAME: '{{ .secret.database-name }}'
        DATABASE_PORT: 5432
        SSL_MODE: require
    type: Opaque
