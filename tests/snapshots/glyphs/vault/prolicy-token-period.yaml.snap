# Source: kaster/templates/kaster.yaml
apiVersion: redhatcop.redhat.io/v1alpha1
kind: KubernetesAuthEngineRole
metadata:
  name: periodic-app-policy
  namespace: vault
  labels:
    app.kubernetes.io/name: test
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: default
    app.kubernetes.io/managed-by: Helm
    spelbook: default
    chapter: default
    spell: kaster
spec:
  authentication:
    path: k8s-path-auth
    role: vault
    serviceAccount:
      name: vault
  connection:
    address: http://vault.vault.svc:8200
    tLSConfig:
      skipVerify: true
  path: default
  policies:
    - periodic-app-policy
  # Periodic token (seconds): renewable indefinitely, never reaches a max_ttl, so
  # vault-agent only ever renews and never re-authenticates. Use for consumers that
  # capture the token once and cannot pick up a rotation (e.g. versity's
  # --iam-vault-root-token, read at boot from the agent sink).
  tokenPeriod: 2764800
  targetServiceAccounts:
    - periodic-app-sa
  targetNamespaces:
    targetNamespaces:
      - glyphs-release
---
# Source: kaster/templates/kaster.yaml
apiVersion: redhatcop.redhat.io/v1alpha1
kind: Policy
metadata:
  name: periodic-app-policy
  namespace: vault
  labels:
    app.kubernetes.io/name: test
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: default
    app.kubernetes.io/managed-by: Helm
    spelbook: default
    chapter: default
    spell: kaster
spec:
  authentication:
    path: k8s-path-auth
    role: vault
    serviceAccount:
      name: vault
  connection:
    address: http://vault.vault.svc:8200
    tLSConfig:
      skipVerify: true
  policy: |
    path "kv/data/default/default/periodic-app-policy/*" {
      capabilities = ["create","read","update","delete","list"]
    }
    path "kv/metadata/default/default/periodic-app-policy/*" {
      capabilities = ["create","read","update","delete","list"]
    }
    path "kv/data/default/default/publics/*" {
      capabilities = ["read","list"]
    }
    path "kv/metadata/default/default/publics/*" {
      capabilities = ["read","list"]
    }
    path "kv/data/default/publics/*" {
      capabilities = ["read","list"]
    }
    path "kv/metadata/default/publics/*" {
      capabilities = ["read","list"]
    }
    path "kv/data/default/pipelines/*" {
      capabilities = ["read","list"]
    }
    path "kv/metadata/default/pipelines/*" {
      capabilities = ["read","list"]
    }
    path "sys/policies/password/*" {
      capabilities = ["read","list"]
    }
