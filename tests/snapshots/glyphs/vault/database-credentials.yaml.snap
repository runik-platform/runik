# Source: kaster/templates/kaster.yaml
apiVersion: redhatcop.redhat.io/v1alpha1
kind: Policy
metadata:
  name: myapp-policy
  namespace: vault
  labels:
    app.kubernetes.io/name: database-credentials-test
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: test-book
    app.kubernetes.io/managed-by: Helm
    spelbook: test-book
    chapter: base-system
    spell: database-credentials-test
spec:
  authentication:
    path: the-yaml-life
    role: vault
    serviceAccount:
      name: vault
  connection:
    address: http://vault.vault.svc:8200
    tLSConfig:
      skipVerify: false
  policy: |
    path "secret/data/test-book/base-system/myapp-policy/*" {
      capabilities = ["create","read","update","delete","list"]
    }
    path "secret/metadata/test-book/base-system/myapp-policy/*" {
      capabilities = ["create","read","update","delete","list"]
    }
    path "secret/data/test-book/base-system/publics/*" {
      capabilities = ["read","list"]
    }
    path "secret/metadata/test-book/base-system/publics/*" {
      capabilities = ["read","list"]
    }
    path "secret/data/test-book/publics/*" {
      capabilities = ["read","list"]
    }
    path "secret/metadata/test-book/publics/*" {
      capabilities = ["read","list"]
    }
    path "secret/data/test-book/pipelines/*" {
      capabilities = ["read","list"]
    }
    path "secret/metadata/test-book/pipelines/*" {
      capabilities = ["read","list"]
    }
    path "sys/policies/password/*" {
      capabilities = ["read","list"]
    }
    path "database-test-book-base-system/creds/*" {
      capabilities = ["read"]
    }
---
