# Source: kaster/templates/kaster.yaml
apiVersion: redhatcop.redhat.io/v1alpha1
kind: SecretEngineMount
metadata:
  name: database-test-book-base-system
  labels:
    app.kubernetes.io/name: database-credentials-test
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: test-book
    app.kubernetes.io/managed-by: Helm
    spelbook: test-book
    chapter: base-system
    spell: database-credentials-test
spec:
  authentication:
    path: the-yaml-life
    role: database-credentials-test
    serviceAccount:
      name: database-credentials-test
  connection:
    address: http://vault.vault.svc:8200
    tLSConfig:
      skipVerify: false
  type: database
  description: "Database secrets engine for dynamic PostgreSQL credentials"
  config:
    listingVisibility: hidden
---
# Source: kaster/templates/kaster.yaml
apiVersion: redhatcop.redhat.io/v1alpha1
kind: VaultSecret
metadata:
  name: myapp-db-credentials
  labels:
    app.kubernetes.io/name: database-credentials-test
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: test-book
    app.kubernetes.io/managed-by: Helm
    spelbook: test-book
    chapter: base-system
    spell: database-credentials-test
spec:
  refreshThreshold: 90
  refreshPeriod: 30m
  vaultSecretDefinitions:
    - name: secret
      requestType: GET
      path: database-test-book-base-system/creds/main-postgres-read-write
      authentication:
        path: the-yaml-life
        role: myapp
        serviceAccount:
          name: myapp
      connection:
        address: http://vault.vault.svc:8200
        tLSConfig:
          skipVerify: false
  output:
    name: myapp-db-credentials
    labels:
      app.kubernetes.io/name: database-credentials-test
      app.kubernetes.io/instance: test
      app.kubernetes.io/part-of: test-book
      app.kubernetes.io/managed-by: Helm
      spelbook: test-book
      chapter: base-system
      spell: database-credentials-test
    stringData: #tiene q haber una forma de hacer q esto funcione con un range del lado del operator para q no hagan falta las keys
        USERNAME: '{{ .secret.username }}'
        PASSWORD: '{{ .secret.password }}'
    type: Opaque
---
# Source: kaster/templates/kaster.yaml
apiVersion: redhatcop.redhat.io/v1alpha1
kind: VaultSecret
metadata:
  name: reporting-db-credentials
  labels:
    app.kubernetes.io/name: database-credentials-test
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: test-book
    app.kubernetes.io/managed-by: Helm
    spelbook: test-book
    chapter: base-system
    spell: database-credentials-test
spec:
  refreshThreshold: 90
  refreshPeriod: 45m
  vaultSecretDefinitions:
    - name: secret
      requestType: GET
      path: database-test-book-base-system/creds/main-postgres-read-only
      authentication:
        path: the-yaml-life
        role: reporting-app
        serviceAccount:
          name: reporting-app
      connection:
        address: http://vault.vault.svc:8200
        tLSConfig:
          skipVerify: false
  output:
    name: reporting-db-credentials
    labels:
      app.kubernetes.io/name: database-credentials-test
      app.kubernetes.io/instance: test
      app.kubernetes.io/part-of: test-book
      app.kubernetes.io/managed-by: Helm
      spelbook: test-book
      chapter: base-system
      spell: database-credentials-test
    stringData: #tiene q haber una forma de hacer q esto funcione con un range del lado del operator para q no hagan falta las keys
        USERNAME: '{{ .secret.username }}'
        PASSWORD: '{{ .secret.password }}'
    type: Opaque
