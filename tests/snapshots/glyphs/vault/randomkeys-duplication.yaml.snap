apiVersion: redhatcop.redhat.io/v1alpha1
kind: RandomSecret
metadata:
  name: harbor-admin-password-harbor-admin-password
  labels:
    app.kubernetes.io/name: test
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: default
    app.kubernetes.io/managed-by: Helm
    spelbook: default
    chapter: default
    spell: kaster
spec:
  authentication:
    path: k8s-path-auth
    role: test
    serviceAccount:
      name: test
  connection:
    address: http://vault.vault.svc:8200
    tLSConfig:
      skipVerify: true
  isKVSecretsEngineV2: true
  path: kv/data/default/default/glyphs-release/publics/
  secretKey: HARBOR_ADMIN_PASSWORD
  secretFormat:
    passwordPolicyName: simple-password-policy
