      app.kubernetes.io/name: test
      app.kubernetes.io/instance: test
      app.kubernetes.io/part-of: default
      app.kubernetes.io/managed-by: Helm
      spelbook: default
      chapter: default
      spell: kaster
    stringData:
        INTERNAL_TOKEN: '{{ index . "internal-token" "INTERNAL_TOKEN" }}'
        SECRET_KEY: '{{ index . "secret-key" "SECRET_KEY" }}'
        JWT_SECRET: '{{ index . "jwt-secret" "JWT_SECRET" }}'
    type: Opaque
