  vaultSecretDefinitions:
    - name: internal-token
      requestType: GET
      path: kv/data/default/default/glyphs-release/publics/forgejo-internal-secrets-internal-token
      authentication:
        path: k8s-path-auth
        role: test
        serviceAccount:
          name: test
      connection:
        address: http://vault.vault.svc:8200
        tLSConfig:
          skipVerify: true
    - name: secret-key
      requestType: GET
