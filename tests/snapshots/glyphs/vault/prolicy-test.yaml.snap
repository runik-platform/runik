# Source: kaster/templates/kaster.yaml
apiVersion: redhatcop.redhat.io/v1alpha1
kind: Policy
metadata:
  name: test-app-policy
  namespace: vault
  labels:
    app.kubernetes.io/name: test
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: default
    app.kubernetes.io/managed-by: Helm
    spelbook: default
    chapter: default
    spell: kaster
spec:
  authentication:
    path: k8s-path-auth
    role: vault
    serviceAccount:
      name: vault
  connection:
    address: http://vault.vault.svc:8200
    tLSConfig:
      skipVerify: true
  policy: |
    path "kv/data/default/default/test-app-policy/*" {
      capabilities = ["create","read","update","delete","list"]
    }
    path "kv/metadata/default/default/test-app-policy/*" {
      capabilities = ["create","read","update","delete","list"]
    }
    path "kv/data/default/default/publics/*" {
      capabilities = ["read","list"]
    }
    path "kv/metadata/default/default/publics/*" {
      capabilities = ["read","list"]
    }
    path "kv/data/default/publics/*" {
      capabilities = ["read","list"]
    }
    path "kv/metadata/default/publics/*" {
      capabilities = ["read","list"]
    }
    path "kv/data/default/pipelines/*" {
      capabilities = ["read","list"]
    }
    path "kv/metadata/default/pipelines/*" {
      capabilities = ["read","list"]
    }
    path "sys/policies/password/*" {
      capabilities = ["read","list"]
    }
    path "auth/token/*" {
      capabilities = ["read","list"]
    }
    path "sys/mounts" {
      capabilities = ["read"]
    }
---
