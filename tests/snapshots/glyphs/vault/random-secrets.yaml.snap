# Source: kaster/templates/kaster.yaml
apiVersion: redhatcop.redhat.io/v1alpha1
kind: RandomSecret
metadata:
  name: basic-random-secret
  labels:
    app.kubernetes.io/name: test
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: default
    app.kubernetes.io/managed-by: Helm
    spelbook: default
    chapter: default
    spell: kaster
spec:
  authentication:
    path: k8s-path-auth
    role: test
    serviceAccount:
      name: test
  connection:
    address: http://vault.vault.svc:8200
    tLSConfig:
      skipVerify: true
  isKVSecretsEngineV2: true
  path: kv/data/default/default/glyphs-release/publics/
  secretKey: password
  secretFormat:
    passwordPolicyName: simple-password-policy
---
