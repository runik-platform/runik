# Source: kaster/templates/kaster.yaml
apiVersion: redhatcop.redhat.io/v1alpha1
kind: VaultSecret
metadata:
  name: api-token
  labels:
    app.kubernetes.io/name: test
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: default
    app.kubernetes.io/managed-by: Helm
    spelbook: default
    chapter: default
    spell: kaster
spec:
  refreshThreshold: 90
  refreshPeriod: 3m0s
  vaultSecretDefinitions:
    - name: secret
      requestType: GET
      path: kv/data/default/default/glyphs-release/publics/api-token
      authentication:
        path: k8s-path-auth
        role: test
        serviceAccount:
          name: test
      connection:
        address: http://vault.vault.svc:8200
        tLSConfig:
          skipVerify: true
  output:
    name: api-token
    labels:
      app.kubernetes.io/name: test
      app.kubernetes.io/instance: test
      app.kubernetes.io/part-of: default
      app.kubernetes.io/managed-by: Helm
      spelbook: default
      chapter: default
      spell: kaster
    stringData:
        service: '{{ .secret.service }}'
        created-by: vault
        environment: production
        service: api-gateway
        token: '{{ index .secret "token" }}'
    type: Opaque
---
