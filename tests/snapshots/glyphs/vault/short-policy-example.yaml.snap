    app.kubernetes.io/managed-by: Helm
    spelbook: default
    chapter: default
    spell: kaster
spec:
  authentication:
    path: k8s-path-auth
    role: test
    serviceAccount:
      name: test
  connection:
    address: http://vault.vault.svc:8200
    tLSConfig:
      skipVerify: true
  isKVSecretsEngineV2: true
  path: kv/data/default/default/glyphs-release/publics/
  secretKey: token
  secretFormat:
    passwordPolicyName: short-policy
