# Source: kaster/templates/kaster.yaml
apiVersion: batch/v1
kind: Job
metadata:
  name: test-ed25519-key-keygen
  labels:
    app.kubernetes.io/name: test-ed25519-key-keygen
    app.kubernetes.io/instance: test
    app.kubernetes.io/managed-by: Helm
    spell: test-ed25519-key-keygen
spec:
  backoffLimit: 3
  template:
    metadata:
      labels:
        app.kubernetes.io/name: test-ed25519-key-keygen
        app.kubernetes.io/instance: test
      
      annotations:
        checksum/configmap-keygen-script: f14c54397afd06d59bfa6fdc983c4efe0a2acd0c2147e1feda626fe08097455f
        helm.sh/hook: post-install,post-upgrade
        helm.sh/hook-delete-policy: before-hook-creation
        helm.sh/hook-weight: "-5"
    spec:
      serviceAccountName: test
      restartPolicy: OnFailure
      
      containers:
        
        - name: test-ed25519-key-keygen-test-ed25519-key-keygen
          image: docker.io/hashicorp/vault:latest
          imagePullPolicy: IfNotPresent
          command:
            - /bin/sh
          args:
            - -c
            - apk add --no-cache openssh-client curl jq && /bin/sh /scripts/keygen.sh
          
          resources:
            limits:
              cpu: 200m
              memory: 256Mi
            requests:
              cpu: 100m
              memory: 128Mi
          
          volumeMounts:
          
            - name: keygen-sh
              
