---
# Source: kaster/templates/kaster.yaml
kind: ConfigMap
apiVersion: v1
metadata:
  name: keygen-sh
  labels:
    app.kubernetes.io/name: test-ed25519-key-keygen
    app.kubernetes.io/instance: test
    app.kubernetes.io/managed-by: Helm
    spell: test-ed25519-key-keygen
data:
  
  keygen-sh: |
    
    #!/bin/sh
    set -e
    echo "Generating ed25519 keypair for test-ed25519-key..."
    
    VAULT_ADDR="http://vault.vault.svc:8200"
    VAULT_PATH="kv/data/crypto-test/test/glyphs-release/publics/test-ed25519-key"
    VAULT_AUTH_PATH="k8s-path-auth"
    VAULT_ROLE="test"
    SA_TOKEN="$(cat /var/run/secrets/kubernetes.io/serviceaccount/token)"
    
    # Login to Vault using Kubernetes auth
    echo "Logging into Vault..."
    LOGIN_RESPONSE=$(curl -s -X POST "$VAULT_ADDR/v1/auth/$VAULT_AUTH_PATH/login" \
      -d "{\"jwt\":\"$SA_TOKEN\",\"role\":\"$VAULT_ROLE\"}")
    
    VAULT_TOKEN=$(echo "$LOGIN_RESPONSE" | jq -r '.auth.client_token')
    
    if [ -z "$VAULT_TOKEN" ] || [ "$VAULT_TOKEN" = "null" ]; then
      echo "Failed to login to Vault:"
      echo "$LOGIN_RESPONSE"
      exit 1
    fi
    
    echo "Logged in successfully"
    
    # Check if key exists - try KV v2 first, fallback to KV v1
    if curl -sf -H "X-Vault-Token: $VAULT_TOKEN" "$VAULT_ADDR/v1/$VAULT_PATH" >/dev/null 2>&1; then
      echo "Key already exists (KV v2), skipping"
      exit 0
    fi
    
    # Try KV v1 path
    VAULT_PATH_V1=$(echo "$VAULT_PATH" | sed 's|/data/|/|')
    if curl -sf -H "X-Vault-Token: $VAULT_TOKEN" "$VAULT_ADDR/v1/$VAULT_PATH_V1" >/dev/null 2>&1; then
      echo "Key already exists (KV v1), skipping"
      exit 0
    fi
    
    # Generate keypair
    ssh-keygen -t ed25519 -f /tmp/key -N "" -C "Test Ed25519 key"
    
    # Build JSON payloads for both KV versions
    JSON_V2=$(jq -n \
      --arg pk "$(cat /tmp/key | base64 -w 0)" \
      --arg pubk "$(cat /tmp/key.pub)" \
      --arg pubk64 "$(cat /tmp/key.pub | awk '{print $2}')" \
      --arg created "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
       \
      '{data: {private_key: $pk, public_key: $pubk, public_key_base64: $pubk64, algorithm: "ed25519", created_at: $created}}')
    
    JSON_V1=$(jq -n \
      --arg pk "$(cat /tmp/key | base64 -w 0)" \
      --arg pubk "$(cat /tmp/key.pub)" \
      --arg pubk64 "$(cat /tmp/key.pub | awk '{print $2}')" \
      --arg created "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
       \
      '{private_key: $pk, public_key: $pubk, public_key_base64: $pubk64, algorithm: "ed25519", created_at: $created}')
    
    # Try KV v2 first
    RESULT=$(curl -s -w "\\n%{http_code}" -X POST \
      -H "X-Vault-Token: $VAULT_TOKEN" \
      -H "Content-Type: application/json" \
      -d "$JSON_V2" "$VAULT_ADDR/v1/$VAULT_PATH")
    
    HTTP_CODE=$(echo "$RESULT" | tail -n1)
    BODY=$(echo "$RESULT" | sed '$d')
    
    if [ "$HTTP_CODE" = "200" ] || [ "$HTTP_CODE" = "204" ]; then
      echo "Stored in Vault (KV v2): $VAULT_PATH"
    else
      echo "KV v2 failed (HTTP $HTTP_CODE): $BODY"
      echo "Trying KV v1..."
    
      RESULT_V1=$(curl -s -w "\\n%{http_code}" -X POST \
        -H "X-Vault-Token: $VAULT_TOKEN" \
        -H "Content-Type: application/json" \
        -d "$JSON_V1" "$VAULT_ADDR/v1/$VAULT_PATH_V1")
    
      HTTP_CODE_V1=$(echo "$RESULT_V1" | tail -n1)
      BODY_V1=$(echo "$RESULT_V1" | sed '$d')
    
      if [ "$HTTP_CODE_V1" = "200" ] || [ "$HTTP_CODE_V1" = "204" ]; then
        echo "Stored in Vault (KV v1): $VAULT_PATH_V1"
      else
        echo "KV v1 failed (HTTP $HTTP_CODE_V1): $BODY_V1"
        exit 1
      fi
    fi
    
    echo "Done"
---
# Source: kaster/templates/kaster.yaml
kind: ConfigMap
apiVersion: v1
metadata:
  name: keygen-sh
  labels:
    app.kubernetes.io/name: test-dkim-key-keygen
    app.kubernetes.io/instance: test
    app.kubernetes.io/managed-by: Helm
    spell: test-dkim-key-keygen
data:
  
  keygen-sh: |
    
    #!/bin/sh
    set -e
    echo "Generating ed25519 keypair for test-dkim-key..."
    
    VAULT_ADDR="http://vault.vault.svc:8200"
    VAULT_PATH="kv/data/crypto-test/test/glyphs-release/publics/test-dkim-key"
    VAULT_AUTH_PATH="k8s-path-auth"
    VAULT_ROLE="test"
    SA_TOKEN="$(cat /var/run/secrets/kubernetes.io/serviceaccount/token)"
    
    # Login to Vault using Kubernetes auth
    echo "Logging into Vault..."
    LOGIN_RESPONSE=$(curl -s -X POST "$VAULT_ADDR/v1/auth/$VAULT_AUTH_PATH/login" \
      -d "{\"jwt\":\"$SA_TOKEN\",\"role\":\"$VAULT_ROLE\"}")
    
    VAULT_TOKEN=$(echo "$LOGIN_RESPONSE" | jq -r '.auth.client_token')
    
    if [ -z "$VAULT_TOKEN" ] || [ "$VAULT_TOKEN" = "null" ]; then
      echo "Failed to login to Vault:"
      echo "$LOGIN_RESPONSE"
      exit 1
    fi
    
    echo "Logged in successfully"
    
    # Check if key exists - try KV v2 first, fallback to KV v1
    if curl -sf -H "X-Vault-Token: $VAULT_TOKEN" "$VAULT_ADDR/v1/$VAULT_PATH" >/dev/null 2>&1; then
      echo "Key already exists (KV v2), skipping"
      exit 0
    fi
    
    # Try KV v1 path
    VAULT_PATH_V1=$(echo "$VAULT_PATH" | sed 's|/data/|/|')
    if curl -sf -H "X-Vault-Token: $VAULT_TOKEN" "$VAULT_ADDR/v1/$VAULT_PATH_V1" >/dev/null 2>&1; then
      echo "Key already exists (KV v1), skipping"
      exit 0
    fi
    
    # Generate keypair
    ssh-keygen -t ed25519 -f /tmp/key -N "" -C "DKIM signing key for test.example.com"
    
    # Build JSON payloads for both KV versions
    JSON_V2=$(jq -n \
      --arg pk "$(cat /tmp/key | base64 -w 0)" \
      --arg pubk "$(cat /tmp/key.pub)" \
      --arg pubk64 "$(cat /tmp/key.pub | awk '{print $2}')" \
      --arg created "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
      --arg domain "test.example.com" \
      '{data: {private_key: $pk, public_key: $pubk, public_key_base64: $pubk64, algorithm: "ed25519", domain: $domain, created_at: $created}}')
    
    JSON_V1=$(jq -n \
      --arg pk "$(cat /tmp/key | base64 -w 0)" \
      --arg pubk "$(cat /tmp/key.pub)" \
      --arg pubk64 "$(cat /tmp/key.pub | awk '{print $2}')" \
      --arg created "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
      --arg domain "test.example.com" \
      '{private_key: $pk, public_key: $pubk, public_key_base64: $pubk64, algorithm: "ed25519", domain: $domain, created_at: $created}')
    
    # Try KV v2 first
    RESULT=$(curl -s -w "\\n%{http_code}" -X POST \
      -H "X-Vault-Token: $VAULT_TOKEN" \
      -H "Content-Type: application/json" \
      -d "$JSON_V2" "$VAULT_ADDR/v1/$VAULT_PATH")
    
    HTTP_CODE=$(echo "$RESULT" | tail -n1)
    BODY=$(echo "$RESULT" | sed '$d')
    
    if [ "$HTTP_CODE" = "200" ] || [ "$HTTP_CODE" = "204" ]; then
      echo "Stored in Vault (KV v2): $VAULT_PATH"
    else
      echo "KV v2 failed (HTTP $HTTP_CODE): $BODY"
      echo "Trying KV v1..."
    
      RESULT_V1=$(curl -s -w "\\n%{http_code}" -X POST \
        -H "X-Vault-Token: $VAULT_TOKEN" \
        -H "Content-Type: application/json" \
        -d "$JSON_V1" "$VAULT_ADDR/v1/$VAULT_PATH_V1")
    
      HTTP_CODE_V1=$(echo "$RESULT_V1" | tail -n1)
      BODY_V1=$(echo "$RESULT_V1" | sed '$d')
    
      if [ "$HTTP_CODE_V1" = "200" ] || [ "$HTTP_CODE_V1" = "204" ]; then
        echo "Stored in Vault (KV v1): $VAULT_PATH_V1"
      else
        echo "KV v1 failed (HTTP $HTTP_CODE_V1): $BODY_V1"
        exit 1
      fi
    fi
    
    echo "Done"
---
