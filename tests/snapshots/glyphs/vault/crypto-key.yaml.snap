# Source: kaster/templates/kaster.yaml
apiVersion: redhatcop.redhat.io/v1alpha1
kind: VaultSecret
metadata:
  name: test-ed25519-key
  namespace: glyphs-release
  labels:
    app.kubernetes.io/name: test
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: crypto-test
    app.kubernetes.io/managed-by: Helm
    spelbook: crypto-test
    chapter: test
    spell: kaster
  annotations:
    
    argocd.argoproj.io/sync-options: Prune=false
spec:
  refreshPeriod: 3m0s
  vaultSecretDefinitions:
    - name: secret
      requestType: GET
      path: kv/data/crypto-test/test/glyphs-release/publics/test-ed25519-key
      authentication:
        path: k8s-path-auth
        role: test
        serviceAccount:
          name: test
      connection:
        address: http://vault.vault.svc:8200
        tLSConfig:
          skipVerify: true
  output:
    name: test-ed25519-key
    stringData:
      private_key: '{{ .secret.private_key }}'
      public_key: '{{ .secret.public_key }}'
      public_key_base64: '{{ .secret.public_key_base64 }}'
      algorithm: '{{ .secret.algorithm }}'
    type: Opaque
---
