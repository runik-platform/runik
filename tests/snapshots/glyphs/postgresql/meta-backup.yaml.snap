# Source: kaster/templates/kaster.yaml
apiVersion: postgresql.cnpg.io/v1
kind: ScheduledBackup
metadata:
  name: hildy-daily
  labels:
    app.kubernetes.io/name: test
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: test-postgresql
    app.kubernetes.io/managed-by: Helm
    spelbook: test-postgresql
    chapter: databases
    spell: kaster
spec:
  schedule: "0 0 3 * * *"
  cluster:
    name: hildy
  method: plugin
  pluginConfiguration:
    name: barman-cloud.cloudnative-pg.io
  backupOwnerReference: self
---
# Source: kaster/templates/kaster.yaml
apiVersion: redhatcop.redhat.io/v1alpha1
kind: VaultSecret
metadata:
  name: s3-identities-gateway-hildy-backup
  namespace: glyphs-release
  labels:
    app.kubernetes.io/name: test
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: test-postgresql
    app.kubernetes.io/managed-by: Helm
    spelbook: test-postgresql
    chapter: databases
    spell: kaster
    runik.ing/identity-name: test-postgresql-databases-hildy-backup
    runik.ing/s3-identity: "true"
    runik.ing/s3-provider: gateway
spec:
  refreshThreshold: 90
  refreshPeriod: 3m0s
  vaultSecretDefinitions:
    - name: aws-access-key-id
      requestType: GET
      path: kv/data/test-postgresql/databases/glyphs-release/publics/s3-identities-gateway-hildy-backup-aws-access-key-id
      authentication:
        path: test-postgresql
        role: test
        serviceAccount:
          name: test
      connection:
        address: http://vault.vault.svc:8200
        tLSConfig:
          skipVerify: false
    - name: aws-secret-access-key
      requestType: GET
      path: kv/data/test-postgresql/databases/glyphs-release/publics/s3-identities-gateway-hildy-backup-aws-secret-access-key
      authentication:
        path: test-postgresql
        role: test
        serviceAccount:
          name: test
      connection:
        address: http://vault.vault.svc:8200
        tLSConfig:
          skipVerify: false
  output:
    name: hildy-backup
    labels:
      app.kubernetes.io/name: test
      app.kubernetes.io/instance: test
      app.kubernetes.io/part-of: test-postgresql
      app.kubernetes.io/managed-by: Helm
      spelbook: test-postgresql
      chapter: databases
      spell: kaster
      runik.ing/identity-name: test-postgresql-databases-hildy-backup
      runik.ing/s3-identity: "true"
      runik.ing/s3-provider: gateway
    stringData: #tiene q haber una forma de hacer q esto funcione con un range del lado del operator para q no hagan falta las keys
        AWS_ENDPOINT: https://s3.example.test
        AWS_ENDPOINTS: https://s3.example.test
        AWS_REGION: us-east-1
        S3_BUCKET: test-postgresql-databases-hildy-backup
        AWS_ACCESS_KEY_ID: '{{ index . "aws-access-key-id" "AWS_ACCESS_KEY_ID" }}'
        AWS_SECRET_ACCESS_KEY: '{{ index . "aws-secret-access-key" "AWS_SECRET_ACCESS_KEY" }}'
    type: Opaque
---
