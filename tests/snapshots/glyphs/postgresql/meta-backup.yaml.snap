              },
              "expr": "cnpg_collector_pg_wal{namespace=\"glyphs-release\",cnpg_cluster=\"hildy\",value=\"size\"}",
              "legendFormat": "{{pod}}",
              "refId": "A"
            }
          ],
          "title": "WAL directory size",
          "type": "timeseries"
        },
        {
          "datasource": {
            "type": "prometheus",
