# Source: kaster/templates/kaster.yaml
apiVersion: postgresql.cnpg.io/v1
kind: Cluster
metadata:
  name: hildy
  labels:
    app.kubernetes.io/name: test
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: test-postgresql
    app.kubernetes.io/managed-by: Helm
    spelbook: test-postgresql
    chapter: databases
    spell: kaster
spec:
  description: PostgreSQL with auto-backups to VersityGW
  inheritedMetadata:
    annotations:
      prometheus.io/path: /metrics
      prometheus.io/port: "9187"
      prometheus.io/scrape: "true"

  instances: 2
  podSecurityContext:
    fsGroup: 26
    fsGroupChangePolicy: OnRootMismatch
    runAsGroup: 26
    runAsNonRoot: true
    runAsUser: 26
    seccompProfile:
      type: RuntimeDefault

  enableSuperuserAccess: true
  bootstrap:
    initdb:
      database: hildy
      owner: hildy
      secret:
        name: hildy-pg-app
  plugins:
    - name: barman-cloud.cloudnative-pg.io
      isWALArchiver: false
      parameters:
        barmanObjectName: hildy

  storage:
    size: 10Gi
---
# Source: kaster/templates/kaster.yaml
apiVersion: barmancloud.cnpg.io/v1
kind: ObjectStore
metadata:
  name: hildy
  labels:
    app.kubernetes.io/name: test
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: test-postgresql
    app.kubernetes.io/managed-by: Helm
    spelbook: test-postgresql
    chapter: databases
    spell: kaster
spec:
  configuration:
    destinationPath: "s3://test-postgresql-databases-hildy-backup/hildy"
    endpointURL: "http://s3.s3.svc:7070"
    s3Credentials:
      accessKeyId:
        name: hildy-backup
        key: AWS_ACCESS_KEY_ID
      secretAccessKey:
        name: hildy-backup
        key: AWS_SECRET_ACCESS_KEY
    wal:
      compression: gzip
    data:
      compression: gzip
  retentionPolicy: "90d"
---
# Source: kaster/templates/kaster.yaml
apiVersion: redhatcop.redhat.io/v1alpha1
kind: RandomSecret
metadata:
  name: s3-identities-gateway-hildy-backup-aws-access-key-id
  namespace: glyphs-release
  labels:
    app.kubernetes.io/name: test
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: test-postgresql
    app.kubernetes.io/managed-by: Helm
    spelbook: test-postgresql
    chapter: databases
    spell: kaster
    runik.ing/identity-name: test-postgresql-databases-hildy-backup
    runik.ing/s3-identity: "true"
    runik.ing/s3-provider: gateway
spec:
  authentication:
    path: test-postgresql
    role: test
    serviceAccount:
      name: test
  connection:
    address: http://vault.vault.svc:8200
    tLSConfig:
      skipVerify: false
  isKVSecretsEngineV2: true
  path: kv/data/test-postgresql/databases/glyphs-release/publics/
  secretKey: AWS_ACCESS_KEY_ID
  secretFormat:
    passwordPolicyName: short-policy
---
