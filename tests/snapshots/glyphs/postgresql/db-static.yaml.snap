# Source: kaster/templates/kaster.yaml
apiVersion: redhatcop.redhat.io/v1alpha1
kind: VaultSecret
metadata:
  name: harbor-pg-infra
  labels:
    app.kubernetes.io/name: harbor
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: test-book
    app.kubernetes.io/managed-by: Helm
    spelbook: test-book
    chapter: registries
    spell: harbor
  annotations:
    argocd.argoproj.io/sync-wave: "0"
    reloader.stakater.com/match: "true"
    runik.ing/credentials: static
    runik.ing/postgresql-cluster: pg-infra
spec:
  refreshThreshold: 80
  refreshPeriod: 1m0s
  vaultSecretDefinitions:
    - name: secret
      requestType: GET
      path: db/test-book/registries/harbor/static-creds/harbor
      authentication:
        path: the-yaml-life
        role: harbor
        serviceAccount:
          name: harbor
      connection:
        address: http://vault.vault.svc:8200
        tLSConfig:
          skipVerify: false
  output:
    name: harbor-pg-infra
    labels:
      app.kubernetes.io/name: harbor
      app.kubernetes.io/instance: test
      app.kubernetes.io/part-of: test-book
      app.kubernetes.io/managed-by: Helm
      spelbook: test-book
      chapter: registries
      spell: harbor
    annotations:
      argocd.argoproj.io/sync-wave: "0"
      reloader.stakater.com/match: "true"
      runik.ing/credentials: static
      runik.ing/postgresql-cluster: pg-infra
    stringData:
        username: '{{ .secret.username }}'
        password: '{{ .secret.password }}'
        database: registry
        dbname: registry
        host: pg-infra-rw.pg-infra.svc
        port: "5432"
    type: kubernetes.io/basic-auth
