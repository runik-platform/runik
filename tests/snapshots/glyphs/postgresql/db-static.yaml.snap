# Source: kaster/templates/kaster.yaml
apiVersion: redhatcop.redhat.io/v1alpha1
kind: Policy
metadata:
  name: harbor
  namespace: vault
  labels:
    app.kubernetes.io/name: harbor
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: test-book
    app.kubernetes.io/managed-by: Helm
    spelbook: test-book
    chapter: registries
    spell: harbor
  annotations:
    argocd.argoproj.io/sync-wave: "-5"
spec:
  authentication:
    path: the-yaml-life
    role: vault
    serviceAccount:
      name: vault
  connection:
    address: http://vault.vault.svc:8200
    tLSConfig:
      skipVerify: false
  policy: |
    path "secret/data/test-book/registries/glyphs-release/*" {
      capabilities = ["create","read","update","delete","list"]
    }
    path "secret/metadata/test-book/registries/glyphs-release/*" {
      capabilities = ["create","read","update","delete","list"]
    }
    path "secret/data/test-book/registries/publics/*" {
      capabilities = ["read","list"]
    }
    path "secret/metadata/test-book/registries/publics/*" {
      capabilities = ["read","list"]
    }
    path "secret/data/test-book/publics/*" {
      capabilities = ["read","list"]
    }
    path "secret/metadata/test-book/publics/*" {
      capabilities = ["read","list"]
    }
    path "secret/data/test-book/pipelines/*" {
      capabilities = ["read","list"]
    }
    path "secret/metadata/test-book/pipelines/*" {
      capabilities = ["read","list"]
    }
    path "sys/policies/password/*" {
      capabilities = ["read","list"]
    }
    path "db/test-book/registries/harbor/creds/*" {
      capabilities = ["read"]
    }
    path "db/test-book/registries/harbor/static-creds/*" {
      capabilities = ["read"]
    }
    path "sys/mounts" {
      capabilities = ["read"]
    }
    path "sys/mounts/db/test-book/registries/harbor" {
      capabilities = ["create","read","update","delete"]
    }
---
# Source: kaster/templates/kaster.yaml
apiVersion: redhatcop.redhat.io/v1alpha1
kind: SecretEngineMount
metadata:
  name: harbor
  namespace: glyphs-release
  labels:
    app.kubernetes.io/name: harbor
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: test-book
    app.kubernetes.io/managed-by: Helm
    spelbook: test-book
    chapter: registries
    spell: harbor
  annotations:
    argocd.argoproj.io/sync-wave: "-3"
spec:
  authentication:
    path: the-yaml-life
    role: harbor
    serviceAccount:
      name: harbor
  connection:
    address: http://vault.vault.svc:8200
    tLSConfig:
      skipVerify: false
  type: database
  path: db/test-book/registries
  description: "Runik database credentials for test-book/registries/harbor"
  config:
    listingVisibility: hidden
