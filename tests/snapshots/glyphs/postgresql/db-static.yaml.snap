# Source: kaster/templates/kaster.yaml
apiVersion: postgresql.cnpg.io/v1
kind: Database
metadata:
  name: pg-infra-registry
  namespace: pg-infra
  labels:
    app.kubernetes.io/name: harbor
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: test-book
    app.kubernetes.io/managed-by: Helm
    spelbook: test-book
    chapter: registries
    spell: harbor
  annotations:
    argocd.argoproj.io/sync-wave: "-2"
spec:
  cluster:
    name: pg-infra
  name: registry
  owner: harbor
  ensure: present
  databaseReclaimPolicy: retain
---
# Source: kaster/templates/kaster.yaml
apiVersion: postgresql.cnpg.io/v1
kind: DatabaseRole
metadata:
  name: pg-infra-harbor
  namespace: pg-infra
  labels:
    app.kubernetes.io/name: harbor
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: test-book
    app.kubernetes.io/managed-by: Helm
    spelbook: test-book
    chapter: registries
    spell: harbor
  annotations:
    argocd.argoproj.io/sync-wave: "-3"
spec:
  cluster:
    name: pg-infra
  name: harbor
  ensure: present
  login: true
  databaseRoleReclaimPolicy: retain
---
# Source: kaster/templates/kaster.yaml
apiVersion: redhatcop.redhat.io/v1alpha1
kind: DatabaseSecretEngineConfig
metadata:
  name: harbor-pg-infra
  namespace: vault
  labels:
    app.kubernetes.io/name: harbor
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: test-book
    app.kubernetes.io/managed-by: Helm
    spelbook: test-book
    chapter: registries
    spell: harbor
  annotations:
    argocd.argoproj.io/sync-wave: "-2"
spec:
  authentication:
    path: the-yaml-life
    role: vault
    serviceAccount:
      name: vault
  connection:
    address: http://vault.vault.svc:8200
    tLSConfig:
      skipVerify: false
  pluginName: postgresql-database-plugin
  allowedRoles:
    - harbor
  connectionURL: postgresql://{{username}}:{{password}}@pg-infra-rw.pg-infra.svc:5432/postgres
  passwordAuthentication: "password"
  rootCredentials:
    secret:
      name: pg-infra-vault-mgr-root
    passwordKey: password
    usernameKey: username
  path: db/test-book/registries/harbor
  rootPasswordRotation:
    rotationPeriod: "0s"
---
# Source: kaster/templates/kaster.yaml
apiVersion: redhatcop.redhat.io/v1alpha1
kind: DatabaseSecretEngineStaticRole
metadata:
  name: harbor
  namespace: vault
  labels:
    app.kubernetes.io/name: harbor
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: test-book
    app.kubernetes.io/managed-by: Helm
    spelbook: test-book
    chapter: registries
    spell: harbor
  annotations:
    argocd.argoproj.io/sync-wave: "-1"
spec:
  authentication:
    path: the-yaml-life
    role: vault
    serviceAccount:
      name: vault
  connection:
    address: http://vault.vault.svc:8200
    tLSConfig:
      skipVerify: false
  path: db/test-book/registries/harbor
  dBName: harbor-pg-infra
  username: "harbor"
  rotationPeriod: 2592000
  rotationStatements:
    - ALTER ROLE "{{name}}" WITH LOGIN PASSWORD '{{password}}';
  credentialType: password
  passwordCredentialConfig:
    passwordPolicy: short-policy
---
