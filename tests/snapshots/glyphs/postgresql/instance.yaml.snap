# Source: kaster/templates/kaster.yaml
apiVersion: postgresql.cnpg.io/v1
kind: Cluster
metadata:
  name: raw-instance
  labels:
    app.kubernetes.io/name: test
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: test-postgresql
    app.kubernetes.io/managed-by: Helm
    spelbook: test-postgresql
    chapter: databases
    spell: kaster
spec:
  description: Bare Cluster CRD with an existing Barman ObjectStore

  instances: 1

  enableSuperuserAccess: true
  bootstrap:
    initdb:
      database: app
      owner: app
      secret:
        name: app-pg-creds
  plugins:
    - name: barman-cloud.cloudnative-pg.io
      isWALArchiver: true
      parameters:
        barmanObjectName: raw-instance-objectstore

  storage:
    size: 5Gi
