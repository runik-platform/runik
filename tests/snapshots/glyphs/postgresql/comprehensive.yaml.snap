data:
  postgresql-d3a7304e6f3753a8.json: |
    {
      "description": "Standard CNPG and kubelet metrics. Missing volume data is reported by PostgreSQLVolumeMetricsMissing; it is not treated as free disk space.",
      "editable": false,
      "panels": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "fieldConfig": {
            "defaults": {
              "unit": "short"
            },
            "overrides": []
          },
          "gridPos": {
            "h": 8,
            "w": 12,
            "x": 0,
            "y": 0
          },
          "id": 1,
          "options": {
            "legend": {
              "displayMode": "list",
              "placement": "bottom"
            }
          },
          "targets": [
            {
              "datasource": {
                "type": "prometheus",
                "uid": "mimir"
              },
              "expr": "sum(cnpg_collector_up{namespace=\"glyphs-release\",cnpg_cluster=\"production-db\"})",
              "legendFormat": "",
              "refId": "A"
            }
          ],
          "title": "PostgreSQL instances up",
          "type": "stat"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "fieldConfig": {
            "defaults": {
              "unit": "short"
            },
            "overrides": []
          },
          "gridPos": {
            "h": 8,
            "w": 12,
            "x": 12,
            "y": 0
          },
          "id": 2,
          "options": {
            "legend": {
              "displayMode": "list",
              "placement": "bottom"
            }
          },
          "targets": [
            {
              "datasource": {
                "type": "prometheus",
                "uid": "mimir"
              },
              "expr": "max(cnpg_pg_replication_streaming_replicas{namespace=\"glyphs-release\",cnpg_cluster=\"production-db\",role=\"primary\"})",
              "legendFormat": "",
              "refId": "A"
            }
          ],
          "title": "Streaming replicas",
          "type": "stat"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "fieldConfig": {
            "defaults": {
              "unit": "bytes"
            },
            "overrides": []
          },
          "gridPos": {
            "h": 8,
            "w": 12,
            "x": 0,
            "y": 8
          },
          "id": 3,
