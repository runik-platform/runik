        uid: pd3a7304e6f37-collector-error
      - annotations:
          __dashboardUid__: pg-d3a7304e6f3753a8
          __panelId__: "1"
          summary: A configured standby is not streaming. Inspect its WAL receiver and
            replication slot.
        condition: C
        data:
        - datasourceUid: mimir
          model:
            editorMode: code
            expr: clamp_min(2 - (max(cnpg_pg_replication_streaming_replicas{namespace="glyphs-release",cnpg_cluster="production-db",role="primary"})
              or vector(0)), 0)
            instant: true
            intervalMs: 60000
            maxDataPoints: 43200
            range: false
            refId: A
          refId: A
          relativeTimeRange:
            from: 900
            to: 0
        - datasourceUid: __expr__
