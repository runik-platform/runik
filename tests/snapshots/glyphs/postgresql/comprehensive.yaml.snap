        - datasourceUid: mimir
          model:
            editorMode: code
            expr: cnpg_pg_replication_lag{namespace="glyphs-release",cnpg_cluster="production-db",role="replica"}
            instant: true
            intervalMs: 60000
            maxDataPoints: 43200
