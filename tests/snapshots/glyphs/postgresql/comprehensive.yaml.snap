---
# Source: kaster/templates/kaster.yaml
apiVersion: v1
kind: ConfigMap
metadata:
  name: production-db-alerts
  labels:
    app.kubernetes.io/name: test
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: test-postgresql
    app.kubernetes.io/managed-by: Helm
    spelbook: test-postgresql
    chapter: databases
    spell: kaster
    grafana_alert: "1"
data:
  postgresql-d3a7304e6f3753a8.yaml: |
    apiVersion: 1
    deleteRules:
    - orgId: 1
      uid: pd3a7304e6f37-archive-stalled
    - orgId: 1
      uid: pd3a7304e6f37-archive-errors
    groups:
    - folder: PostgreSQL
      interval: 1m
      name: postgresql-d3a7304e6f3753a8
      orgId: 1
      rules:
      - annotations:
          __dashboardUid__: pg-d3a7304e6f3753a8
          __panelId__: "1"
          summary: No PostgreSQL metrics for five minutes; check discovery, scrape and
            exporter.
        condition: C
        data:
        - datasourceUid: mimir
          model:
            editorMode: code
            expr: absent_over_time(cnpg_collector_up{namespace="glyphs-release",cnpg_cluster="production-db"}[5m])
            instant: true
            intervalMs: 60000
            maxDataPoints: 43200
            range: false
            refId: A
          refId: A
          relativeTimeRange:
            from: 900
            to: 0
        - datasourceUid: __expr__
          model:
            expression: A
            reducer: last
            refId: B
            type: reduce
          refId: B
          relativeTimeRange:
            from: 900
            to: 0
        - datasourceUid: __expr__
          model:
            conditions:
            - evaluator:
                params:
                - 0
                type: gt
            expression: B
            refId: C
            type: threshold
          refId: C
          relativeTimeRange:
            from: 900
            to: 0
        execErrState: Alerting
        for: 2m
        isPaused: false
        labels:
          cnpg_cluster: production-db
          component: postgresql
          namespace: glyphs-release
          severity: critical
        noDataState: OK
        title: PostgreSQLMetricsMissing / glyphs-release / production-db
        uid: pd3a7304e6f37-metrics-missing
      - annotations:
          __dashboardUid__: pg-d3a7304e6f3753a8
          __panelId__: "1"
          summary: Fewer healthy PostgreSQL instances than configured; inspect replication
            before WAL accumulates.
        condition: C
        data:
        - datasourceUid: mimir
          model:
            editorMode: code
            expr: clamp_min(3 - (sum(cnpg_collector_up{namespace="glyphs-release",cnpg_cluster="production-db"})
              or vector(0)), 0)
            instant: true
            intervalMs: 60000
            maxDataPoints: 43200
            range: false
            refId: A
          refId: A
          relativeTimeRange:
            from: 900
            to: 0
        - datasourceUid: __expr__
          model:
            expression: A
            reducer: last
            refId: B
            type: reduce
          refId: B
          relativeTimeRange:
            from: 900
            to: 0
        - datasourceUid: __expr__
          model:
            conditions:
            - evaluator:
                params:
                - 0
                type: gt
            expression: B
            refId: C
            type: threshold
          refId: C
          relativeTimeRange:
            from: 900
            to: 0
        execErrState: Alerting
        for: 5m
        isPaused: false
        labels:
          cnpg_cluster: production-db
          component: postgresql
          namespace: glyphs-release
          severity: warning
        noDataState: OK
        title: PostgreSQLInstancesUnavailable / glyphs-release / production-db
        uid: pd3a7304e6f37-instances-missing
      - annotations:
          __dashboardUid__: pg-d3a7304e6f3753a8
          __panelId__: "1"
          summary: No healthy PostgreSQL primary is being monitored.
        condition: C
        data:
        - datasourceUid: mimir
          model:
            editorMode: code
            expr: clamp_min(1 - (sum(cnpg_collector_up{namespace="glyphs-release",cnpg_cluster="production-db",role="primary"})
              or vector(0)), 0)
            instant: true
            intervalMs: 60000
            maxDataPoints: 43200
            range: false
            refId: A
          refId: A
          relativeTimeRange:
            from: 900
            to: 0
        - datasourceUid: __expr__
          model:
            expression: A
            reducer: last
            refId: B
            type: reduce
          refId: B
          relativeTimeRange:
            from: 900
            to: 0
        - datasourceUid: __expr__
          model:
            conditions:
            - evaluator:
                params:
                - 0
                type: gt
            expression: B
            refId: C
            type: threshold
          refId: C
          relativeTimeRange:
            from: 900
            to: 0
        execErrState: Alerting
        for: 2m
        isPaused: false
        labels:
          cnpg_cluster: production-db
          component: postgresql
          namespace: glyphs-release
          severity: critical
        noDataState: OK
        title: PostgreSQLPrimaryUnavailable / glyphs-release / production-db
        uid: pd3a7304e6f37-primary-down
      - annotations:
          __dashboardUid__: pg-d3a7304e6f3753a8
          __panelId__: "3"
          summary: A replication slot is retaining a significant fraction of its WAL filesystem.
            Check the replica and remaining disk space.
        condition: C
        data:
        - datasourceUid: mimir
          model:
            editorMode: code
            expr: cnpg_pg_replication_slots_pg_wal_lsn_diff{namespace="glyphs-release",cnpg_cluster="production-db",role="primary"}
              / on(namespace,pod) group_left() (max by(namespace,pod) (label_replace(kubelet_volume_stats_capacity_bytes{namespace="glyphs-release",persistentvolumeclaim=~"(production-db-[0-9]+)-wal"},
              "pod", "$1", "persistentvolumeclaim", "(production-db-[0-9]+)-wal")) or
              on(namespace,pod) max by(namespace,pod) (label_replace(kubelet_volume_stats_capacity_bytes{namespace="glyphs-release",persistentvolumeclaim=~"(production-db-[0-9]+)"},
              "pod", "$1", "persistentvolumeclaim", "(production-db-[0-9]+)")))
            instant: true
            intervalMs: 60000
            maxDataPoints: 43200
            range: false
            refId: A
          refId: A
          relativeTimeRange:
            from: 900
            to: 0
        - datasourceUid: __expr__
          model:
            expression: A
            reducer: last
            refId: B
            type: reduce
          refId: B
          relativeTimeRange:
            from: 900
            to: 0
        - datasourceUid: __expr__
          model:
            conditions:
            - evaluator:
                params:
                - 0.1
                type: gt
            expression: B
            refId: C
            type: threshold
          refId: C
          relativeTimeRange:
            from: 900
            to: 0
        execErrState: Alerting
        for: 5m
        isPaused: false
        labels:
          cnpg_cluster: production-db
          component: postgresql
          namespace: glyphs-release
          severity: warning
        noDataState: OK
        title: PostgreSQLSlotRetainedWALHigh / glyphs-release / production-db
        uid: pd3a7304e6f37-slot-warning
      - annotations:
          __dashboardUid__: pg-d3a7304e6f3753a8
          __panelId__: "3"
          summary: Replication slot WAL retention threatens primary and standby storage;
            repair or rebuild the lagging replica.
        condition: C
        data:
        - datasourceUid: mimir
          model:
            editorMode: code
            expr: cnpg_pg_replication_slots_pg_wal_lsn_diff{namespace="glyphs-release",cnpg_cluster="production-db",role="primary"}
              / on(namespace,pod) group_left() (max by(namespace,pod) (label_replace(kubelet_volume_stats_capacity_bytes{namespace="glyphs-release",persistentvolumeclaim=~"(production-db-[0-9]+)-wal"},
              "pod", "$1", "persistentvolumeclaim", "(production-db-[0-9]+)-wal")) or
              on(namespace,pod) max by(namespace,pod) (label_replace(kubelet_volume_stats_capacity_bytes{namespace="glyphs-release",persistentvolumeclaim=~"(production-db-[0-9]+)"},
              "pod", "$1", "persistentvolumeclaim", "(production-db-[0-9]+)")))
            instant: true
            intervalMs: 60000
            maxDataPoints: 43200
            range: false
            refId: A
          refId: A
          relativeTimeRange:
            from: 900
            to: 0
        - datasourceUid: __expr__
          model:
            expression: A
            reducer: last
            refId: B
            type: reduce
          refId: B
          relativeTimeRange:
            from: 900
            to: 0
        - datasourceUid: __expr__
          model:
            conditions:
            - evaluator:
                params:
                - 0.2
                type: gt
            expression: B
            refId: C
            type: threshold
          refId: C
          relativeTimeRange:
            from: 900
            to: 0
        execErrState: Alerting
        for: 5m
        isPaused: false
        labels:
          cnpg_cluster: production-db
          component: postgresql
          namespace: glyphs-release
          severity: critical
        noDataState: OK
        title: PostgreSQLSlotRetainedWALCritical / glyphs-release / production-db
        uid: pd3a7304e6f37-slot-critical
      - annotations:
          __dashboardUid__: pg-d3a7304e6f3753a8
          __panelId__: "3"
          summary: An unlimited slot is retaining more than max_wal_size. Restore replication
            or set a retention budget before storage fills.
        condition: C
        data:
        - datasourceUid: mimir
          model:
            editorMode: code
            expr: (cnpg_pg_replication_slots_pg_wal_lsn_diff{namespace="glyphs-release",cnpg_cluster="production-db",role="primary"}
              > on(namespace,pod,cnpg_cluster) group_left() (cnpg_pg_settings_setting{namespace="glyphs-release",cnpg_cluster="production-db",role="primary",name="max_wal_size"}
              * 1048576)) and on(namespace,pod,cnpg_cluster) (cnpg_pg_settings_setting{namespace="glyphs-release",cnpg_cluster="production-db",role="primary",name="max_slot_wal_keep_size"}
              < 0)
            instant: true
            intervalMs: 60000
            maxDataPoints: 43200
            range: false
            refId: A
          refId: A
          relativeTimeRange:
            from: 900
            to: 0
        - datasourceUid: __expr__
          model:
            expression: A
            reducer: last
            refId: B
            type: reduce
          refId: B
          relativeTimeRange:
            from: 900
            to: 0
        - datasourceUid: __expr__
          model:
            conditions:
            - evaluator:
                params:
                - 0
                type: gt
            expression: B
            refId: C
            type: threshold
          refId: C
          relativeTimeRange:
            from: 900
            to: 0
        execErrState: Alerting
        for: 5m
        isPaused: false
        labels:
          cnpg_cluster: production-db
          component: postgresql
          namespace: glyphs-release
          severity: warning
        noDataState: OK
        title: PostgreSQLSlotWALRetentionUnbounded / glyphs-release / production-db
        uid: pd3a7304e6f37-slot-unlimited
      - annotations:
          __dashboardUid__: pg-d3a7304e6f3753a8
          __panelId__: "3"
          summary: A slot has used over 75% of its configured WAL retention budget; catch
            up before WAL becomes unavailable.
        condition: C
        data:
        - datasourceUid: mimir
          model:
            editorMode: code
            expr: cnpg_pg_replication_slots_pg_wal_lsn_diff{namespace="glyphs-release",cnpg_cluster="production-db",role="primary"}
              / on(namespace,pod,cnpg_cluster) group_left() ((cnpg_pg_settings_setting{namespace="glyphs-release",cnpg_cluster="production-db",role="primary",name="max_slot_wal_keep_size"}
              > 0) * 1048576)
            instant: true
            intervalMs: 60000
            maxDataPoints: 43200
            range: false
            refId: A
          refId: A
          relativeTimeRange:
            from: 900
            to: 0
        - datasourceUid: __expr__
          model:
            expression: A
            reducer: last
            refId: B
            type: reduce
          refId: B
          relativeTimeRange:
            from: 900
            to: 0
        - datasourceUid: __expr__
          model:
            conditions:
            - evaluator:
                params:
                - 0.75
                type: gt
            expression: B
            refId: C
            type: threshold
          refId: C
          relativeTimeRange:
            from: 900
            to: 0
        execErrState: Alerting
        for: 5m
        isPaused: false
        labels:
          cnpg_cluster: production-db
          component: postgresql
          namespace: glyphs-release
          severity: warning
        noDataState: OK
        title: PostgreSQLSlotWALBudgetLow / glyphs-release / production-db
        uid: pd3a7304e6f37-slot-budget
      - annotations:
          __dashboardUid__: pg-d3a7304e6f3753a8
          __panelId__: "7"
          summary: PostgreSQL PVC free space is low. Inspect WAL retention, archiving
            and volume growth.
        condition: C
        data:
        - datasourceUid: mimir
          model:
            editorMode: code
            expr: 1 - kubelet_volume_stats_available_bytes{namespace="glyphs-release",persistentvolumeclaim=~"production-db-[0-9]+(-wal)?"}
              / kubelet_volume_stats_capacity_bytes{namespace="glyphs-release",persistentvolumeclaim=~"production-db-[0-9]+(-wal)?"}
            instant: true
            intervalMs: 60000
            maxDataPoints: 43200
            range: false
            refId: A
          refId: A
          relativeTimeRange:
            from: 900
            to: 0
        - datasourceUid: __expr__
          model:
            expression: A
            reducer: last
            refId: B
            type: reduce
          refId: B
          relativeTimeRange:
            from: 900
            to: 0
        - datasourceUid: __expr__
          model:
            conditions:
            - evaluator:
                params:
                - 0.8
                type: gt
            expression: B
            refId: C
            type: threshold
          refId: C
          relativeTimeRange:
            from: 900
            to: 0
        execErrState: Alerting
        for: 5m
        isPaused: false
        labels:
          cnpg_cluster: production-db
          component: postgresql
          namespace: glyphs-release
          severity: warning
        noDataState: OK
        title: PostgreSQLDiskAlmostFull / glyphs-release / production-db
        uid: pd3a7304e6f37-disk-warning
      - annotations:
          __dashboardUid__: pg-d3a7304e6f3753a8
          __panelId__: "7"
          summary: PostgreSQL PVC is critically full; act before PostgreSQL stops and
            failover candidates run out of space.
        condition: C
        data:
        - datasourceUid: mimir
          model:
            editorMode: code
            expr: 1 - kubelet_volume_stats_available_bytes{namespace="glyphs-release",persistentvolumeclaim=~"production-db-[0-9]+(-wal)?"}
              / kubelet_volume_stats_capacity_bytes{namespace="glyphs-release",persistentvolumeclaim=~"production-db-[0-9]+(-wal)?"}
            instant: true
            intervalMs: 60000
            maxDataPoints: 43200
            range: false
            refId: A
          refId: A
          relativeTimeRange:
            from: 900
            to: 0
        - datasourceUid: __expr__
          model:
            expression: A
            reducer: last
            refId: B
            type: reduce
          refId: B
          relativeTimeRange:
            from: 900
            to: 0
        - datasourceUid: __expr__
          model:
            conditions:
            - evaluator:
                params:
                - 0.9
                type: gt
            expression: B
            refId: C
            type: threshold
          refId: C
          relativeTimeRange:
            from: 900
            to: 0
        execErrState: Alerting
        for: 2m
        isPaused: false
        labels:
          cnpg_cluster: production-db
          component: postgresql
          namespace: glyphs-release
          severity: critical
        noDataState: OK
        title: PostgreSQLDiskCritical / glyphs-release / production-db
        uid: pd3a7304e6f37-disk-critical
      - annotations:
          __dashboardUid__: pg-d3a7304e6f3753a8
          __panelId__: "7"
          summary: PostgreSQL is up but its PVC metrics are missing. Disk alerts cannot
            evaluate; check kubelet volume metrics.
        condition: C
        data:
        - datasourceUid: mimir
          model:
            editorMode: code
            expr: cnpg_collector_up{namespace="glyphs-release",cnpg_cluster="production-db"}
              unless on(namespace,pod) label_replace((kubelet_volume_stats_capacity_bytes{namespace="glyphs-release",persistentvolumeclaim=~"production-db-[0-9]+(-wal)?"}
              and on(namespace,persistentvolumeclaim) kubelet_volume_stats_available_bytes{namespace="glyphs-release",persistentvolumeclaim=~"production-db-[0-9]+(-wal)?"}),
              "pod", "$1", "persistentvolumeclaim", "(production-db-[0-9]+)(-wal)?")
            instant: true
            intervalMs: 60000
            maxDataPoints: 43200
            range: false
            refId: A
          refId: A
          relativeTimeRange:
            from: 900
            to: 0
        - datasourceUid: __expr__
          model:
            expression: A
            reducer: last
            refId: B
            type: reduce
          refId: B
          relativeTimeRange:
            from: 900
            to: 0
        - datasourceUid: __expr__
          model:
            conditions:
            - evaluator:
                params:
                - 0
                type: gt
            expression: B
            refId: C
            type: threshold
          refId: C
          relativeTimeRange:
            from: 900
            to: 0
        execErrState: Alerting
        for: 10m
        isPaused: false
        labels:
          cnpg_cluster: production-db
          component: postgresql
          namespace: glyphs-release
          severity: warning
        noDataState: OK
        title: PostgreSQLVolumeMetricsMissing / glyphs-release / production-db
        uid: pd3a7304e6f37-disk-metrics
      - annotations:
          __dashboardUid__: pg-d3a7304e6f3753a8
          __panelId__: "11"
          summary: PostgreSQL connection usage is approaching max_connections.
        condition: C
        data:
        - datasourceUid: mimir
          model:
            editorMode: code
            expr: sum by (namespace,pod,cnpg_cluster) (cnpg_backends_total{namespace="glyphs-release",cnpg_cluster="production-db"})
              / on(namespace,pod,cnpg_cluster) max by (namespace,pod,cnpg_cluster) (cnpg_pg_settings_setting{namespace="glyphs-release",cnpg_cluster="production-db",name="max_connections"})
            instant: true
            intervalMs: 60000
            maxDataPoints: 43200
            range: false
            refId: A
          refId: A
          relativeTimeRange:
            from: 900
            to: 0
        - datasourceUid: __expr__
          model:
            expression: A
            reducer: last
            refId: B
            type: reduce
          refId: B
          relativeTimeRange:
            from: 900
            to: 0
        - datasourceUid: __expr__
          model:
            conditions:
            - evaluator:
                params:
                - 0.8
                type: gt
            expression: B
            refId: C
            type: threshold
          refId: C
          relativeTimeRange:
            from: 900
            to: 0
        execErrState: Alerting
        for: 5m
        isPaused: false
        labels:
          cnpg_cluster: production-db
          component: postgresql
          namespace: glyphs-release
          severity: warning
        noDataState: OK
        title: PostgreSQLConnectionsHigh / glyphs-release / production-db
        uid: pd3a7304e6f37-connections
      - annotations:
          __dashboardUid__: pg-d3a7304e6f3753a8
          __panelId__: "14"
