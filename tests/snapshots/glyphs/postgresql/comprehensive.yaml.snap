            to: 0
        - datasourceUid: __expr__
          model:
            conditions:
            - evaluator:
                params:
                - 0
                type: gt
            expression: B
            refId: C
            type: threshold
          refId: C
          relativeTimeRange:
            from: 900
            to: 0
        execErrState: Alerting
        for: 5m
        isPaused: false
        labels:
          cnpg_cluster: production-db
          component: postgresql
          namespace: glyphs-release
          severity: warning
        noDataState: OK
        title: PostgreSQLStreamingReplicasMissing / glyphs-release / production-db
        uid: pd3a7304e6f37-streaming
      - annotations:
          __dashboardUid__: pg-d3a7304e6f3753a8
          __panelId__: "6"
          summary: A standby is behind the primary; inspect connectivity, replay and retained
            WAL.
        condition: C
