            }
          },
          "targets": [
            {
              "datasource": {
                "type": "prometheus",
                "uid": "mimir"
              },
              "expr": "sum by (datname) (rate(cnpg_pg_stat_database_xact_commit{namespace=\"glyphs-release\",cnpg_cluster=\"production-db\",role=\"primary\"}[5m]))",
              "legendFormat": "{{datname}}",
              "refId": "A"
            }
          ],
