# Source: kaster/templates/kaster.yaml
apiVersion: redhatcop.redhat.io/v1alpha1
kind: Policy
metadata:
  name: miapp
  namespace: vault
  labels:
    app.kubernetes.io/name: miapp
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: test-book
    app.kubernetes.io/managed-by: Helm
    spelbook: test-book
    chapter: admintools
    spell: miapp
  annotations:
    argocd.argoproj.io/sync-wave: "-5"
spec:
  authentication:
    path: the-yaml-life
    role: vault
    serviceAccount:
      name: vault
  connection:
    address: http://vault.vault.svc:8200
    tLSConfig:
      skipVerify: false
  policy: |
    path "secret/data/test-book/admintools/glyphs-release/*" {
      capabilities = ["create","read","update","delete","list"]
    }
    path "secret/metadata/test-book/admintools/glyphs-release/*" {
      capabilities = ["create","read","update","delete","list"]
    }
    path "secret/data/test-book/admintools/publics/*" {
      capabilities = ["read","list"]
    }
    path "secret/metadata/test-book/admintools/publics/*" {
      capabilities = ["read","list"]
    }
    path "secret/data/test-book/publics/*" {
      capabilities = ["read","list"]
    }
    path "secret/metadata/test-book/publics/*" {
      capabilities = ["read","list"]
    }
    path "secret/data/test-book/pipelines/*" {
      capabilities = ["read","list"]
    }
    path "secret/metadata/test-book/pipelines/*" {
      capabilities = ["read","list"]
    }
    path "sys/policies/password/*" {
      capabilities = ["read","list"]
    }
    path "db/test-book/admintools/miapp/creds/*" {
      capabilities = ["read"]
    }
    path "db/test-book/admintools/miapp/static-creds/*" {
      capabilities = ["read"]
    }
    path "sys/mounts" {
      capabilities = ["read"]
    }
    path "sys/mounts/db/test-book/admintools/miapp" {
      capabilities = ["create","read","update","delete"]
    }
---
# Source: kaster/templates/kaster.yaml
apiVersion: redhatcop.redhat.io/v1alpha1
kind: SecretEngineMount
metadata:
  name: miapp
  namespace: glyphs-release
  labels:
    app.kubernetes.io/name: miapp
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: test-book
    app.kubernetes.io/managed-by: Helm
    spelbook: test-book
    chapter: admintools
    spell: miapp
  annotations:
    argocd.argoproj.io/sync-wave: "-3"
spec:
  authentication:
    path: the-yaml-life
    role: miapp
    serviceAccount:
      name: miapp
  connection:
    address: http://vault.vault.svc:8200
    tLSConfig:
      skipVerify: false
  type: database
  path: db/test-book/admintools
  description: "Runik database credentials for test-book/admintools/miapp"
  config:
    listingVisibility: hidden
---
# Source: kaster/templates/kaster.yaml
apiVersion: redhatcop.redhat.io/v1alpha1
kind: VaultSecret
metadata:
  name: miapp
  labels:
    app.kubernetes.io/name: miapp
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: test-book
    app.kubernetes.io/managed-by: Helm
    spelbook: test-book
    chapter: admintools
    spell: miapp
  annotations:
    argocd.argoproj.io/sync-wave: "0"
    runik.ing/credentials: dynamic
    runik.ing/postgresql-cluster: shared-pg
spec:
  refreshThreshold: 90
  refreshPeriod: 30m0s
  vaultSecretDefinitions:
    - name: secret
      requestType: GET
      path: db/test-book/admintools/miapp/creds/miapp
      authentication:
        path: the-yaml-life
        role: miapp
        serviceAccount:
          name: miapp
      connection:
        address: http://vault.vault.svc:8200
        tLSConfig:
          skipVerify: false
  output:
    name: miapp
    labels:
      app.kubernetes.io/name: miapp
      app.kubernetes.io/instance: test
      app.kubernetes.io/part-of: test-book
      app.kubernetes.io/managed-by: Helm
      spelbook: test-book
      chapter: admintools
      spell: miapp
    annotations:
      argocd.argoproj.io/sync-wave: "0"
      runik.ing/credentials: dynamic
      runik.ing/postgresql-cluster: shared-pg
    stringData: #tiene q haber una forma de hacer q esto funcione con un range del lado del operator para q no hagan falta las keys
        USERNAME: '{{ .secret.username }}'
        PASSWORD: '{{ .secret.password }}'
        DBNAME: miapp
        HOST: shared-pg-rw.databases.svc
        PORT: "5432"
    type: Opaque
