# Source: kaster/templates/kaster.yaml
apiVersion: postgresql.cnpg.io/v1
kind: Database
metadata:
  name: miapp
  namespace: databases
  labels:
    app.kubernetes.io/name: miapp
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: test-book
    app.kubernetes.io/managed-by: Helm
    spelbook: test-book
    chapter: admintools
    spell: miapp
  annotations:
    argocd.argoproj.io/sync-wave: "-2"
spec:
  cluster:
    name: shared-pg
  name: miapp
  owner: miapp
  ensure: present
  databaseReclaimPolicy: retain
---
# Source: kaster/templates/kaster.yaml
apiVersion: postgresql.cnpg.io/v1
kind: DatabaseRole
metadata:
  name: shared-pg-miapp
  namespace: databases
  labels:
    app.kubernetes.io/name: miapp
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: test-book
    app.kubernetes.io/managed-by: Helm
    spelbook: test-book
    chapter: admintools
    spell: miapp
  annotations:
    argocd.argoproj.io/sync-wave: "-3"
spec:
  cluster:
    name: shared-pg
  name: miapp
  ensure: present
  login: false
  databaseRoleReclaimPolicy: retain
---
# Source: kaster/templates/kaster.yaml
apiVersion: redhatcop.redhat.io/v1alpha1
kind: DatabaseSecretEngineConfig
metadata:
  name: miapp-shared-pg
  namespace: vault
  labels:
    app.kubernetes.io/name: miapp
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: test-book
    app.kubernetes.io/managed-by: Helm
    spelbook: test-book
    chapter: admintools
    spell: miapp
  annotations:
    argocd.argoproj.io/sync-wave: "-2"
spec:
  authentication:
    path: the-yaml-life
    role: vault
    serviceAccount:
      name: vault
  connection:
    address: http://vault.vault.svc:8200
    tLSConfig:
      skipVerify: false
  pluginName: postgresql-database-plugin
  allowedRoles:
    - miapp
  connectionURL: postgresql://{{username}}:{{password}}@shared-pg-rw.databases.svc:5432/postgres
  passwordAuthentication: "password"
  rootCredentials:
    secret:
      name: shared-pg-vault-mgr-root
    passwordKey: password
    usernameKey: username
  path: db/test-book/admintools/miapp
  rootPasswordRotation:
    rotationPeriod: "0s"
---
# Source: kaster/templates/kaster.yaml
apiVersion: redhatcop.redhat.io/v1alpha1
kind: DatabaseSecretEngineRole
metadata:
  name: miapp
  namespace: vault
  labels:
    app.kubernetes.io/name: miapp
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: test-book
    app.kubernetes.io/managed-by: Helm
    spelbook: test-book
    chapter: admintools
    spell: miapp
  annotations:
    argocd.argoproj.io/sync-wave: "-1"
spec:
  authentication:
    path: the-yaml-life
    role: vault
    serviceAccount:
      name: vault
  connection:
    address: http://vault.vault.svc:8200
    tLSConfig:
      skipVerify: false
  path: db/test-book/admintools/miapp
  dBName: miapp-shared-pg
  creationStatements:
    - CREATE ROLE "{{name}}" WITH LOGIN PASSWORD '{{password}}' VALID UNTIL '{{expiration}}'
      IN ROLE "miapp";
    - ALTER ROLE "{{name}}" SET ROLE "miapp";
