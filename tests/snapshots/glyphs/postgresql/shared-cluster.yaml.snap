          __dashboardUid__: pg-5570d3b283a9c716
          __panelId__: "7"
          summary: PostgreSQL PVC is critically full; act before PostgreSQL stops and
            failover candidates run out of space.
        condition: C
        data:
        - datasourceUid: mimir
          model:
            editorMode: code
            expr: 1 - kubelet_volume_stats_available_bytes{namespace="glyphs-release",persistentvolumeclaim=~"shared-pg-[0-9]+(-wal)?"}
              / kubelet_volume_stats_capacity_bytes{namespace="glyphs-release",persistentvolumeclaim=~"shared-pg-[0-9]+(-wal)?"}
            instant: true
            intervalMs: 60000
            maxDataPoints: 43200
            range: false
            refId: A
          refId: A
          relativeTimeRange:
            from: 900
            to: 0
        - datasourceUid: __expr__
          model:
            expression: A
            reducer: last
            refId: B
            type: reduce
          refId: B
          relativeTimeRange:
            from: 900
            to: 0
        - datasourceUid: __expr__
          model:
            conditions:
            - evaluator:
                params:
                - 0.9
                type: gt
            expression: B
            refId: C
            type: threshold
          refId: C
          relativeTimeRange:
            from: 900
            to: 0
        execErrState: Alerting
        for: 2m
        isPaused: false
        labels:
          cnpg_cluster: shared-pg
          component: postgresql
          namespace: glyphs-release
          severity: critical
