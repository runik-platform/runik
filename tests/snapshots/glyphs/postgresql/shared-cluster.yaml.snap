        title: PostgreSQLDiskCritical / glyphs-release / shared-pg
        uid: p5570d3b283a9-disk-critical
      - annotations:
          __dashboardUid__: pg-5570d3b283a9c716
          __panelId__: "7"
          summary: PostgreSQL is up but its PVC metrics are missing. Disk alerts cannot
            evaluate; check kubelet volume metrics.
        condition: C
        data:
        - datasourceUid: mimir
          model:
            editorMode: code
            expr: cnpg_collector_up{namespace="glyphs-release",cnpg_cluster="shared-pg"}
              unless on(namespace,pod) label_replace((kubelet_volume_stats_capacity_bytes{namespace="glyphs-release",persistentvolumeclaim=~"shared-pg-[0-9]+(-wal)?"}
              and on(namespace,persistentvolumeclaim) kubelet_volume_stats_available_bytes{namespace="glyphs-release",persistentvolumeclaim=~"shared-pg-[0-9]+(-wal)?"}),
              "pod", "$1", "persistentvolumeclaim", "(shared-pg-[0-9]+)(-wal)?")
            instant: true
            intervalMs: 60000
            maxDataPoints: 43200
            range: false
            refId: A
          refId: A
          relativeTimeRange:
            from: 900
            to: 0
        - datasourceUid: __expr__
          model:
            expression: A
            reducer: last
            refId: B
            type: reduce
          refId: B
          relativeTimeRange:
            from: 900
            to: 0
        - datasourceUid: __expr__
          model:
            conditions:
            - evaluator:
                params:
                - 0
                type: gt
            expression: B
            refId: C
            type: threshold
          refId: C
          relativeTimeRange:
            from: 900
            to: 0
        execErrState: Alerting
        for: 10m
        isPaused: false
        labels:
          cnpg_cluster: shared-pg
          component: postgresql
          namespace: glyphs-release
          severity: warning
        noDataState: OK
