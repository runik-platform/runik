            }
          },
          "targets": [
            {
              "datasource": {
                "type": "prometheus",
                "uid": "mimir"
              },
              "expr": "increase(cnpg_pg_stat_archiver_failed_count{namespace=\"glyphs-release\",cnpg_cluster=\"shared-pg\",role=\"primary\"}[15m])",
