---
# Source: kaster/templates/kaster.yaml
apiVersion: v1
kind: ConfigMap
metadata:
  name: shared-pg-alerts
  labels:
    app.kubernetes.io/name: shared-pg
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: test-book
    app.kubernetes.io/managed-by: Helm
    spelbook: test-book
    chapter: databases
    spell: shared-pg
    grafana_alert: "1"
data:
  postgresql-5570d3b283a9c716.yaml: |
    apiVersion: 1
    deleteRules:
    - orgId: 1
      uid: p5570d3b283a9-archive-stalled
    - orgId: 1
      uid: p5570d3b283a9-archive-errors
    groups:
    - folder: PostgreSQL
      interval: 1m
      name: postgresql-5570d3b283a9c716
      orgId: 1
      rules:
      - annotations:
          __dashboardUid__: pg-5570d3b283a9c716
          __panelId__: "1"
          summary: No PostgreSQL metrics for five minutes; check discovery, scrape and
            exporter.
        condition: C
        data:
        - datasourceUid: mimir
          model:
            editorMode: code
            expr: absent_over_time(cnpg_collector_up{namespace="glyphs-release",cnpg_cluster="shared-pg"}[5m])
            instant: true
            intervalMs: 60000
            maxDataPoints: 43200
            range: false
            refId: A
          refId: A
          relativeTimeRange:
            from: 900
            to: 0
        - datasourceUid: __expr__
          model:
            expression: A
            reducer: last
            refId: B
            type: reduce
          refId: B
          relativeTimeRange:
            from: 900
            to: 0
        - datasourceUid: __expr__
          model:
            conditions:
            - evaluator:
                params:
                - 0
                type: gt
            expression: B
            refId: C
            type: threshold
          refId: C
          relativeTimeRange:
            from: 900
            to: 0
        execErrState: Alerting
        for: 2m
        isPaused: false
        labels:
          cnpg_cluster: shared-pg
          component: postgresql
          namespace: glyphs-release
          severity: critical
        noDataState: OK
        title: PostgreSQLMetricsMissing / glyphs-release / shared-pg
        uid: p5570d3b283a9-metrics-missing
      - annotations:
          __dashboardUid__: pg-5570d3b283a9c716
          __panelId__: "1"
          summary: Fewer healthy PostgreSQL instances than configured; inspect replication
            before WAL accumulates.
        condition: C
        data:
        - datasourceUid: mimir
          model:
            editorMode: code
            expr: clamp_min(3 - (sum(cnpg_collector_up{namespace="glyphs-release",cnpg_cluster="shared-pg"})
              or vector(0)), 0)
            instant: true
            intervalMs: 60000
            maxDataPoints: 43200
            range: false
            refId: A
          refId: A
          relativeTimeRange:
            from: 900
            to: 0
        - datasourceUid: __expr__
          model:
            expression: A
            reducer: last
            refId: B
            type: reduce
          refId: B
          relativeTimeRange:
            from: 900
            to: 0
        - datasourceUid: __expr__
          model:
            conditions:
            - evaluator:
                params:
                - 0
                type: gt
            expression: B
            refId: C
            type: threshold
          refId: C
          relativeTimeRange:
            from: 900
            to: 0
        execErrState: Alerting
        for: 5m
        isPaused: false
        labels:
          cnpg_cluster: shared-pg
          component: postgresql
          namespace: glyphs-release
          severity: warning
        noDataState: OK
        title: PostgreSQLInstancesUnavailable / glyphs-release / shared-pg
        uid: p5570d3b283a9-instances-missing
      - annotations:
          __dashboardUid__: pg-5570d3b283a9c716
          __panelId__: "1"
          summary: No healthy PostgreSQL primary is being monitored.
        condition: C
        data:
        - datasourceUid: mimir
          model:
            editorMode: code
            expr: clamp_min(1 - (sum(cnpg_collector_up{namespace="glyphs-release",cnpg_cluster="shared-pg",role="primary"})
              or vector(0)), 0)
            instant: true
            intervalMs: 60000
            maxDataPoints: 43200
            range: false
            refId: A
          refId: A
          relativeTimeRange:
            from: 900
            to: 0
        - datasourceUid: __expr__
          model:
            expression: A
            reducer: last
            refId: B
            type: reduce
          refId: B
          relativeTimeRange:
            from: 900
            to: 0
        - datasourceUid: __expr__
          model:
            conditions:
            - evaluator:
                params:
                - 0
                type: gt
            expression: B
            refId: C
            type: threshold
          refId: C
          relativeTimeRange:
            from: 900
            to: 0
        execErrState: Alerting
        for: 2m
        isPaused: false
        labels:
          cnpg_cluster: shared-pg
          component: postgresql
          namespace: glyphs-release
          severity: critical
        noDataState: OK
        title: PostgreSQLPrimaryUnavailable / glyphs-release / shared-pg
        uid: p5570d3b283a9-primary-down
      - annotations:
          __dashboardUid__: pg-5570d3b283a9c716
          __panelId__: "3"
          summary: A replication slot is retaining a significant fraction of its WAL filesystem.
            Check the replica and remaining disk space.
        condition: C
        data:
        - datasourceUid: mimir
          model:
            editorMode: code
            expr: cnpg_pg_replication_slots_pg_wal_lsn_diff{namespace="glyphs-release",cnpg_cluster="shared-pg",role="primary"}
              / on(namespace,pod) group_left() (max by(namespace,pod) (label_replace(kubelet_volume_stats_capacity_bytes{namespace="glyphs-release",persistentvolumeclaim=~"(shared-pg-[0-9]+)-wal"},
              "pod", "$1", "persistentvolumeclaim", "(shared-pg-[0-9]+)-wal")) or on(namespace,pod)
              max by(namespace,pod) (label_replace(kubelet_volume_stats_capacity_bytes{namespace="glyphs-release",persistentvolumeclaim=~"(shared-pg-[0-9]+)"},
              "pod", "$1", "persistentvolumeclaim", "(shared-pg-[0-9]+)")))
            instant: true
            intervalMs: 60000
            maxDataPoints: 43200
            range: false
            refId: A
          refId: A
          relativeTimeRange:
            from: 900
            to: 0
        - datasourceUid: __expr__
          model:
            expression: A
            reducer: last
            refId: B
            type: reduce
          refId: B
          relativeTimeRange:
            from: 900
            to: 0
        - datasourceUid: __expr__
          model:
            conditions:
            - evaluator:
                params:
                - 0.1
                type: gt
            expression: B
            refId: C
            type: threshold
          refId: C
          relativeTimeRange:
            from: 900
            to: 0
        execErrState: Alerting
        for: 5m
        isPaused: false
        labels:
          cnpg_cluster: shared-pg
          component: postgresql
          namespace: glyphs-release
          severity: warning
        noDataState: OK
        title: PostgreSQLSlotRetainedWALHigh / glyphs-release / shared-pg
        uid: p5570d3b283a9-slot-warning
      - annotations:
          __dashboardUid__: pg-5570d3b283a9c716
          __panelId__: "3"
          summary: Replication slot WAL retention threatens primary and standby storage;
            repair or rebuild the lagging replica.
        condition: C
        data:
        - datasourceUid: mimir
          model:
            editorMode: code
            expr: cnpg_pg_replication_slots_pg_wal_lsn_diff{namespace="glyphs-release",cnpg_cluster="shared-pg",role="primary"}
              / on(namespace,pod) group_left() (max by(namespace,pod) (label_replace(kubelet_volume_stats_capacity_bytes{namespace="glyphs-release",persistentvolumeclaim=~"(shared-pg-[0-9]+)-wal"},
              "pod", "$1", "persistentvolumeclaim", "(shared-pg-[0-9]+)-wal")) or on(namespace,pod)
              max by(namespace,pod) (label_replace(kubelet_volume_stats_capacity_bytes{namespace="glyphs-release",persistentvolumeclaim=~"(shared-pg-[0-9]+)"},
              "pod", "$1", "persistentvolumeclaim", "(shared-pg-[0-9]+)")))
            instant: true
            intervalMs: 60000
            maxDataPoints: 43200
            range: false
            refId: A
          refId: A
          relativeTimeRange:
            from: 900
            to: 0
        - datasourceUid: __expr__
          model:
            expression: A
            reducer: last
            refId: B
            type: reduce
          refId: B
          relativeTimeRange:
            from: 900
            to: 0
        - datasourceUid: __expr__
          model:
            conditions:
            - evaluator:
                params:
                - 0.2
                type: gt
            expression: B
            refId: C
            type: threshold
          refId: C
          relativeTimeRange:
            from: 900
            to: 0
        execErrState: Alerting
        for: 5m
        isPaused: false
        labels:
          cnpg_cluster: shared-pg
          component: postgresql
          namespace: glyphs-release
          severity: critical
        noDataState: OK
        title: PostgreSQLSlotRetainedWALCritical / glyphs-release / shared-pg
        uid: p5570d3b283a9-slot-critical
      - annotations:
          __dashboardUid__: pg-5570d3b283a9c716
          __panelId__: "3"
          summary: An unlimited slot is retaining more than max_wal_size. Restore replication
            or set a retention budget before storage fills.
        condition: C
        data:
        - datasourceUid: mimir
          model:
            editorMode: code
            expr: (cnpg_pg_replication_slots_pg_wal_lsn_diff{namespace="glyphs-release",cnpg_cluster="shared-pg",role="primary"}
              > on(namespace,pod,cnpg_cluster) group_left() (cnpg_pg_settings_setting{namespace="glyphs-release",cnpg_cluster="shared-pg",role="primary",name="max_wal_size"}
              * 1048576)) and on(namespace,pod,cnpg_cluster) (cnpg_pg_settings_setting{namespace="glyphs-release",cnpg_cluster="shared-pg",role="primary",name="max_slot_wal_keep_size"}
              < 0)
            instant: true
