              "expr": "sum by (namespace,pod,cnpg_cluster) (cnpg_backends_total{namespace=\"glyphs-release\",cnpg_cluster=\"shared-pg\"}) / on(namespace,pod,cnpg_cluster) max by (namespace,pod,cnpg_cluster) (cnpg_pg_settings_setting{namespace=\"glyphs-release\",cnpg_cluster=\"shared-pg\",name=\"max_connections\"})",
