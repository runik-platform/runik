# Source: kaster/templates/kaster.yaml
apiVersion: redhatcop.redhat.io/v1alpha1
kind: VaultSecret
metadata:
  name: shared-pg-superuser
  labels:
    app.kubernetes.io/name: shared-pg
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: test-book
    app.kubernetes.io/managed-by: Helm
    spelbook: test-book
    chapter: databases
    spell: shared-pg
spec:
  refreshThreshold: 90
  refreshPeriod: 3m0s
  vaultSecretDefinitions:
    - name: secret
      requestType: GET
      path: secret/data/test-book/databases/glyphs-release/publics/shared-pg-superuser
      authentication:
        path: the-yaml-life
        role: shared-pg
        serviceAccount:
          name: shared-pg
      connection:
        address: http://vault.vault.svc:8200
        tLSConfig:
          skipVerify: false
  output:
    name: shared-pg-superuser
    labels:
      app.kubernetes.io/name: shared-pg
      app.kubernetes.io/instance: test
      app.kubernetes.io/part-of: test-book
      app.kubernetes.io/managed-by: Helm
      spelbook: test-book
      chapter: databases
      spell: shared-pg
    stringData:
        username: postgres
        password: '{{ .secret.password }}'
    type: kubernetes.io/basic-auth
