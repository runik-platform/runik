      - annotations:
          __dashboardUid__: pg-5570d3b283a9c716
          __panelId__: "3"
          summary: A slot has used over 75% of its configured WAL retention budget; catch
            up before WAL becomes unavailable.
        condition: C
        data:
        - datasourceUid: mimir
          model:
            editorMode: code
            expr: cnpg_pg_replication_slots_pg_wal_lsn_diff{namespace="glyphs-release",cnpg_cluster="shared-pg",role="primary"}
              / on(namespace,pod,cnpg_cluster) group_left() ((cnpg_pg_settings_setting{namespace="glyphs-release",cnpg_cluster="shared-pg",role="primary",name="max_slot_wal_keep_size"}
              > 0) * 1048576)
            instant: true
            intervalMs: 60000
            maxDataPoints: 43200
            range: false
            refId: A
          refId: A
          relativeTimeRange:
            from: 900
            to: 0
        - datasourceUid: __expr__
          model:
            expression: A
            reducer: last
            refId: B
            type: reduce
          refId: B
          relativeTimeRange:
            from: 900
            to: 0
        - datasourceUid: __expr__
          model:
            conditions:
            - evaluator:
                params:
                - 0.75
                type: gt
            expression: B
            refId: C
            type: threshold
          refId: C
          relativeTimeRange:
            from: 900
            to: 0
