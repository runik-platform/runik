              "datasource": {
                "type": "prometheus",
                "uid": "mimir"
              },
              "expr": "kubelet_volume_stats_available_bytes{namespace=\"glyphs-release\",persistentvolumeclaim=~\"shared-pg-[0-9]+(-wal)?\"}",
              "legendFormat": "{{persistentvolumeclaim}}",
              "refId": "A"
            }
          ],
          "title": "PVC space available",
          "type": "timeseries"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "fieldConfig": {
            "defaults": {
              "unit": "s"
            },
            "overrides": []
          },
          "gridPos": {
            "h": 8,
            "w": 12,
            "x": 0,
            "y": 32
          },
          "id": 9,
          "options": {
            "legend": {
              "displayMode": "list",
              "placement": "bottom"
            }
          },
          "targets": [
            {
              "datasource": {
                "type": "prometheus",
                "uid": "mimir"
              },
              "expr": "cnpg_pg_stat_archiver_seconds_since_last_archival{namespace=\"glyphs-release\",cnpg_cluster=\"shared-pg\",role=\"primary\"}",
              "legendFormat": "",
              "refId": "A"
            }
          ],
          "title": "Seconds since successful WAL archive",
          "type": "timeseries"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "fieldConfig": {
            "defaults": {
              "unit": "short"
            },
            "overrides": []
          },
          "gridPos": {
            "h": 8,
            "w": 12,
            "x": 12,
            "y": 32
          },
          "id": 10,
          "options": {
            "legend": {
              "displayMode": "list",
