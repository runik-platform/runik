# Source: kaster/templates/kaster.yaml
apiVersion: redhatcop.redhat.io/v1alpha1
kind: Policy
metadata:
  name: app-db
  namespace: vault
  labels:
    app.kubernetes.io/name: multi-engine
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: test-book
    app.kubernetes.io/managed-by: Helm
    spelbook: test-book
    chapter: apps
    spell: multi-engine
  annotations:
    argocd.argoproj.io/sync-wave: "-5"
spec:
  authentication:
    path: the-yaml-life
    role: vault
    serviceAccount:
      name: vault
  connection:
    address: http://vault.vault.svc:8200
    tLSConfig:
      skipVerify: false
  policy: |
    path "secret/data/test-book/apps/app-db/*" {
      capabilities = ["create","read","update","delete","list"]
    }
    path "secret/metadata/test-book/apps/app-db/*" {
      capabilities = ["create","read","update","delete","list"]
    }
    path "secret/data/test-book/apps/publics/*" {
      capabilities = ["read","list"]
    }
    path "secret/metadata/test-book/apps/publics/*" {
      capabilities = ["read","list"]
    }
    path "secret/data/test-book/publics/*" {
      capabilities = ["read","list"]
    }
    path "secret/metadata/test-book/publics/*" {
      capabilities = ["read","list"]
    }
    path "secret/data/test-book/pipelines/*" {
      capabilities = ["read","list"]
    }
    path "secret/metadata/test-book/pipelines/*" {
      capabilities = ["read","list"]
    }
    path "sys/policies/password/*" {
      capabilities = ["read","list"]
    }
    path "db/test-book/apps/multi-engine/creds/*" {
      capabilities = ["read"]
    }
    path "db/test-book/apps/multi-engine/static-creds/*" {
      capabilities = ["read"]
    }
    path "sys/mounts" {
      capabilities = ["read"]
    }
    path "sys/mounts/db/test-book/apps/multi-engine" {
      capabilities = ["create","read","update","delete"]
    }
---
