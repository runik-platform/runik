    path: the-yaml-life
    role: app-db
    serviceAccount:
      name: multi-engine
  connection:
    address: http://vault.vault.svc:8200
    tLSConfig:
      skipVerify: false
  type: database
  path: db/test-book/apps
  description: "Runik database credentials for test-book/apps/multi-engine"
  config:
    listingVisibility: hidden
