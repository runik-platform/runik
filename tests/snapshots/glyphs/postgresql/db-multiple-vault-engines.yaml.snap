apiVersion: postgresql.cnpg.io/v1
kind: Database
metadata:
  name: app
  namespace: databases
  labels:
    app.kubernetes.io/name: multi-engine
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: test-book
    app.kubernetes.io/managed-by: Helm
    spelbook: test-book
    chapter: apps
    spell: multi-engine
  annotations:
    argocd.argoproj.io/sync-wave: "-2"
spec:
  cluster:
    name: shared-pg
  name: app
  owner: app
  ensure: present
  databaseReclaimPolicy: retain
---
