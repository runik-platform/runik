# Source: kaster/templates/kaster.yaml
apiVersion: redhatcop.redhat.io/v1alpha1
kind: VaultSecret
metadata:
  name: app-pg
  labels:
    app.kubernetes.io/name: multi-engine
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: test-book
    app.kubernetes.io/managed-by: Helm
    spelbook: test-book
    chapter: apps
    spell: multi-engine
  annotations:
    argocd.argoproj.io/sync-wave: "0"
    runik.ing/credentials: dynamic
    runik.ing/postgresql-cluster: shared-pg
spec:
  refreshThreshold: 90
  refreshPeriod: 30m0s
  vaultSecretDefinitions:
    - name: secret
      requestType: GET
      path: db/test-book/apps/multi-engine/creds/app
      authentication:
        path: the-yaml-life
        role: app-db
        serviceAccount:
          name: multi-engine
      connection:
        address: http://vault.vault.svc:8200
        tLSConfig:
          skipVerify: false
  output:
    name: app-pg
    labels:
      app.kubernetes.io/name: multi-engine
      app.kubernetes.io/instance: test
      app.kubernetes.io/part-of: test-book
      app.kubernetes.io/managed-by: Helm
      spelbook: test-book
      chapter: apps
      spell: multi-engine
    annotations:
      argocd.argoproj.io/sync-wave: "0"
      runik.ing/credentials: dynamic
      runik.ing/postgresql-cluster: shared-pg
    stringData: #tiene q haber una forma de hacer q esto funcione con un range del lado del operator para q no hagan falta las keys
        USERNAME: '{{ .secret.username }}'
        PASSWORD: '{{ .secret.password }}'
        DBNAME: app
        HOST: shared-pg-rw.databases.svc
        PORT: "5432"
    type: Opaque
---
