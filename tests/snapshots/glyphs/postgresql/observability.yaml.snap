            }
          },
          "targets": [
            {
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "expr": "increase(cnpg_pg_stat_archiver_failed_count{namespace=\"glyphs-release\",cnpg_cluster=\"monitored\",role=\"primary\"}[15m])",
