          },
          "targets": [
            {
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "expr": "1 - kubelet_volume_stats_available_bytes{namespace=\"glyphs-release\",persistentvolumeclaim=~\"monitored-[0-9]+(-wal)?\"} / kubelet_volume_stats_capacity_bytes{namespace=\"glyphs-release\",persistentvolumeclaim=~\"monitored-[0-9]+(-wal)?\"}",
              "legendFormat": "{{persistentvolumeclaim}}",
              "refId": "A"
            }
          ],
          "title": "PVC space used",
          "type": "timeseries"
        },
        {
          "datasource": {
            "type": "prometheus",
