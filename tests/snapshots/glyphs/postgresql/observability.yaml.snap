# Source: kaster/templates/kaster.yaml
apiVersion: postgresql.cnpg.io/v1
kind: Cluster
metadata:
  name: metrics-only
  labels:
    app.kubernetes.io/name: postgres-observability
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: test-book
    app.kubernetes.io/managed-by: Helm
    spelbook: test-book
    chapter: databases
    spell: postgres-observability
spec:
  description: PostgreSQL cluster for metrics-only
  inheritedMetadata:
    annotations:
      prometheus.io/path: /metrics
      prometheus.io/port: "9187"
      prometheus.io/scrape: "true"

  instances: 1

  enableSuperuserAccess: true

  storage:
    size: 1Gi
---
# Source: kaster/templates/kaster.yaml
apiVersion: postgresql.cnpg.io/v1
kind: Cluster
metadata:
  name: monitored
  labels:
    app.kubernetes.io/name: postgres-observability
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: test-book
    app.kubernetes.io/managed-by: Helm
    spelbook: test-book
    chapter: databases
    spell: postgres-observability
spec:
  description: PostgreSQL cluster for monitored
  inheritedMetadata:
    annotations:
      example.com/owner: database-team
      prometheus.io/path: /metrics
      prometheus.io/port: "9187"
      prometheus.io/scrape: "true"
    labels:
      team: platform
  monitoring:
    metricsQueriesTTL: 30

  instances: 3

  enableSuperuserAccess: true
  plugins:
    - name: barman-cloud.cloudnative-pg.io
      isWALArchiver: false
      parameters:
        barmanObjectName: monitored

  storage:
    size: 1Gi
---
# Source: kaster/templates/kaster.yaml
apiVersion: postgresql.cnpg.io/v1
kind: Cluster
metadata:
  name: unmonitored
  labels:
    app.kubernetes.io/name: postgres-observability
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: test-book
    app.kubernetes.io/managed-by: Helm
    spelbook: test-book
    chapter: databases
    spell: postgres-observability
spec:
  description: PostgreSQL cluster for unmonitored

  instances: 1

  enableSuperuserAccess: true

  storage:
    size: 1Gi
