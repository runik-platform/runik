# Source: kaster/templates/kaster.yaml
apiVersion: barmancloud.cnpg.io/v1
kind: ObjectStore
metadata:
  name: monitored
  labels:
    app.kubernetes.io/name: postgres-observability
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: test-book
    app.kubernetes.io/managed-by: Helm
    spelbook: test-book
    chapter: databases
    spell: postgres-observability
spec:
  configuration:
    destinationPath: "s3://test-book-databases-monitored-backup/monitored"
    endpointURL: "https://s3.example.com"
    s3Credentials:
      accessKeyId:
        name: external-backup
        key: AWS_ACCESS_KEY_ID
      secretAccessKey:
        name: external-backup
        key: AWS_SECRET_ACCESS_KEY
    wal:
      compression: gzip
    data:
      compression: gzip
  retentionPolicy: "90d"
---
# Source: kaster/templates/kaster.yaml
apiVersion: postgresql.cnpg.io/v1
kind: ScheduledBackup
metadata:
  name: monitored-daily
  labels:
    app.kubernetes.io/name: postgres-observability
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: test-book
    app.kubernetes.io/managed-by: Helm
    spelbook: test-book
    chapter: databases
    spell: postgres-observability
spec:
  schedule: "0 0 3 * * *"
  cluster:
    name: monitored
  method: plugin
  pluginConfiguration:
    name: barman-cloud.cloudnative-pg.io
  backupOwnerReference: self
