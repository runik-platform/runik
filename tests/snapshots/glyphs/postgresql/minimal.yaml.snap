# Source: kaster/templates/kaster.yaml
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: pg-eso-orders
  namespace: databases
  annotations:
    argocd.argoproj.io/sync-wave: "-4"

spec:
  refreshPolicy: Periodic
  refreshInterval: 720h
  target:
    name: pg-eso-orders
    creationPolicy: Orphan
    deletionPolicy: Retain
    template:
      type: kubernetes.io/basic-auth
      metadata:
        labels:
          cnpg.io/reload: "true"
      data:
        database: orders
        dbname: orders
        host: pg-eso-rw.databases.svc
        password: '{{ .password }}'
        port: "5432"
        username: orders
  dataFrom:
    - sourceRef:
        generatorRef:
          apiVersion: generators.external-secrets.io/v1alpha1
          kind: Password
          name: pg-eso-orders
---
# Source: kaster/templates/kaster.yaml
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: orders-db
  namespace: glyphs-release
  annotations:
    argocd.argoproj.io/sync-wave: "0"

spec:
  secretStoreRef:
    name: app-secrets
    kind: SecretStore
  refreshPolicy: Periodic
  refreshInterval: 1m
  target:
    name: orders-db
    creationPolicy: Orphan
    deletionPolicy: Retain
    template:
      type: kubernetes.io/basic-auth
      data:
        database: orders
        dbname: orders
        host: pg-eso-rw.databases.svc
        password: '{{ .password }}'
        port: "5432"
        username: orders
  dataFrom:
  - extract:
      key: example/production/orders-app
