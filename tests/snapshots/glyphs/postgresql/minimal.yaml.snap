    app.kubernetes.io/part-of: test-postgresql
    app.kubernetes.io/managed-by: Helm
    spelbook: test-postgresql
    chapter: databases
    spell: kaster
  annotations:
    argocd.argoproj.io/sync-wave: "-2"
spec:
  cluster:
    name: pg-eso
  name: orders
  owner: orders
  ensure: present
  databaseReclaimPolicy: retain
