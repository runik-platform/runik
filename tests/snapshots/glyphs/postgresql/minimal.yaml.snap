# Source: kaster/templates/kaster.yaml
apiVersion: postgresql.cnpg.io/v1
kind: Cluster
metadata:
  name: eso-db
  labels:
    app.kubernetes.io/name: test
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: test-postgresql
    app.kubernetes.io/managed-by: Helm
    spelbook: test-postgresql
    chapter: databases
    spell: kaster
spec:
  description: PostgreSQL cluster for eso-db

  instances: 1
  managed:
     roles:
      - ensure: present
        login: true
        name: orders
        passwordSecret:
          name: eso-db-app

  enableSuperuserAccess: true
  superuserSecret:
    name: eso-db-superuser
  bootstrap:
    initdb:
      database: orders
      owner: orders
      secret:
        name: eso-db-app
  plugins:
    - name: barman-cloud.cloudnative-pg.io
      isWALArchiver: false
      parameters:
        barmanObjectName: eso-db

  storage:
    size: 1Gi
---
# Source: kaster/templates/kaster.yaml
apiVersion: postgresql.cnpg.io/v1
kind: Cluster
metadata:
  name: minimal-db
  labels:
    app.kubernetes.io/name: test
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: test-postgresql
    app.kubernetes.io/managed-by: Helm
    spelbook: test-postgresql
    chapter: databases
    spell: kaster
spec:
  description: Minimal PostgreSQL cluster
  inheritedMetadata:
    annotations:
      prometheus.io/path: /metrics
      prometheus.io/port: "9187"
      prometheus.io/scrape: "true"

  instances: 1
  managed:
     roles:
      - ensure: present
        login: true
        name: app
        passwordSecret:
          name: minimal-db-app

  enableSuperuserAccess: true
  superuserSecret:
    name: minimal-db-superuser
  bootstrap:
    initdb:
      database: app
      owner: app
      secret:
        name: minimal-db-app

  storage:
    size: 1Gi
---
