          },
          "targets": [
            {
              "datasource": {
                "type": "prometheus",
                "uid": "mimir"
              },
              "expr": "sum by (namespace,pod,cnpg_cluster) (cnpg_backends_total{namespace=\"glyphs-release\",cnpg_cluster=\"minimal-db\"}) / on(namespace,pod,cnpg_cluster) max by (namespace,pod,cnpg_cluster) (cnpg_pg_settings_setting{namespace=\"glyphs-release\",cnpg_cluster=\"minimal-db\",name=\"max_connections\"})",
              "legendFormat": "{{pod}}",
              "refId": "A"
            }
          ],
          "title": "Connection utilization",
