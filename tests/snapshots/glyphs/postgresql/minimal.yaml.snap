---
# Source: kaster/templates/kaster.yaml
apiVersion: v1
kind: ConfigMap
metadata:
  name: minimal-db-alerts
  labels:
    app.kubernetes.io/name: test
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: test-postgresql
    app.kubernetes.io/managed-by: Helm
    spelbook: test-postgresql
    chapter: databases
    spell: kaster
    grafana_alert: "1"
data:
  postgresql-f2fa31f9bfccc2d4.yaml: |
    apiVersion: 1
    deleteRules:
    - orgId: 1
      uid: pf2fa31f9bfcc-streaming
    - orgId: 1
      uid: pf2fa31f9bfcc-replication-lag
    - orgId: 1
      uid: pf2fa31f9bfcc-archive-stalled
    - orgId: 1
      uid: pf2fa31f9bfcc-archive-errors
    groups:
    - folder: PostgreSQL
      interval: 1m
      name: postgresql-f2fa31f9bfccc2d4
      orgId: 1
      rules:
      - annotations:
          __dashboardUid__: pg-f2fa31f9bfccc2d4
          __panelId__: "1"
          summary: No PostgreSQL metrics for five minutes; check discovery, scrape and
            exporter.
        condition: C
        data:
        - datasourceUid: mimir
          model:
            editorMode: code
            expr: absent_over_time(cnpg_collector_up{namespace="glyphs-release",cnpg_cluster="minimal-db"}[5m])
            instant: true
            intervalMs: 60000
            maxDataPoints: 43200
            range: false
            refId: A
          refId: A
          relativeTimeRange:
            from: 900
            to: 0
        - datasourceUid: __expr__
          model:
            expression: A
            reducer: last
            refId: B
            type: reduce
          refId: B
          relativeTimeRange:
            from: 900
            to: 0
        - datasourceUid: __expr__
          model:
            conditions:
            - evaluator:
                params:
                - 0
                type: gt
            expression: B
            refId: C
            type: threshold
          refId: C
          relativeTimeRange:
            from: 900
            to: 0
        execErrState: Alerting
        for: 2m
        isPaused: false
        labels:
          cnpg_cluster: minimal-db
          component: postgresql
          namespace: glyphs-release
          severity: critical
        noDataState: OK
        title: PostgreSQLMetricsMissing / glyphs-release / minimal-db
        uid: pf2fa31f9bfcc-metrics-missing
      - annotations:
          __dashboardUid__: pg-f2fa31f9bfccc2d4
          __panelId__: "1"
          summary: Fewer healthy PostgreSQL instances than configured; inspect replication
            before WAL accumulates.
        condition: C
        data:
        - datasourceUid: mimir
          model:
            editorMode: code
            expr: clamp_min(1 - (sum(cnpg_collector_up{namespace="glyphs-release",cnpg_cluster="minimal-db"})
              or vector(0)), 0)
            instant: true
            intervalMs: 60000
            maxDataPoints: 43200
            range: false
            refId: A
          refId: A
          relativeTimeRange:
            from: 900
            to: 0
        - datasourceUid: __expr__
          model:
            expression: A
            reducer: last
            refId: B
            type: reduce
          refId: B
          relativeTimeRange:
            from: 900
            to: 0
        - datasourceUid: __expr__
          model:
            conditions:
            - evaluator:
                params:
                - 0
                type: gt
            expression: B
            refId: C
            type: threshold
          refId: C
          relativeTimeRange:
            from: 900
            to: 0
        execErrState: Alerting
        for: 5m
        isPaused: false
        labels:
          cnpg_cluster: minimal-db
          component: postgresql
          namespace: glyphs-release
          severity: warning
        noDataState: OK
        title: PostgreSQLInstancesUnavailable / glyphs-release / minimal-db
        uid: pf2fa31f9bfcc-instances-missing
      - annotations:
          __dashboardUid__: pg-f2fa31f9bfccc2d4
          __panelId__: "1"
          summary: No healthy PostgreSQL primary is being monitored.
        condition: C
        data:
        - datasourceUid: mimir
          model:
            editorMode: code
            expr: clamp_min(1 - (sum(cnpg_collector_up{namespace="glyphs-release",cnpg_cluster="minimal-db",role="primary"})
              or vector(0)), 0)
            instant: true
            intervalMs: 60000
            maxDataPoints: 43200
            range: false
            refId: A
          refId: A
          relativeTimeRange:
            from: 900
            to: 0
        - datasourceUid: __expr__
          model:
            expression: A
            reducer: last
            refId: B
            type: reduce
          refId: B
          relativeTimeRange:
            from: 900
            to: 0
        - datasourceUid: __expr__
          model:
            conditions:
            - evaluator:
                params:
                - 0
                type: gt
            expression: B
            refId: C
            type: threshold
          refId: C
          relativeTimeRange:
            from: 900
            to: 0
        execErrState: Alerting
        for: 2m
        isPaused: false
        labels:
          cnpg_cluster: minimal-db
          component: postgresql
          namespace: glyphs-release
          severity: critical
        noDataState: OK
        title: PostgreSQLPrimaryUnavailable / glyphs-release / minimal-db
        uid: pf2fa31f9bfcc-primary-down
      - annotations:
          __dashboardUid__: pg-f2fa31f9bfccc2d4
          __panelId__: "3"
          summary: A replication slot is retaining a significant fraction of its WAL filesystem.
            Check the replica and remaining disk space.
        condition: C
        data:
        - datasourceUid: mimir
          model:
            editorMode: code
            expr: cnpg_pg_replication_slots_pg_wal_lsn_diff{namespace="glyphs-release",cnpg_cluster="minimal-db",role="primary"}
              / on(namespace,pod) group_left() (max by(namespace,pod) (label_replace(kubelet_volume_stats_capacity_bytes{namespace="glyphs-release",persistentvolumeclaim=~"(minimal-db-[0-9]+)-wal"},
              "pod", "$1", "persistentvolumeclaim", "(minimal-db-[0-9]+)-wal")) or on(namespace,pod)
              max by(namespace,pod) (label_replace(kubelet_volume_stats_capacity_bytes{namespace="glyphs-release",persistentvolumeclaim=~"(minimal-db-[0-9]+)"},
              "pod", "$1", "persistentvolumeclaim", "(minimal-db-[0-9]+)")))
            instant: true
            intervalMs: 60000
            maxDataPoints: 43200
            range: false
            refId: A
          refId: A
          relativeTimeRange:
            from: 900
            to: 0
        - datasourceUid: __expr__
          model:
            expression: A
            reducer: last
            refId: B
            type: reduce
          refId: B
          relativeTimeRange:
            from: 900
            to: 0
        - datasourceUid: __expr__
          model:
            conditions:
            - evaluator:
                params:
                - 0.1
                type: gt
            expression: B
            refId: C
            type: threshold
          refId: C
          relativeTimeRange:
            from: 900
            to: 0
        execErrState: Alerting
        for: 5m
        isPaused: false
        labels:
          cnpg_cluster: minimal-db
          component: postgresql
          namespace: glyphs-release
          severity: warning
        noDataState: OK
        title: PostgreSQLSlotRetainedWALHigh / glyphs-release / minimal-db
        uid: pf2fa31f9bfcc-slot-warning
      - annotations:
          __dashboardUid__: pg-f2fa31f9bfccc2d4
          __panelId__: "3"
          summary: Replication slot WAL retention threatens primary and standby storage;
            repair or rebuild the lagging replica.
        condition: C
        data:
        - datasourceUid: mimir
          model:
            editorMode: code
            expr: cnpg_pg_replication_slots_pg_wal_lsn_diff{namespace="glyphs-release",cnpg_cluster="minimal-db",role="primary"}
              / on(namespace,pod) group_left() (max by(namespace,pod) (label_replace(kubelet_volume_stats_capacity_bytes{namespace="glyphs-release",persistentvolumeclaim=~"(minimal-db-[0-9]+)-wal"},
              "pod", "$1", "persistentvolumeclaim", "(minimal-db-[0-9]+)-wal")) or on(namespace,pod)
              max by(namespace,pod) (label_replace(kubelet_volume_stats_capacity_bytes{namespace="glyphs-release",persistentvolumeclaim=~"(minimal-db-[0-9]+)"},
