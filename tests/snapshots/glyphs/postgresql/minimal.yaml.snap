spec:
  configuration:
    destinationPath: "s3://example-backups/orders"
    endpointURL: "https://s3.example.invalid"
    s3Credentials:
      accessKeyId:
        name: external-backup-credentials
        key: AWS_ACCESS_KEY_ID
      secretAccessKey:
        name: external-backup-credentials
        key: AWS_SECRET_ACCESS_KEY
    wal:
      compression: gzip
    data:
      compression: gzip
  retentionPolicy: "90d"
