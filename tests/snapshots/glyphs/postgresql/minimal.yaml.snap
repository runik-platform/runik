apiVersion: postgresql.cnpg.io/v1
kind: Cluster
metadata:
  name: minimal-db
  labels:
    app.kubernetes.io/name: test
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: test-postgresql
    app.kubernetes.io/managed-by: Helm
    spelbook: test-postgresql
    chapter: databases
    spell: kaster
spec:
  description: Minimal PostgreSQL cluster

  instances: 1

  enableSuperuserAccess: true

  storage:
    size: 1Gi
