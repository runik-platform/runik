data:
  postgresql-f2fa31f9bfccc2d4.json: |
    {
      "description": "Standard CNPG and kubelet metrics. Missing volume data is reported by PostgreSQLVolumeMetricsMissing; it is not treated as free disk space.",
      "editable": false,
      "panels": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "fieldConfig": {
            "defaults": {
              "unit": "short"
            },
            "overrides": []
          },
          "gridPos": {
            "h": 8,
            "w": 12,
            "x": 0,
            "y": 0
          },
          "id": 1,
          "options": {
            "legend": {
              "displayMode": "list",
              "placement": "bottom"
            }
          },
          "targets": [
            {
              "datasource": {
                "type": "prometheus",
                "uid": "mimir"
              },
              "expr": "sum(cnpg_collector_up{namespace=\"glyphs-release\",cnpg_cluster=\"minimal-db\"})",
              "legendFormat": "",
              "refId": "A"
            }
          ],
          "title": "PostgreSQL instances up",
          "type": "stat"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "fieldConfig": {
            "defaults": {
              "unit": "short"
            },
            "overrides": []
          },
          "gridPos": {
            "h": 8,
            "w": 12,
            "x": 12,
            "y": 0
          },
          "id": 2,
          "options": {
            "legend": {
              "displayMode": "list",
              "placement": "bottom"
            }
          },
          "targets": [
            {
              "datasource": {
                "type": "prometheus",
                "uid": "mimir"
              },
              "expr": "max(cnpg_pg_replication_streaming_replicas{namespace=\"glyphs-release\",cnpg_cluster=\"minimal-db\",role=\"primary\"})",
              "legendFormat": "",
              "refId": "A"
            }
          ],
          "title": "Streaming replicas",
          "type": "stat"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "fieldConfig": {
            "defaults": {
              "unit": "bytes"
            },
            "overrides": []
          },
          "gridPos": {
            "h": 8,
            "w": 12,
            "x": 0,
            "y": 8
          },
          "id": 3,
          "options": {
            "legend": {
              "displayMode": "list",
              "placement": "bottom"
            }
          },
          "targets": [
            {
              "datasource": {
                "type": "prometheus",
                "uid": "mimir"
              },
              "expr": "cnpg_pg_replication_slots_pg_wal_lsn_diff{namespace=\"glyphs-release\",cnpg_cluster=\"minimal-db\",role=\"primary\"}",
              "legendFormat": "{{pod}} / {{slot_name}}",
              "refId": "A"
            }
          ],
          "title": "WAL retained by replication slots",
          "type": "timeseries"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "fieldConfig": {
            "defaults": {
              "unit": "bytes"
            },
            "overrides": []
          },
          "gridPos": {
            "h": 8,
            "w": 12,
            "x": 12,
            "y": 8
          },
          "id": 4,
          "options": {
            "legend": {
              "displayMode": "list",
              "placement": "bottom"
            }
          },
          "targets": [
            {
              "datasource": {
                "type": "prometheus",
                "uid": "mimir"
              },
              "expr": "cnpg_collector_pg_wal{namespace=\"glyphs-release\",cnpg_cluster=\"minimal-db\",value=\"size\"}",
              "legendFormat": "{{pod}}",
              "refId": "A"
            }
          ],
          "title": "WAL directory size",
          "type": "timeseries"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "fieldConfig": {
            "defaults": {
              "unit": "bytes"
            },
            "overrides": []
          },
          "gridPos": {
            "h": 8,
            "w": 12,
            "x": 0,
            "y": 16
          },
          "id": 5,
          "options": {
            "legend": {
              "displayMode": "list",
              "placement": "bottom"
            }
          },
          "targets": [
            {
              "datasource": {
                "type": "prometheus",
                "uid": "mimir"
              },
              "expr": "cnpg_pg_settings_setting{namespace=\"glyphs-release\",cnpg_cluster=\"minimal-db\",role=\"primary\",name=\"max_slot_wal_keep_size\"} * 1048576",
              "legendFormat": "",
              "refId": "A"
            }
          ],
          "title": "Slot WAL limit (negative = unlimited)",
          "type": "stat"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "fieldConfig": {
            "defaults": {
              "unit": "s"
            },
            "overrides": []
          },
          "gridPos": {
            "h": 8,
