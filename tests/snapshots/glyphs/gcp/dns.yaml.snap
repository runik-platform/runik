# Source: kaster/templates/kaster.yaml
apiVersion: dns.cnrm.cloud.google.com/v1beta1
kind: DNSRecordSet
metadata:
  name: pepe-com
  labels:
    app.kubernetes.io/name: test
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: default
    app.kubernetes.io/managed-by: Helm
    spelbook: default
    chapter: default
    spell: kaster
spec:
  name: www.epe.com.
  type: cname
  ttl: 8321
  managedZoneRef:
    name: pepe.com
  rrdatas:
    - pepe.com
  rrdatasRefs:
    - name: la-ip
      kind: ComputeAddress
      namespace: optional
