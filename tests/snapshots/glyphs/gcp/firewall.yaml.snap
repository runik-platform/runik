# Source: kaster/templates/kaster.yaml
apiVersion: compute.cnrm.cloud.google.com/v1beta1
kind: ComputeFirewall
metadata:
  name: allow-ssh
  labels:
    app.kubernetes.io/name: test
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: default
    app.kubernetes.io/managed-by: Helm
    spelbook: default
    chapter: default
    spell: kaster
spec:
  direction: INGRESS
  priority: 10
  description: allow-ssh
  allow:
  - ports:
    - "22"
    - "42022"
    protocol: tcp
  networkRef:
    name: jorge
  sourceTags:
    - allow-ssh
  sourceRanges:
    - 0.0.0.0/0
