apiVersion: idp.supervisor.pinniped.dev/v1alpha1
kind: GitHubIdentityProvider
metadata:
  name: github
  namespace: pinniped-supervisor
spec:

  allowAuthentication:
    organizations:
      allowed:
      - example-org
      policy: OnlyUsersFromAllowedOrganizations
  claims:
    groups: slug
    username: login:id
  client:
    secretName: github-oauth-client
