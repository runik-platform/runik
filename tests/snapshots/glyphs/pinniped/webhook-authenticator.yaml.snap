apiVersion: authentication.concierge.pinniped.dev/v1alpha1
kind: WebhookAuthenticator
metadata:
  name: webhook
spec:

  endpoint: https://authn-webhook.example.com/authenticate
  tls:
    certificateAuthorityDataSource:
      key: ca.crt
      kind: ConfigMap
      name: webhook-ca
