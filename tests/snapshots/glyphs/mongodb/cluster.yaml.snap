apiVersion: redhatcop.redhat.io/v1alpha1
kind: RandomSecret
metadata:
  name: s3-identities-seaweedfs-mongo-main-backup-aws-access-key-id
  namespace: databases
  labels:
    app.kubernetes.io/name: test
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: platform
    app.kubernetes.io/managed-by: Helm
    spelbook: platform
    chapter: databases
    spell: kaster
    runik.ing/identity-name: platform-databases-mongo-main-backup
    runik.ing/s3-identity: "true"
    runik.ing/s3-provider: seaweedfs
spec:
  authentication:
    path: platform
    role: mongo-main-mongodb-system
    serviceAccount:
      name: mongo-main
  connection:
    address: https://vault.vault.svc:8200
    tLSConfig:
      skipVerify: false
  isKVSecretsEngineV2: true
  path: kv/data/platform/databases/databases/publics/
  secretKey: AWS_ACCESS_KEY_ID
  secretFormat:
    passwordPolicyName: short-policy
