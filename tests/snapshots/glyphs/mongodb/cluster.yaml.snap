# Source: kaster/templates/kaster.yaml
apiVersion: redhatcop.redhat.io/v1alpha1
kind: VaultSecret
metadata:
  name: s3-identities-seaweedfs-mongo-main-backup
  namespace: databases
  labels:
    app.kubernetes.io/name: test
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: platform
    app.kubernetes.io/managed-by: Helm
    spelbook: platform
    chapter: databases
    spell: kaster
    runik.ing/identity-name: platform-databases-mongo-main-backup
    runik.ing/s3-identity: "true"
    runik.ing/s3-provider: seaweedfs
spec:
  refreshThreshold: 90
  refreshPeriod: 3m0s
  vaultSecretDefinitions:
    - name: aws-access-key-id
      requestType: GET
      path: kv/data/platform/databases/databases/publics/s3-identities-seaweedfs-mongo-main-backup-aws-access-key-id
      authentication:
        path: platform
        role: mongo-main-mongodb-system
        serviceAccount:
          name: mongo-main
      connection:
        address: https://vault.vault.svc:8200
        tLSConfig:
          skipVerify: false
    - name: aws-secret-access-key
      requestType: GET
      path: kv/data/platform/databases/databases/publics/s3-identities-seaweedfs-mongo-main-backup-aws-secret-access-key
      authentication:
        path: platform
        role: mongo-main-mongodb-system
        serviceAccount:
          name: mongo-main
      connection:
        address: https://vault.vault.svc:8200
        tLSConfig:
          skipVerify: false
  output:
    name: mongo-main-backup
    labels:
      app.kubernetes.io/name: test
      app.kubernetes.io/instance: test
      app.kubernetes.io/part-of: platform
      app.kubernetes.io/managed-by: Helm
      spelbook: platform
      chapter: databases
      spell: kaster
      runik.ing/identity-name: platform-databases-mongo-main-backup
      runik.ing/s3-identity: "true"
      runik.ing/s3-provider: seaweedfs
    stringData: #tiene q haber una forma de hacer q esto funcione con un range del lado del operator para q no hagan falta las keys
        AWS_ENDPOINT: https://s3.example.test
        AWS_ENDPOINTS: https://s3.example.test
        AWS_REGION: us-east-1
        S3_BUCKET: platform-databases-mongo-main-backup
        AWS_ACCESS_KEY_ID: '{{ index . "aws-access-key-id" "AWS_ACCESS_KEY_ID" }}'
        AWS_SECRET_ACCESS_KEY: '{{ index . "aws-secret-access-key" "AWS_SECRET_ACCESS_KEY" }}'
    type: Opaque
---
