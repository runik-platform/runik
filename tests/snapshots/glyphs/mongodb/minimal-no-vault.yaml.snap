# Source: kaster/templates/kaster.yaml
apiVersion: psmdb.percona.com/v1
kind: PerconaServerMongoDB
metadata:
  name: mongo-dev
  namespace: databases
  labels:
    app.kubernetes.io/name: test
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: development
    app.kubernetes.io/managed-by: Helm
    spelbook: development
    chapter: databases
    spell: kaster
  finalizers:
    - percona.com/delete-psmdb-pods-in-order
spec:
  backup:
    enabled: false
    image: percona/percona-backup-mongodb:2.15.0
  crVersion: 1.23.0
  image: percona/percona-server-mongodb:8.0.26-11
  pmm:
    enabled: false
    image: percona/pmm-client:3.8.1
    serverHost: monitoring-service
  replsets:
  - affinity:
      antiAffinityTopologyKey: kubernetes.io/hostname
    name: rs0
    podDisruptionBudget:
      maxUnavailable: 1
    resources:
      limits:
        cpu: "2"
        memory: 4Gi
      requests:
        cpu: 300m
        memory: 1Gi
    size: 1
    volumeSpec:
      persistentVolumeClaim:
        resources:
          requests:
            storage: 10Gi
  sharding:
    enabled: false
  tls:
    allowInvalidCertificates: true
    certManagementPolicy: auto
    mode: requireTLS
  unsafeFlags:
    replsetSize: true
  updateStrategy: SmartUpdate
  upgradeOptions:
    apply: disabled
    schedule: 0 2 * * *
    setFCV: false
    versionServiceEndpoint: https://check.percona.com
