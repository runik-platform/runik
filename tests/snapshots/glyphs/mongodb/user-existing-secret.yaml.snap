# Source: kaster/templates/kaster.yaml
apiVersion: mongodb.example.io/v1alpha1
kind: MongoDBDatabase
metadata:
  name: reporting
  namespace: glyphs-release
  labels:
    app.kubernetes.io/name: reporting
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: platform
    app.kubernetes.io/managed-by: Helm
    spelbook: platform
    chapter: applications
    spell: reporting
spec:
  engineRef:
    name: mongo-main
  databaseName: "reporting"
  deletionPolicy: Retain
---
# Source: kaster/templates/kaster.yaml
apiVersion: mongodb.example.io/v1alpha1
kind: MongoDBUser
metadata:
  name: reporting-reader
  namespace: glyphs-release
  labels:
    app.kubernetes.io/name: reporting
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: platform
    app.kubernetes.io/managed-by: Helm
    spelbook: platform
    chapter: applications
    spell: reporting
spec:
  databaseRef:
    name: reporting
  credentialsSecretRef:
    name: reporting-reader-mongodb
    usernameKey: username
    passwordKey: password
  access: readOnly
  credentialsRevision: "1"
  deletionPolicy: Delete
