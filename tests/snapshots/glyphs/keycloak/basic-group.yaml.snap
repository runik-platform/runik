apiVersion: v1.edp.epam.com/v1
kind: KeycloakRealmGroup
metadata:
  name: test-group-engineering
  labels:
    app.kubernetes.io/name: keycloak-basic-group
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: default
    app.kubernetes.io/managed-by: Helm
spec:
  realmRef:
    name: test-realm
    kind: ClusterKeycloakRealm
  name: engineering
  realmRoles:
    - developer
    - user
  clientRoles:
    - clientId: vault
      roles:
        - admin
        - editor
