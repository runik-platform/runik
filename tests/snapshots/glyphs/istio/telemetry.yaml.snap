# Source: kaster/templates/kaster.yaml
apiVersion: telemetry.istio.io/v1
kind: Telemetry
metadata:
  name: "application"
  namespace: "apps"
  labels:
    app.kubernetes.io/name: test
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: example
    app.kubernetes.io/managed-by: Helm
spec:
  metrics:
  - overrides:
    - match:
        metric: REQUEST_COUNT
      tagOverrides:
        response_code:
          operation: REMOVE
    providers:
    - name: prometheus
  selector:
    matchLabels:
      app: backend
  tracing:
  - providers:
    - name: otel
    randomSamplingPercentage: 25
---
# Source: kaster/templates/kaster.yaml
apiVersion: telemetry.istio.io/v1
kind: Telemetry
metadata:
  name: "default-gateway"
  namespace: "internal-ingress"
  labels:
    app.kubernetes.io/name: test
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: example
    app.kubernetes.io/managed-by: Helm
spec:
  selector:
    matchLabels:
      istio: internal
  tracing:
  - providers:
    - name: otel
    randomSamplingPercentage: 10
