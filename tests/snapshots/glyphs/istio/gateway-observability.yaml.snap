#
---
# Source: kaster/templates/kaster.yaml
apiVersion: telemetry.istio.io/v1
kind: Telemetry
metadata:
  name: "private-observability"
  namespace: "private-ingress"
  labels:
    app.kubernetes.io/name: test
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: example
    app.kubernetes.io/managed-by: Helm
spec:
  accessLogging:
  - filter:
      expression: response.code >= 500
    providers:
    - name: custom-json
  selector:
    matchLabels:
      istio: private
  tracing:
  - providers:
    - name: tracing
    randomSamplingPercentage: 100
---
# Source: kaster/templates/kaster.yaml
apiVersion: telemetry.istio.io/v1
kind: Telemetry
metadata:
  name: "public-observability"
  namespace: "public-ingress"
  labels:
    app.kubernetes.io/name: test
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: example
    app.kubernetes.io/managed-by: Helm
spec:
  accessLogging:
  - filter:
      expression: '!has(response.code) || response.code == 0 || response.code >= 400'
    providers:
    - name: gateway-errors-json
  selector:
    matchLabels:
      istio: public
---
# Source: kaster/templates/kaster.yaml
apiVersion: telemetry.istio.io/v1
kind: Telemetry
metadata:
  name: "telemetry-only"
  namespace: "custom-ingress"
  labels:
    app.kubernetes.io/name: test
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: example
    app.kubernetes.io/managed-by: Helm
spec:
  accessLogging:
  - filter:
      expression: '!has(response.code) || response.code == 0 || response.code >= 400'
    providers:
    - name: gateway-errors-json
  selector:
    matchLabels:
      istio: no-dashboard
