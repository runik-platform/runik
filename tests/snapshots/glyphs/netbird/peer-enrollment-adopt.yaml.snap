# Source: kaster/templates/kaster.yaml
apiVersion: netbird.io/v1alpha1
kind: NetBirdPeerEnrollment
metadata:
  name: prorator
  namespace: netbird
  labels:
    app.kubernetes.io/name: test
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: netbird
    app.kubernetes.io/managed-by: Helm
    spelbook: netbird
    chapter: networking
    spell: kaster
spec:
  mode: "adopt"
  peerIdentity:
    id: "replace-with-stable-netbird-peer-id"
    hostname: "prorator"
  settings:
    inactivityExpirationEnabled: false
    loginExpirationEnabled: false
    name: prorator
  groupRefs:
    - "routers-tyl-fwck"
  ownership:
    takeOwnership: false
  deletionPolicy: "Retain"
  restoreSettingsOnDelete: true
