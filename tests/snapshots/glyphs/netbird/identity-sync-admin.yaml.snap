# Source: kaster/templates/kaster.yaml
apiVersion: netbird.io/v1alpha1
kind: NetBirdIdentitySync
metadata:
  name: keycloak-members
  namespace: netbird
  labels:
    app.kubernetes.io/name: test
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: netbird
    app.kubernetes.io/managed-by: Helm
    spelbook: netbird
    chapter: networking
    spell: kaster
spec:
  source: "keycloak-tyl"
  instanceId: "netbird/default"
  provider:
    baseUrl: "https://sso.example.com"
    realm: "tyl"
    clientId: "netbird-identity-sync"
    credentialsSecretRef:
      name: "netbird-keycloak-client"
      key: "client-secret"
  realmRoles:
    - "fwck-users"
    - "flaners"
    - "tyl-devs"
    - "tyl-operations-staff"
  adoptExistingUsers: true
  adoptExistingJWTGroups: true
  pollIntervalSeconds: 30
  deletionPolicy: "Disable"
---
# Source: kaster/templates/kaster.yaml
apiVersion: netbird.io/v1alpha1
kind: NetBirdRoleBinding
metadata:
  name: operations-admin
  namespace: netbird
  labels:
    app.kubernetes.io/name: test
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: netbird
    app.kubernetes.io/managed-by: Helm
    spelbook: netbird
    chapter: networking
    spell: kaster
spec:
  groupRef:
    name: "tyl-operations-staff"
  role: "admin"
  includeServiceUsers: false
