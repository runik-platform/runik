apiVersion: netbird.io/v1alpha1
kind: Group
metadata:
  name: dev-team
  labels:
    app.kubernetes.io/name: test
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: my-app
    app.kubernetes.io/managed-by: Helm
    spelbook: my-app
    chapter: production
    spell: kaster
spec:
  name: "dev-team"
---
# Source: kaster/templates/kaster.yaml
apiVersion: netbird.io/v1alpha1
kind: NetBirdNameserverGroup
metadata:
  name: corp-dns
  labels:
    app.kubernetes.io/name: test
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: my-app
    app.kubernetes.io/managed-by: Helm
    spelbook: my-app
    chapter: production
    spell: kaster
spec:
  name: "corp-dns"
  description: "Corporate DNS for dev-team peers"
  nameservers:
    - ip: "10.0.0.53"
      nsType: "udp"
      port: 53
    - ip: "10.0.0.54"
      nsType: "udp"
      port: 53
  domains:
    - "corp.example.com"
  enabled: true
  primary: true
  searchDomainsEnabled: true
  groupRefs:
    - "dev-team"
