# Source: kaster/templates/kaster.yaml
apiVersion: netbird.io/v1alpha1
kind: NetBirdPolicy
metadata:
  name: fwhq-access
  namespace: netbird
  labels:
    app.kubernetes.io/name: test
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: example-networking
    app.kubernetes.io/managed-by: Helm
    spelbook: example-networking
    chapter: production
    spell: kaster
spec:
  name: "fwhq-access"
  state: "present"
  description: "Allow selected groups to reach fwhq resources"
  enabled: true
  sourceGroupRefs:
    - "operations"
  destinationGroupRefs:
    - "fwhq-resources"
  sourcePostureCheckRefs:
    - "managed-device"
  rules:
    - action: accept
      bidirectional: false
      enabled: true
      name: office
      protocol: all
