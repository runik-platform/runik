---
# Source: kaster/templates/kaster.yaml
apiVersion: netbird.io/v1alpha1
kind: NetBirdNetworkRouter
metadata:
  name: fwhq-router
  namespace: netbird
  labels:
    app.kubernetes.io/name: test
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: example-networking
    app.kubernetes.io/managed-by: Helm
    spelbook: example-networking
    chapter: production
    spell: kaster
spec:
  networkRef:
    name: "fwhq"
  peerGroupRefs:
    - "fwhq-routers"
    - "shared-edge-routers"
  enabled: true
  masquerade: true
  metric: 200
---
