# Source: kaster/templates/kaster.yaml
apiVersion: netbird.io/v1alpha1
kind: NetBirdPostureCheck
metadata:
  name: minimum-version
  labels:
    app.kubernetes.io/name: test
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: my-app
    app.kubernetes.io/managed-by: Helm
    spelbook: my-app
    chapter: production
    spell: kaster
spec:
  name: "minimum-version"
  description: "Require recent NetBird client and deny non-EU locations"
  checks:
    geoLocationCheck:
      action: deny
      locations:
      - countryCode: RU
      - countryCode: CN
    nbVersionCheck:
      minVersion: 0.30.0
