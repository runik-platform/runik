# Source: kaster/templates/kaster.yaml
apiVersion: netbird.io/v1alpha1
kind: NetBirdPolicy
metadata:
  name: fwck-users-lan-access
  namespace: netbird
  labels:
    app.kubernetes.io/name: test
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: example-networking
    app.kubernetes.io/managed-by: Helm
    spelbook: example-networking
    chapter: production
    spell: kaster
spec:
  name: "fwck-users-lan-access"
  state: "present"
  description: "Allow selected groups to reach fwck resources"
  enabled: true
  sourceGroupRefs:
    - "fwck-users"
  destinationGroupRefs:
    - "resources-tyl-fwck-lan"
  rules:
    - action: accept
      bidirectional: false
      enabled: true
      name: lan
      protocol: all
---
# Source: kaster/templates/kaster.yaml
apiVersion: netbird.io/v1alpha1
kind: NetBirdPolicy
metadata:
  name: fwck-users-prorator-access
  namespace: netbird
  labels:
    app.kubernetes.io/name: test
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: example-networking
    app.kubernetes.io/managed-by: Helm
    spelbook: example-networking
    chapter: production
    spell: kaster
spec:
  name: "fwck-users-prorator-access"
  state: "present"
  description: "Allow selected groups to reach routers for fwck"
  enabled: true
  sourceGroupRefs:
    - "fwck-users"
  destinationGroupRefs:
    - "routers-tyl-fwck"
  rules:
    - action: accept
      bidirectional: false
      enabled: true
      name: dns-udp
      ports:
      - 53
      protocol: udp
    - action: accept
      bidirectional: false
      enabled: true
      name: dns-tcp
      ports:
      - 53
      protocol: tcp
