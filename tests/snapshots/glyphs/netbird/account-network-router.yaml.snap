apiVersion: netbird.io/v1alpha1
kind: NetBirdNetworkRouter
metadata:
  name: edge-router-pool
  labels:
    app.kubernetes.io/name: test
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: example-networking
    app.kubernetes.io/managed-by: Helm
    spelbook: example-networking
    chapter: production
    spell: kaster
spec:
  networkRef:
    name: "edge-services"
  peerGroupRefs:
    - "edge-routers"
  enabled: true
  masquerade: true
  metric: 100
