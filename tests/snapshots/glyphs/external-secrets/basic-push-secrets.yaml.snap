# Source: kaster/templates/kaster.yaml
apiVersion: external-secrets.io/v1
kind: ClusterSecretStore
metadata:
  name: vault-store
spec:
  provider:
    vault:
      version: v2
      server: http://vault.vault.svc:8200
      path: kv
      auth:
        kubernetes:
          mountPath: k8s-path-auth
          role: externalsecrets-basic-test
---
# Source: kaster/templates/kaster.yaml
apiVersion: generators.external-secrets.io/v1alpha1
kind: Password 
metadata:
  name: app-config
spec:  
  length: 32
  digits: 5
  symbols: 5
  symbolCharacters: -_@
  allowRepeat: true
---
# Source: kaster/templates/kaster.yaml
