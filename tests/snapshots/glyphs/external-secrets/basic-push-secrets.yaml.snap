# Source: kaster/templates/kaster.yaml
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: rooted-explicit-key

spec:
  secretStoreRef:
    name: rooted-aws-store
    kind: ClusterSecretStore
  refreshPolicy: Periodic
  refreshInterval: 30m
  target:
    name: rooted-explicit-key
    creationPolicy: Orphan
    deletionPolicy: Merge
  data:
    - secretKey: token
      remoteRef:
        key: shared/token
        property: token
