apiVersion: external-secrets.io/v1alpha1
kind: PushSecret
metadata:
  name: existing-pg-credentials
spec:
  refreshInterval: 60m0s
  updatePolicy: Replace
  deletionPolicy: None
  secretStoreRefs:
    - name: aws-store          
      kind: ClusterSecretStore
  selector:
    secret:
      name: pg-app
  
  data:
    - match:
        remoteRef:
          remoteKey: example/postgresql/app
