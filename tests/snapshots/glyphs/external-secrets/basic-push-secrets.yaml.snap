# Source: kaster/templates/kaster.yaml
apiVersion: external-secrets.io/v1alpha1
kind: PushSecret
metadata:
  name: app-config
spec:
  refreshInterval: 60m0s
  secretStoreRefs:
    - name: vault-store          
      kind: ClusterSecretStore
  selector:
    generatorRef:
      apiVersion: generators.external-secrets.io/v1alpha1
      kind: Password
      name: app-config
  
  data: 
    - match:
        secretKey: password
        remoteRef:
          remoteKey: kv/data/default/default/glyphs-release/publics/app-config
---
