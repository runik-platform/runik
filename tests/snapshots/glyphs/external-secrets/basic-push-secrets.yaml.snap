# Source: kaster/templates/kaster.yaml
apiVersion: external-secrets.io/v1
kind: ClusterSecretStore
metadata:
  name: vault-store
spec:
  provider:
    vault:
      version: v2
      server: http://vault.vault.svc:8200
      path: kv
      auth:
        kubernetes:
          mountPath: k8s-path-auth
          role: externalsecrets-basic-test
---
# Source: kaster/templates/kaster.yaml
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: rooted-vault-credentials

spec:
  secretStoreRef:
    name: rooted-vault-store
    kind: ClusterSecretStore
  refreshPolicy: Periodic
  refreshInterval: 30m
  target:
    name: rooted-vault-credentials
    creationPolicy: Orphan
    deletionPolicy: Merge
  dataFrom:
    - extract:
        conversionStrategy: Default
        decodingStrategy: None
        metadataPolicy: None
        key: kv/data/acme/prod/default/glyphs-release/publics/rooted-vault-credentials
---
# Source: kaster/templates/kaster.yaml
