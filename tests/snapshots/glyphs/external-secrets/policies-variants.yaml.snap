# Source: kaster/templates/kaster.yaml
apiVersion: external-secrets.io/v1
kind: ClusterSecretStore
metadata:
  name: vault-store
spec:
  provider:
    vault:
      version: v2
      server: http://vault.vault.svc:8200
      path: kv
      auth:
        kubernetes:
          mountPath: k8s-path-auth
          role: externalsecrets-policies-variants
---
# Source: kaster/templates/kaster.yaml
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: frequent-refresh

spec:
  secretStoreRef:
    name: vault-store
    kind: ClusterSecretStore
  refreshPolicy: Periodic
  refreshInterval: 5m
  target:
    name: frequent-refresh
    creationPolicy: Owner
    deletionPolicy: Retain
  dataFrom:
    - extract:
        conversionStrategy: Default
        decodingStrategy: None
        metadataPolicy: None
        key: kv/data/default/default/publics/frequent-refresh
---
# Source: kaster/templates/kaster.yaml
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: manual-refresh

spec:
  secretStoreRef:
    name: vault-store
    kind: ClusterSecretStore
  refreshPolicy: Manual
  refreshInterval: 30m
  target:
    name: manual-refresh
    creationPolicy: Orphan
    deletionPolicy: Merge
  dataFrom:
    - extract:
        conversionStrategy: Default
        decodingStrategy: None
        metadataPolicy: None
        key: kv/data/default/default/publics/manual-refresh
---
# Source: kaster/templates/kaster.yaml
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: dockerconfig-secret

spec:
  secretStoreRef:
    name: vault-store
    kind: ClusterSecretStore
  refreshPolicy: Periodic
  refreshInterval: 30m
  target:
    name: dockerconfig-secret
    creationPolicy: Orphan
    deletionPolicy: Merge
    template:
      type: kubernetes.io/dockerconfigjson
      data:
        .dockerconfigjson: |
          {
            "auths": {
              "registry.example.com": {
                "username": "{{ .username }}",
                "password": "{{ .password }}",
                "auth": "{{ printf "%s:%s" .username .password | b64enc }}"
              }
            }
          }
  data:
    - secretKey: username
      remoteRef:
        key: kv/data/default/default/publics/dockerconfig-secret
        property: username
    - secretKey: password
      remoteRef:
        key: kv/data/default/default/publics/dockerconfig-secret
        property: password
---
# Source: kaster/templates/kaster.yaml
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: labeled-secret

spec:
  secretStoreRef:
    name: vault-store
    kind: ClusterSecretStore
  refreshPolicy: Periodic
  refreshInterval: 30m
  target:
    name: labeled-secret
    creationPolicy: Orphan
    deletionPolicy: Merge
    template:
      metadata:
        labels:
          app: my-app
          environment: production
          tier: backend
        annotations:
          managed-by: external-secrets
          vault-path: kv/data/production
      data:
        config.yaml: |
          app:
            name: {{ .app_name }}
            version: {{ .version }}
  data:
    - secretKey: app_name
      remoteRef:
        key: kv/data/default/default/publics/labeled-secret
        property: app_name
    - secretKey: version
      remoteRef:
        key: kv/data/default/default/publics/labeled-secret
        property: version
---
# Source: kaster/templates/kaster.yaml
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: static-config

spec:
  secretStoreRef:
    name: vault-store
    kind: ClusterSecretStore
  refreshPolicy: Periodic
  refreshInterval: 24h
  target:
    name: static-config
    creationPolicy: Owner
    deletionPolicy: Delete
  dataFrom:
    - extract:
        conversionStrategy: Default
        decodingStrategy: None
        metadataPolicy: None
        key: kv/data/default/publics/static-config
