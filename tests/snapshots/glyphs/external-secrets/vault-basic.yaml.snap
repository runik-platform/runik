---
# Source: kaster/templates/kaster.yaml
apiVersion: external-secrets.io/v1
kind: ClusterSecretStore
metadata:
  name: vault-production-store
spec:
  provider:
    vault:
      version: v2
      server: http://vault.vault.svc:8200
      path: kv
      auth:
        kubernetes:
          mountPath: k8s-path-auth
          role: externalsecrets-vault-basic
---
# Source: kaster/templates/kaster.yaml
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: app-config

spec:
  secretStoreRef:
    name: vault-production-store
    kind: ClusterSecretStore
  refreshPolicy: Periodic
  refreshInterval: 30m
  target:
    name: app-config
    creationPolicy: Orphan
    deletionPolicy: Merge
  dataFrom:
    - extract:
        conversionStrategy: Default
        decodingStrategy: None
        metadataPolicy: None
        key: kv/data/default/default/glyphs-release/publics/app-config
---
# Source: kaster/templates/kaster.yaml
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: db-credentials

spec:
  secretStoreRef:
    name: vault-production-store
    kind: ClusterSecretStore
  refreshPolicy: Periodic
  refreshInterval: 30m
  target:
    name: db-credentials
    creationPolicy: Orphan
    deletionPolicy: Merge
  dataFrom:
    - extract:
        conversionStrategy: Default
        decodingStrategy: None
        metadataPolicy: None
        key: kv/data/default/default/publics/db-credentials
