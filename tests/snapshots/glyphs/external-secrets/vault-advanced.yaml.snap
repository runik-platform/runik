---
# Source: kaster/templates/kaster.yaml
apiVersion: external-secrets.io/v1
kind: ClusterSecretStore
metadata:
  name: vault-store
spec:
  provider:
    vault:
      version: v2
      server: http://vault.vault.svc:8200
      path: kv
      auth:
        kubernetes:
          mountPath: k8s-path-auth
          role: externalsecrets-vault-advanced
---
# Source: kaster/templates/kaster.yaml
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: database-config

spec:
  secretStoreRef:
    name: vault-store
    kind: ClusterSecretStore
  refreshPolicy: Periodic
  refreshInterval: 30m
  target:
    name: database-config
    creationPolicy: Orphan
    deletionPolicy: Merge
    template:
      data:
        database.yaml: |
          host: "{{ .db_host }}"
          port: {{ .db_port }}
          database: "{{ .db_name }}"
          username: "{{ .username }}"
          password: "{{ .password }}"
  data:
    - secretKey: db_host
      remoteRef:
        key: kv/data/default/default/glyphs-release/publics/database-config
        property: db_host
    - secretKey: db_port
      remoteRef:
        key: kv/data/default/default/glyphs-release/publics/database-config
        property: db_port
    - secretKey: db_name
      remoteRef:
        key: kv/data/default/default/glyphs-release/publics/database-config
        property: db_name
    - secretKey: username
      remoteRef:
        key: kv/data/default/default/glyphs-release/publics/database-config
        property: username
    - secretKey: password
      remoteRef:
        key: kv/data/default/default/glyphs-release/publics/database-config
        property: password
---
# Source: kaster/templates/kaster.yaml
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: api-keys

spec:
  secretStoreRef:
    name: vault-store
    kind: ClusterSecretStore
  refreshPolicy: Periodic
  refreshInterval: 30m
  target:
    name: api-keys
    creationPolicy: Orphan
    deletionPolicy: Merge
  dataFrom:
    - extract:
        conversionStrategy: Default
        decodingStrategy: None
        metadataPolicy: None
        key: kv/data/default/default/glyphs-release/publics/api-keys
---
# Source: kaster/templates/kaster.yaml
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: shared-config

spec:
  secretStoreRef:
    name: vault-store
    kind: ClusterSecretStore
  refreshPolicy: Periodic
  refreshInterval: 30m
  target:
    name: shared-config
    creationPolicy: Orphan
    deletionPolicy: Merge
  dataFrom:
    - extract:
        conversionStrategy: Default
        decodingStrategy: None
        metadataPolicy: None
        key: kv/data/default/publics/shared-config
---
# Source: kaster/templates/kaster.yaml
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: ssl-cert

spec:
  secretStoreRef:
    name: vault-store
    kind: ClusterSecretStore
  refreshPolicy: Periodic
  refreshInterval: 30m
  target:
    name: ssl-cert
    creationPolicy: Orphan
    deletionPolicy: Merge
  dataFrom:
    - extract:
        conversionStrategy: Default
        decodingStrategy: None
        metadataPolicy: None
        key: kv/data/infrastructure/ssl/certs
