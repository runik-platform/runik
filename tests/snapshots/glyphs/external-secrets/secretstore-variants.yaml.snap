# Source: kaster/templates/kaster.yaml
apiVersion: external-secrets.io/v1
kind: ClusterSecretStore
metadata:
  name: vault-cluster-store
spec:
  provider:
    vault:
      version: v2
      server: http://vault.vault.svc:8200
      path: kv
      auth:
        kubernetes:
          mountPath: k8s-path-auth
          role: externalsecrets-secretstore-variants
---
# Source: kaster/templates/kaster.yaml
apiVersion: external-secrets.io/v1
kind: ClusterSecretStore
metadata:
  name: vault-custom-auth
spec:
  provider:
    vault:
      version: v2
      server: http://vault-alternate.vault.svc:8200
      path: secret
      auth:
        kubernetes:
          mountPath: k8s-custom
          role: custom-role
          serviceAccountRef:
            name: custom-sa
            namespace: custom-namespace
---
# Source: kaster/templates/kaster.yaml
apiVersion: external-secrets.io/v1
kind: ClusterSecretStore
metadata:
  name: vault-token-auth
spec:
  provider:
    vault:
      version: v2
      server: http://vault.vault.svc:8200
      path: kv
      auth:
        tokenSecretRef:
          key: token
          name: vault-token
          namespace: vault
---
# Source: kaster/templates/kaster.yaml
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: uses-cluster-store

spec:
  secretStoreRef:
    name: vault-cluster-store
    kind: ClusterSecretStore
  refreshPolicy: Periodic
  refreshInterval: 30m
  target:
    name: uses-cluster-store
    creationPolicy: Orphan
    deletionPolicy: Merge
  dataFrom:
    - extract:
        conversionStrategy: Default
        decodingStrategy: None
        metadataPolicy: None
        key: kv/data/default/default/publics/uses-cluster-store
---
# Source: kaster/templates/kaster.yaml
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: uses-namespace-store

spec:
  secretStoreRef:
    name: vault-namespace-store
    kind: SecretStore
  refreshPolicy: Periodic
  refreshInterval: 30m
  target:
    name: uses-namespace-store
    creationPolicy: Orphan
    deletionPolicy: Merge
  dataFrom:
    - extract:
        conversionStrategy: Default
        decodingStrategy: None
        metadataPolicy: None
        key: kv/data/default/default/publics/uses-namespace-store
---
# Source: kaster/templates/kaster.yaml
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: uses-custom-auth

spec:
  secretStoreRef:
    name: vault-custom-auth
    kind: ClusterSecretStore
  refreshPolicy: Periodic
  refreshInterval: 30m
  target:
    name: uses-custom-auth
    creationPolicy: Orphan
    deletionPolicy: Merge
  dataFrom:
    - extract:
        conversionStrategy: Default
        decodingStrategy: None
        metadataPolicy: None
        key: secret/data/custom/path
---
# Source: kaster/templates/kaster.yaml
apiVersion: external-secrets.io/v1
kind: SecretStore
metadata:
  name: vault-namespace-store
spec:
  provider:
    vault:
      version: v2
      server: http://vault.vault.svc:8200
      path: kv
      auth:
        kubernetes:
          mountPath: k8s-path-auth
          role: externalsecrets-secretstore-variants
