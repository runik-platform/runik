# Source: kaster/templates/kaster.yaml
apiVersion: networking.istio.io/v1
kind: VirtualService
metadata:
  name: test-chapter-default-gateway
  labels:
    app.kubernetes.io/name: test
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: default
    app.kubernetes.io/managed-by: Helm
spec:
  hosts:
    - fallback-test.chapter.example.com
  gateways:
    - istio-system/chapter-gateway
  http:
    - match:
      - uri:
          prefix: /
      route:
        - destination:
            host: test.glyphs-release.svc.cluster.local
            port:
              number: 8080
