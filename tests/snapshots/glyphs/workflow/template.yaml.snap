apiVersion: argoproj.io/v1alpha1
kind: WorkflowTemplate
metadata:
  name: reconcile-cache
  namespace: glyphs-release
  labels:
    app.kubernetes.io/name: test
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: example
    app.kubernetes.io/managed-by: Helm
    spelbook: example
    chapter: workflows
    spell: kaster
    process: cache-reconciliation
spec:
  entrypoint: reconcile
  synchronization:
    mutexes:
    - name: cache-reconciliation
  templates:
  - container:
      args:
      - echo reconcile
      command:
      - sh
      - -c
      image: alpine:3.22
    name: reconcile
