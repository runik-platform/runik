              revision: upstream
              values:
                image:
                  repository: ghcr.io/example
            name: services
          lexicon:
            apply-branch-rules:
              contract:
                inputs:
                  parameters:
                    repository:
                      required: true
              labels:
                process: repository-bootstrap
                version: v1
              name: apply-branch-rules
              scope: namespace
