      helm:
        
        valuesObject:
          covenant:
            clients:
              example:
                attributes:
                  authService: true
                  oauth2Grant: false
                clientRoles:
                - reader
                credentials:
                  sinks:
                  - serviceAccount: console
                redirectUris:
                - https://console.example.test/oauth/callback
                webUrl: https://console.example.test
            roles:
              admin:
                realmRole: org-admin
              readonly:
                clientRole: reader
          image:
            repository: ghcr.io/example
            tag: v1.2.0
          name: console
          namespace: applications
          service:
            external: true
            ports:
            - name: http
