apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: pg-infra
  namespace: argocd
  annotations:
    argocd.argoproj.io/sync-wave: "4"
spec:
  project: example-book
  
  sources:
    
    - repoURL: https://github.com/runik-platform/summon.git
      path: .
      targetRevision: upstream
      helm:
        
        valuesObject:
          name: pg-infra
          namespace: pg-infra
          postgresql:
            pg-infra:
              backup:
                enabled: false
              dbEngine:
                enabled: false
              enableSuperuserAccess: true
              instances: 1
              storage:
                size: 1Gi
              type: cluster
          service:
            enabled: false
          serviceAccount:
            enabled: true
          workload:
            enabled: false
          spellbook:
            chapters:
            - infrastructure
            - services
            - automation
