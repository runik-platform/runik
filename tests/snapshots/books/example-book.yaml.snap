apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: nightly-backup
  namespace: argocd
spec:
  project: example-book
  
  sources:
    
    - repoURL: https://github.com/runik-platform/summon.git
      path: .
      targetRevision: upstream
      helm:
        
        valuesObject:
          args:
          - echo starting backup; date; echo backup complete
          command:
          - sh
          - -c
          image:
            name: alpine
            tag: "3.22"
          name: nightly-backup
          namespace: operations
          service:
            enabled: false
          workload:
            restartPolicy: OnFailure
            schedule: 0 2 * * *
            type: cronjob
          spellbook:
            chapters:
            - infrastructure
            - services
            - automation
            clusterSelector:
              name: development
            defaultTrinket:
              path: .
              repository: https://github.com/runik-platform/summon.git
              revision: upstream
            name: example-book
            trinkets:
              kaster:
                key: glyphs
                path: .
                repository: https://github.com/runik-platform/kaster.git
                revision: upstream
              tarot:
                key: tarot
                path: .
                repository: https://github.com/runik-platform/tarot.git
                revision: upstream
          chapter:
            name: infrastructure
          lexicon:
            apply-branch-rules:
              contract:
                inputs:
                  parameters:
                    repository:
                      required: true
              labels:
                process: repository-bootstrap
                version: v1
              name: apply-branch-rules
              scope: namespace
              type: tarot-reading
            development-cluster:
              clusterURL: https://kubernetes.default.svc
              labels:
                default: book
                name: development
              name: development-cluster
              type: k8s-cluster
            development-vault:
              authPath: example-book
              databasePath: database
              labels:
                default: book
                scope: global
              name: development-vault
              namespace: vault
              provider: operator
              secretPath: secret
              serviceAccount: vault
              skipVerify: true
              type: secret-store
              url: http://vault.vault.svc:8200
            example-keycloak:
              keycloakCrdName: keycloak
              labels:
                default: book
                scope: global
              name: example-keycloak
              namespace: keycloak
              realm: example
              secret: keycloak-access
              type: keycloak
              url: http://keycloak.keycloak.svc:8080
            letsencrypt-staging:
              email: platform@example.test
              issuerName: letsencrypt-staging
              issuerType: aws
              labels:
                default: book
                environment: staging
                scope: global
              name: letsencrypt-staging
              type: cert-issuer
            pg-infra:
              clusterName: pg-infra
              credentialsSecret: pg-infra-superuser
              database: '*'
              host: pg-infra-rw.pg-infra.svc
              labels:
                default: book
                name: pg-infra
                role: shared-infra
                scope: global
              managerSuperuser: true
              name: pg-infra
              namespace: pg-infra
              port: "5432"
              type: postgres
            repository-created:
              labels:
                event: repository-created
                source: forge
              name: repository-created
              parameters:
                repository:
                  from: body.repository.full_name
              readingSelector:
                process: repository-bootstrap
                version: v1
              type: workflow-trigger
  destination:
    server: https://kubernetes.default.svc
    namespace: operations
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    syncOptions:
      - CreateNamespace=true
      - PrunePropagationPolicy=foreground
      - PruneLast=true
    retry:
      backoff:
        duration: 5s
        factor: 2
        maxDuration: 3m
      limit: 2
