apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: apply-branch-rules
  namespace: argocd
spec:
  project: example-book
  
  sources:
    
    - repoURL: https://github.com/runik-platform/summon.git
      path: .
      targetRevision: upstream
      helm:
        
        valuesObject:
          name: apply-branch-rules
          namespace: automation
          serviceAccount:
            enabled: false
          vault:
            forge-token:
              keys:
              - token
              path: book
              type: secret
            policy:
              paths:
              - capabilities:
                - read
                path: secret/data/example-book/forge-token
              type: policy
          workload:
            enabled: false
          spellbook:
            chapters:
            - infrastructure
            - services
            - automation
            clusterSelector:
              name: development
            defaultTrinket:
              path: .
              repository: https://github.com/runik-platform/summon.git
              revision: upstream
            name: example-book
            trinkets:
              kaster:
                key: glyphs
                path: .
                repository: https://github.com/runik-platform/kaster.git
                revision: upstream
              tarot:
                key: tarot
                path: .
                repository: https://github.com/runik-platform/tarot.git
                revision: upstream
          chapter:
            name: automation
          lexicon:
            apply-branch-rules:
              contract:
                inputs:
                  parameters:
                    repository:
                      required: true
              labels:
                process: repository-bootstrap
                version: v1
              name: apply-branch-rules
              scope: namespace
              type: tarot-reading
            development-cluster:
              clusterURL: https://kubernetes.default.svc
              labels:
                default: book
                name: development
              name: development-cluster
              type: k8s-cluster
            development-vault:
              authPath: example-book
              databasePath: database
              labels:
                default: book
                scope: global
              name: development-vault
              namespace: vault
              provider: operator
              secretPath: secret
              serviceAccount: vault
              skipVerify: true
              type: secret-store
              url: http://vault.vault.svc:8200
            example-keycloak:
              keycloakCrdName: keycloak
              labels:
                default: book
                scope: global
              name: example-keycloak
              namespace: keycloak
              realm: example
              secret: keycloak-access
              type: keycloak
              url: http://keycloak.keycloak.svc:8080
            letsencrypt-staging:
              email: platform@example.test
              issuerName: letsencrypt-staging
              issuerType: aws
              labels:
                default: book
                environment: staging
                scope: global
              name: letsencrypt-staging
              type: cert-issuer
            pg-infra:
              clusterName: pg-infra
              credentialsSecret: pg-infra-superuser
              database: '*'
              host: pg-infra-rw.pg-infra.svc
              labels:
                default: book
                name: pg-infra
                role: shared-infra
                scope: global
              managerSuperuser: true
              name: pg-infra
              namespace: pg-infra
              port: "5432"
              type: postgres
            repository-created:
              labels:
                event: repository-created
                source: forge
              name: repository-created
              parameters:
                repository:
                  from: body.repository.full_name
              readingSelector:
                process: repository-bootstrap
                version: v1
              type: workflow-trigger
      
    - repoURL: https://github.com/runik-platform/tarot.git
      path: .
      targetRevision: upstream
      helm:
        valuesObject:
          
          tarot:
            labels:
              environment: development
              process: repository-bootstrap
            reading:
              cards:
                default-branch:
                  depends:
                  - initialize
                  uses: set-default-branch
                initialize:
                  uses: initialize-repository
                  with:
                    repository: '{{workflow.parameters.repository}}'
                protection:
                  depends:
                  - default-branch
                  uses: apply-protection
              inputs:
                parameters:
                  repository:
                    required: true
            secrets:
              forge-token:
                contentType: env
                name: forge-token
            with:
              repository: example/project
          spellbook:
            chapters:
            - infrastructure
            - services
            - automation
            clusterSelector:
              name: development
            defaultTrinket:
              path: .
              repository: https://github.com/runik-platform/summon.git
              revision: upstream
            name: example-book
            trinkets:
              kaster:
                key: glyphs
                path: .
                repository: https://github.com/runik-platform/kaster.git
                revision: upstream
              tarot:
                key: tarot
                path: .
                repository: https://github.com/runik-platform/tarot.git
                revision: upstream
          chapter:
            name: automation
            tarot:
              cards:
                apply-protection:
                  container:
                    args:
                    - echo apply branch protection
                    command:
                    - sh
                    - -c
                    image: alpine:3.22
                initialize-repository:
                  container:
                    args:
                    - echo initialize {{inputs.parameters.repository}}
                    command:
                    - sh
                    - -c
                    image: alpine:3.22
                  contract:
                    inputs:
                      parameters:
                        repository:
                          required: true
                set-default-branch:
                  container:
                    args:
                    - echo set default branch
                    command:
                    - sh
                    - -c
                    image: alpine:3.22
          lexicon:
            apply-branch-rules:
              contract:
                inputs:
                  parameters:
                    repository:
                      required: true
              labels:
                process: repository-bootstrap
                version: v1
              name: apply-branch-rules
              scope: namespace
              type: tarot-reading
            development-cluster:
              clusterURL: https://kubernetes.default.svc
              labels:
                default: book
                name: development
              name: development-cluster
              type: k8s-cluster
            development-vault:
              authPath: example-book
              databasePath: database
              labels:
                default: book
                scope: global
              name: development-vault
              namespace: vault
              provider: operator
              secretPath: secret
              serviceAccount: vault
              skipVerify: true
              type: secret-store
              url: http://vault.vault.svc:8200
            example-keycloak:
              keycloakCrdName: keycloak
              labels:
                default: book
                scope: global
              name: example-keycloak
              namespace: keycloak
              realm: example
              secret: keycloak-access
              type: keycloak
              url: http://keycloak.keycloak.svc:8080
            letsencrypt-staging:
              email: platform@example.test
              issuerName: letsencrypt-staging
              issuerType: aws
              labels:
                default: book
                environment: staging
                scope: global
              name: letsencrypt-staging
              type: cert-issuer
            pg-infra:
              clusterName: pg-infra
              credentialsSecret: pg-infra-superuser
              database: '*'
              host: pg-infra-rw.pg-infra.svc
              labels:
                default: book
                name: pg-infra
                role: shared-infra
                scope: global
              managerSuperuser: true
              name: pg-infra
              namespace: pg-infra
              port: "5432"
              type: postgres
            repository-created:
              labels:
                event: repository-created
                source: forge
              name: repository-created
              parameters:
                repository:
                  from: body.repository.full_name
              readingSelector:
                process: repository-bootstrap
                version: v1
              type: workflow-trigger
  destination:
    server: https://kubernetes.default.svc
    namespace: automation
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    syncOptions:
      - CreateNamespace=true
      - PrunePropagationPolicy=foreground
      - PruneLast=true
    retry:
      backoff:
        duration: 5s
        factor: 2
        maxDuration: 3m
      limit: 2
