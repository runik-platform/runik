---
# Source: summon/templates/summon.yaml
apiVersion: v1
kind: ServiceAccount
metadata:
  name: app-with-vault
  labels:
    app.kubernetes.io/name: app-with-vault
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: example
    app.kubernetes.io/managed-by: Helm
    spelbook: example
    chapter: test
    spell: app-with-vault
---
# Source: summon/templates/summon.yaml
apiVersion: v1
kind: Service
metadata:
  name: app-with-vault
  labels:
    app.kubernetes.io/name: app-with-vault
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: example
    app.kubernetes.io/managed-by: Helm
    spelbook: example
    chapter: test
    spell: app-with-vault
spec:
  type: ClusterIP
  ports:
    - port: 80
      protocol: TCP
      name: http
      targetPort: 80
  selector:
    app.kubernetes.io/name: app-with-vault
    app.kubernetes.io/instance: test
---
# Source: summon/templates/summon.yaml
apiVersion: apps/v1
kind: Deployment
metadata:
  name: app-with-vault
  labels:
    app.kubernetes.io/name: app-with-vault
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: example
    app.kubernetes.io/managed-by: Helm
    spelbook: example
    chapter: test
    spell: app-with-vault
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: app-with-vault
      app.kubernetes.io/instance: test
  template:
    metadata:
      labels:
        app.kubernetes.io/name: app-with-vault
        app.kubernetes.io/instance: test
      
    spec:
      serviceAccountName: app-with-vault
      containers:
        
        - name: app-with-vault-app-with-vault
          image: nginx/app-with-vault:latest
          imagePullPolicy: IfNotPresent
          
          
          
          envFrom:
          
            - secretRef:
                name: api-credentials
          
          env:
          
            - name: SPELLBOOK_NAME
              value: "example"
            - name: CHAPTER_NAME
              value: "test"
            - name: SPELL_NAME
              value: "app-with-vault"
            - name: APP_ENV
              value: "production"
            - name: LOG_LEVEL
              value: "info"
          
            
          ports:
            - name: http
              containerPort: 80
              protocol: TCP
