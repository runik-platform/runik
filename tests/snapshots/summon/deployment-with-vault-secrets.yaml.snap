# Source: summon/templates/summon.yaml
apiVersion: redhatcop.redhat.io/v1alpha1
kind: KubernetesAuthEngineRole
metadata:
  name: app-with-vault
  namespace: vault
  labels:
    app.kubernetes.io/name: app-with-vault
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: example
    app.kubernetes.io/managed-by: Helm
    spelbook: example
    chapter: test
    spell: app-with-vault
spec:
  authentication:
    path: example
    role: vault
    serviceAccount:
      name: vault
  connection:
    address: http://vault.vault.svc:8200
    tLSConfig:
      skipVerify: true
  path: example
  policies:
    - app-with-vault
  targetServiceAccounts:
    - app-with-vault
  targetNamespaces:
    targetNamespaces:
      - glyphs-release
---
# Source: summon/templates/summon.yaml
apiVersion: redhatcop.redhat.io/v1alpha1
kind: Policy
metadata:
  name: app-with-vault
  namespace: vault
  labels:
    app.kubernetes.io/name: app-with-vault
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: example
    app.kubernetes.io/managed-by: Helm
    spelbook: example
    chapter: test
    spell: app-with-vault
spec:
  authentication:
    path: example
    role: vault
    serviceAccount:
      name: vault
  connection:
    address: http://vault.vault.svc:8200
    tLSConfig:
      skipVerify: true
  policy: |
    path "kv/data/example/test/glyphs-release/*" {
      capabilities = ["create","read","update","delete","list"]
    }
    path "kv/metadata/example/test/glyphs-release/*" {
      capabilities = ["create","read","update","delete","list"]
    }
    path "kv/data/example/test/publics/*" {
      capabilities = ["read","list"]
    }
    path "kv/metadata/example/test/publics/*" {
      capabilities = ["read","list"]
    }
    path "kv/data/example/publics/*" {
      capabilities = ["read","list"]
    }
    path "kv/metadata/example/publics/*" {
      capabilities = ["read","list"]
    }
    path "kv/data/example/pipelines/*" {
      capabilities = ["read","list"]
    }
    path "kv/metadata/example/pipelines/*" {
      capabilities = ["read","list"]
    }
    path "sys/policies/password/*" {
      capabilities = ["read","list"]
    }
---
# Source: summon/templates/summon.yaml
apiVersion: redhatcop.redhat.io/v1alpha1
kind: RandomSecret
metadata:
  name: api-credentials
  labels:
    app.kubernetes.io/name: app-with-vault
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: example
    app.kubernetes.io/managed-by: Helm
    spelbook: example
    chapter: test
    spell: app-with-vault
spec:
  authentication:
    path: example
    role: app-with-vault
    serviceAccount:
      name: app-with-vault
  connection:
    address: http://vault.vault.svc:8200
    tLSConfig:
      skipVerify: true
  isKVSecretsEngineV2: true
  path: kv/data/example/test/glyphs-release/publics/
  secretKey: API_TOKEN
  secretFormat:
    passwordPolicyName: simple-password-policy
---
# Source: summon/templates/summon.yaml
apiVersion: redhatcop.redhat.io/v1alpha1
kind: VaultSecret
metadata:
  name: api-credentials
  labels:
    app.kubernetes.io/name: app-with-vault
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: example
    app.kubernetes.io/managed-by: Helm
    spelbook: example
    chapter: test
    spell: app-with-vault
spec:
  refreshThreshold: 90
  refreshPeriod: 3m0s
  vaultSecretDefinitions:
    - name: secret
      requestType: GET
      path: kv/data/example/test/glyphs-release/publics/api-credentials
      authentication:
        path: example
        role: app-with-vault
        serviceAccount:
          name: app-with-vault
      connection:
        address: http://vault.vault.svc:8200
        tLSConfig:
          skipVerify: true
  output:
    name: api-credentials
    labels:
      app.kubernetes.io/name: app-with-vault
      app.kubernetes.io/instance: test
      app.kubernetes.io/part-of: example
      app.kubernetes.io/managed-by: Helm
      spelbook: example
      chapter: test
      spell: app-with-vault
    stringData: #tiene q haber una forma de hacer q esto funcione con un range del lado del operator para q no hagan falta las keys
        API_KEY: '{{ .secret.API_KEY }}'
        API_SECRET: '{{ .secret.API_SECRET }}'
        API_VERSION: v1
        API_TOKEN: '{{ .secret.API_TOKEN }}'
    type: Opaque
