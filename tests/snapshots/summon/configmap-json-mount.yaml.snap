apiVersion: v1
kind: ServiceAccount
metadata:
  name: app-with-configmap-json
  labels:
    app.kubernetes.io/name: app-with-configmap-json
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: default
    app.kubernetes.io/managed-by: Helm
    spelbook: default
    chapter: default
    spell: app-with-configmap-json
---
# Source: summon/templates/summon.yaml
kind: ConfigMap
apiVersion: v1
metadata:
  name: config-json
  labels:
    app.kubernetes.io/name: app-with-configmap-json
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: default
    app.kubernetes.io/managed-by: Helm
    spelbook: default
    chapter: default
    spell: app-with-configmap-json
data:
  
  config-json: |
    {"cache":{"host":"redis.local","port":6379},"database":{"host":"postgres.local","name":"myapp","port":5432},"features":["authentication","notifications","analytics"]}
---
# Source: summon/templates/summon.yaml
apiVersion: apps/v1
kind: Deployment
metadata:
  name: app-with-configmap-json
  labels:
    app.kubernetes.io/name: app-with-configmap-json
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: default
    app.kubernetes.io/managed-by: Helm
    spelbook: default
    chapter: default
    spell: app-with-configmap-json
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: app-with-configmap-json
      app.kubernetes.io/instance: test
  template:
    metadata:
      labels:
        app.kubernetes.io/name: app-with-configmap-json
        app.kubernetes.io/instance: test
      
      annotations:
        checksum/configmap-app-config: 484557eec534d67fb923cdcfdd4dac60288885b3b96b983decfeeedaf8420ef5
    spec:
      serviceAccountName: app-with-configmap-json
      containers:
        
        - name: app-with-configmap-json-app-with-configmap-json
          image: nginx/app-with-configmap-json:latest
          imagePullPolicy: IfNotPresent
          
          
          volumeMounts:
          
            - name: config-json
              
              mountPath: /app/config/config.json
              
              subPath: config-json
          
          
          env:
          
            - name: SPELLBOOK_NAME
              value: "default"
            - name: CHAPTER_NAME
              value: "default"
            - name: SPELL_NAME
              value: "app-with-configmap-json"
          
      
      volumes:
      
        - name: config-json
          configMap:
            name: config-json
