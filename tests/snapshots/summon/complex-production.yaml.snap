# Source: summon/templates/summon.yaml
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: test-logs
  labels:
    app.kubernetes.io/name: test
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: default
    app.kubernetes.io/managed-by: Helm
    spelbook: default
    chapter: default
    spell: summon
spec:
  
  accessModes:
    - ReadWriteOnce
  resources:
    requests:
      storage: 10Gi
---
# Source: summon/templates/summon.yaml
apiVersion: v1
kind: Service
metadata:
  name: test
  labels:
    app.kubernetes.io/name: test
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: default
    app.kubernetes.io/managed-by: Helm
    spelbook: default
    chapter: default
    spell: summon
  annotations:
    
    service.beta.kubernetes.io/aws-load-balancer-type: nlb
spec:
  type: ClusterIP
  ports:
    - port: 80
      protocol: TCP
      name: http
      targetPort: 80
    - port: 8080
      protocol: TCP
      name: admin
      targetPort: 8080
  selector:
    app.kubernetes.io/name: test
    app.kubernetes.io/instance: test
---
# Source: summon/templates/summon.yaml
apiVersion: apps/v1
kind: Deployment
metadata:
  name: test
  labels:
    app.kubernetes.io/name: test
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: default
    app.kubernetes.io/managed-by: Helm
    spelbook: default
    chapter: default
    spell: summon
spec:
  selector:
    matchLabels:
      app.kubernetes.io/name: test
      app.kubernetes.io/instance: test
  template:
    metadata:
      labels:
        app.kubernetes.io/name: test
        app.kubernetes.io/instance: test
      
    spec:
      serviceAccountName: test
      containers:
        
        - name: test-main
          image: myapp:v1.2.3
          imagePullPolicy: Always
          
          resources:
            limits:
              cpu: 500m
              memory: 512Mi
            requests:
              cpu: 250m
              memory: 256Mi
          
          volumeMounts:
          
            - name: app-data
              mountPath: /app/data
            - name: config
              mountPath: /app/config
            - name: logs
              mountPath: /app/logs
          
          
          env:
          
            - name: SPELLBOOK_NAME
              value: "default"
            - name: CHAPTER_NAME
              value: "default"
            - name: SPELL_NAME
              value: "test"
            - name: DATABASE_URL
              valueFrom:
                secretKeyRef:
                  name: db-credentials
                  key: url
            - name: ENVIRONMENT
              value: "production"
            - name: LOG_LEVEL
              value: "info"
          
            
          ports:
            - name: http
              containerPort: 80
              protocol: TCP
            - name: admin
              containerPort: 8080
              protocol: TCP
      
      volumes:
      
        - name: app-data
          persistentVolumeClaim:
            claimName: test-app-data
        - name: config
        - name: logs
          persistentVolumeClaim:
            claimName: test-logs
---
# Source: summon/templates/summon.yaml
apiVersion: autoscaling/v2
kind: HorizontalPodAutoscaler
metadata:
  name: test
  labels:
    app.kubernetes.io/name: test
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: default
    app.kubernetes.io/managed-by: Helm
    spelbook: default
    chapter: default
    spell: summon
spec:
  scaleTargetRef:
    apiVersion: apps/v1
    kind: Deployment
    name: test
  minReplicas: 3
  maxReplicas: 10
  metrics:
    - type: Resource
      resource:
        name: cpu
        target:
          type: Utilization
          averageUtilization: 70
---
