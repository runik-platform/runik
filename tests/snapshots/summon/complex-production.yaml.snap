apiVersion: v1
kind: ServiceAccount
metadata:
  name: test
  labels:
    app.kubernetes.io/name: test
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: default
    app.kubernetes.io/managed-by: Helm
    spelbook: default
    chapter: default
    spell: summon
  annotations:
    
    eks.amazonaws.com/role-arn: arn:aws:iam::123456789:role/test-role
---
# Source: summon/templates/summon.yaml
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: test-app-data
  labels:
    app.kubernetes.io/name: test
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: default
    app.kubernetes.io/managed-by: Helm
    spelbook: default
    chapter: default
    spell: summon
spec:
  
  accessModes:
    - ReadWriteOnce
  resources:
    requests:
      storage: 20Gi
