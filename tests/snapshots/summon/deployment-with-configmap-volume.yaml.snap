---
# Source: summon/templates/summon.yaml
apiVersion: v1
kind: ServiceAccount
metadata:
  name: test
  labels:
    app.kubernetes.io/name: test
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: default
    app.kubernetes.io/managed-by: Helm
    spelbook: default
    chapter: default
    spell: summon
---
# Source: summon/templates/summon.yaml
apiVersion: v1
kind: Service
metadata:
  name: test
  labels:
    app.kubernetes.io/name: test
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: default
    app.kubernetes.io/managed-by: Helm
    spelbook: default
    chapter: default
    spell: summon
spec:
  type: ClusterIP
  ports:
    - port: 80
      protocol: TCP
      name: http
      targetPort: 80
  selector:
    app.kubernetes.io/name: test
    app.kubernetes.io/instance: test
---
# Source: summon/templates/summon.yaml
apiVersion: apps/v1
kind: Deployment
metadata:
  name: test
  labels:
    app.kubernetes.io/name: test
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: default
    app.kubernetes.io/managed-by: Helm
    spelbook: default
    chapter: default
    spell: summon
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: test
      app.kubernetes.io/instance: test
  template:
    metadata:
      labels:
        app.kubernetes.io/name: test
        app.kubernetes.io/instance: test
      
    spec:
      serviceAccountName: test
      containers:
        
        - name: test-main
          image: nginx:latest
          imagePullPolicy: IfNotPresent
          
          
          volumeMounts:
          
            - name: app-config
              mountPath: /etc/config
            - name: nginx-conf
              mountPath: /etc/nginx
            - name: selective-mount
              mountPath: /etc/settings
          
          
          env:
          
            - name: SPELLBOOK_NAME
              value: "default"
            - name: CHAPTER_NAME
              value: "default"
            - name: SPELL_NAME
              value: "test"
          
            
          ports:
            - name: http
              containerPort: 80
              protocol: TCP
      
      volumes:
      
        - name: app-config
          configMap:
            name: application-config
        - name: nginx-conf
          configMap:
            name: nginx-config
            defaultMode: 420
        - name: selective-mount
          configMap:
            name: app-settings
            items:
              - key: config.json
                path: application.json
              - key: logging.yaml
                path: log-config.yaml
                mode: 384
---
