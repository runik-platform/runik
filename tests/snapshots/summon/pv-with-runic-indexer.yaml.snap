# Source: summon/templates/summon.yaml
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: app-with-runic-csi-downloads
  labels:
    app.kubernetes.io/name: app-with-runic-csi
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: default
    app.kubernetes.io/managed-by: Helm
    spelbook: default
    chapter: default
    spell: app-with-runic-csi
spec:
  
  volumeName: app-with-runic-csi-downloads
  
  storageClassName: "s3-shared"
  accessModes:
    - ReadWriteMany
  resources:
    requests:
      storage: 200Gi
---
# Source: summon/templates/summon.yaml
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: app-with-runic-csi-manual-config
  labels:
    app.kubernetes.io/name: app-with-runic-csi
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: default
    app.kubernetes.io/managed-by: Helm
    spelbook: default
    chapter: default
    spell: app-with-runic-csi
spec:
  
  volumeName: app-with-runic-csi-manual-config
  
  storageClassName: "s3-shared"
  accessModes:
    - ReadWriteMany
  resources:
    requests:
      storage: 50Gi
---
# Source: summon/templates/summon.yaml
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: app-with-runic-csi-series
  labels:
    app.kubernetes.io/name: app-with-runic-csi
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: default
    app.kubernetes.io/managed-by: Helm
    spelbook: default
    chapter: default
    spell: app-with-runic-csi
spec:
  
  volumeName: app-with-runic-csi-series
  
  storageClassName: "s3-shared"
  accessModes:
    - ReadWriteMany
  resources:
    requests:
      storage: 100Gi
---
# Source: summon/templates/summon.yaml
apiVersion: apps/v1
kind: Deployment
metadata:
  name: app-with-runic-csi
  labels:
    app.kubernetes.io/name: app-with-runic-csi
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: default
    app.kubernetes.io/managed-by: Helm
    spelbook: default
    chapter: default
    spell: app-with-runic-csi
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: app-with-runic-csi
      app.kubernetes.io/instance: test
  template:
    metadata:
      labels:
        app.kubernetes.io/name: app-with-runic-csi
        app.kubernetes.io/instance: test
      
    spec:
      serviceAccountName: app-with-runic-csi
      containers:
        
        - name: app-with-runic-csi-app-with-runic-csi
          image: nginx/app-with-runic-csi:latest
          imagePullPolicy: IfNotPresent
          
          
          volumeMounts:
          
            - name: downloads
              mountPath: /downloads
            - name: manual-config
              mountPath: /manual
            - name: series
              mountPath: /series
          
          
          env:
          
            - name: SPELLBOOK_NAME
              value: "default"
            - name: CHAPTER_NAME
              value: "default"
            - name: SPELL_NAME
              value: "app-with-runic-csi"
          
      
      volumes:
      
        - name: downloads
          persistentVolumeClaim:
            claimName: app-with-runic-csi-downloads
        - name: manual-config
          persistentVolumeClaim:
            claimName: app-with-runic-csi-manual-config
        - name: series
          persistentVolumeClaim:
            claimName: app-with-runic-csi-series
