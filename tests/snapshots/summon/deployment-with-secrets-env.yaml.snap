spec:
  type: ClusterIP
  ports:
    - port: 80
      protocol: TCP
      name: http
      targetPort: 80
  selector:
    app.kubernetes.io/name: app-with-secrets
    app.kubernetes.io/instance: test
---
# Source: summon/templates/summon.yaml
apiVersion: apps/v1
kind: Deployment
metadata:
  name: app-with-secrets
  labels:
    app.kubernetes.io/name: app-with-secrets
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: default
    app.kubernetes.io/managed-by: Helm
    spelbook: default
    chapter: default
    spell: app-with-secrets
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: app-with-secrets
      app.kubernetes.io/instance: test
  template:
    metadata:
      labels:
        app.kubernetes.io/name: app-with-secrets
        app.kubernetes.io/instance: test
      
      annotations:
        checksum/secret-app-config: 7f50b753cf0f3dce9bc95e979c83c6fe9347af71b3c5225511a4d3f027e32fca
    spec:
      serviceAccountName: app-with-secrets
      containers:
        
        - name: app-with-secrets-app-with-secrets
          image: nginx/app-with-secrets:latest
          imagePullPolicy: IfNotPresent
          
          
          volumeMounts:
          
            - name: tls-certificates
              mountPath: /etc/tls
              
              subPath: tls-certificates
          
          envFrom:
          
            - secretRef:
                name: api-credentials
            - secretRef:
                name: app-config
            - secretRef:
                name: database-credentials
          
          env:
          
            - name: SPELLBOOK_NAME
              value: "default"
            - name: CHAPTER_NAME
              value: "default"
            - name: SPELL_NAME
              value: "app-with-secrets"
            - name: APP_ENV
              value: "production"
            - name: LOG_LEVEL
              value: "info"
            - name: SERVICE_NAME
              value: "app-with-secrets"
          
            
          ports:
            - name: http
              containerPort: 80
              protocol: TCP
      
      volumes:
      
        - name: tls-certificates
          secret:
            secretName: tls-certificates
