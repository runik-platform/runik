---
# Source: summon/templates/summon.yaml
apiVersion: v1
kind: ServiceAccount
metadata:
  name: app-with-s3-storage
  labels:
    app.kubernetes.io/name: app-with-s3-storage
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: default
    app.kubernetes.io/managed-by: Helm
    spelbook: default
    chapter: default
    spell: app-with-s3-storage
---
# Source: summon/templates/summon.yaml
apiVersion: v1
kind: PersistentVolume
metadata:
    
  name: app-with-s3-storage-s3-data
  labels:
    app.kubernetes.io/name: app-with-s3-storage
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: default
    app.kubernetes.io/managed-by: Helm
    spelbook: default
    chapter: default
    spell: app-with-s3-storage
    volume: s3-data
spec:
  storageClassName: "csi-s3"
  capacity:
    storage: 10Gi
  accessModes:
    - ReadWriteMany
  persistentVolumeReclaimPolicy: Retain
  
  csi:
    
    driver: ru.yandex.s3.csi
    volumeHandle: mybucket/data
    
    volumeAttributes:
      bucket: "mybucket"
      mounter: "geesefs"
      options: "--memory-limit 1000 --dir-mode 0777 --file-mode 0666"
      region: "us-east-1"
    
    nodeStageSecretRef:
      name: s3-secret
      namespace: glyphs-release
    nodePublishSecretRef:
      name: s3-secret
      namespace: glyphs-release
---
# Source: summon/templates/summon.yaml
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: app-with-s3-storage-local-data
  labels:
    app.kubernetes.io/name: app-with-s3-storage
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: default
    app.kubernetes.io/managed-by: Helm
    spelbook: default
    chapter: default
    spell: app-with-s3-storage
spec:
  
  storageClassName: "standard"
  accessModes:
    - ReadWriteOnce
  resources:
    requests:
      storage: 1Gi
---
# Source: summon/templates/summon.yaml
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: app-with-s3-storage-s3-data
  labels:
    app.kubernetes.io/name: app-with-s3-storage
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: default
    app.kubernetes.io/managed-by: Helm
    spelbook: default
    chapter: default
    spell: app-with-s3-storage
spec:
  
  volumeName: app-with-s3-storage-s3-data
  
  storageClassName: "csi-s3"
  accessModes:
    - ReadWriteMany
  resources:
    requests:
      storage: 10Gi
---
# Source: summon/templates/summon.yaml
apiVersion: v1
kind: Service
metadata:
  name: app-with-s3-storage
  labels:
    app.kubernetes.io/name: app-with-s3-storage
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: default
    app.kubernetes.io/managed-by: Helm
    spelbook: default
    chapter: default
    spell: app-with-s3-storage
spec:
  type: ClusterIP
  ports:
    - port: 80
      protocol: TCP
      name: http
      targetPort: 80
  selector:
    app.kubernetes.io/name: app-with-s3-storage
    app.kubernetes.io/instance: test
---
# Source: summon/templates/summon.yaml
apiVersion: apps/v1
kind: Deployment
metadata:
  name: app-with-s3-storage
  labels:
    app.kubernetes.io/name: app-with-s3-storage
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: default
    app.kubernetes.io/managed-by: Helm
    spelbook: default
    chapter: default
    spell: app-with-s3-storage
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: app-with-s3-storage
      app.kubernetes.io/instance: test
  template:
    metadata:
      labels:
        app.kubernetes.io/name: app-with-s3-storage
        app.kubernetes.io/instance: test
      
    spec:
      serviceAccountName: app-with-s3-storage
      containers:
        
        - name: app-with-s3-storage-app-with-s3-storage
          image: nginx/app-with-s3-storage:latest
          imagePullPolicy: IfNotPresent
          
          
          volumeMounts:
          
            - name: local-data
              mountPath: /data/local
            - name: s3-data
              mountPath: /data/s3
            - name: temp-data
              mountPath: /tmp/cache
          
          
          env:
          
            - name: SPELLBOOK_NAME
              value: "default"
            - name: CHAPTER_NAME
              value: "default"
            - name: SPELL_NAME
              value: "app-with-s3-storage"
          
            
          ports:
            - name: http
              containerPort: 80
              protocol: TCP
      
      volumes:
      
        - name: local-data
          persistentVolumeClaim:
            claimName: app-with-s3-storage-local-data
        - name: s3-data
          persistentVolumeClaim:
            claimName: app-with-s3-storage-s3-data
        - name: temp-data
          emptyDir: 
              medium: "Memory"
              sizeLimit: 500Mi
---
