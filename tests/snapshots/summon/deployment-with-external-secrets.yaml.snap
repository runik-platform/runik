---
# Source: summon/templates/summon.yaml
apiVersion: v1
kind: ServiceAccount
metadata:
  name: app-with-external-secrets
  labels:
    app.kubernetes.io/name: app-with-external-secrets
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: default
    app.kubernetes.io/managed-by: Helm
    spelbook: default
    chapter: default
    spell: app-with-external-secrets
---
# Source: summon/templates/summon.yaml
apiVersion: v1
kind: Service
metadata:
  name: app-with-external-secrets
  labels:
    app.kubernetes.io/name: app-with-external-secrets
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: default
    app.kubernetes.io/managed-by: Helm
    spelbook: default
    chapter: default
    spell: app-with-external-secrets
spec:
  type: ClusterIP
  ports:
    - port: 80
      protocol: TCP
      name: http
      targetPort: 80
  selector:
    app.kubernetes.io/name: app-with-external-secrets
    app.kubernetes.io/instance: test
---
# Source: summon/templates/summon.yaml
apiVersion: apps/v1
kind: Deployment
metadata:
  name: app-with-external-secrets
  labels:
    app.kubernetes.io/name: app-with-external-secrets
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: default
    app.kubernetes.io/managed-by: Helm
    spelbook: default
    chapter: default
    spell: app-with-external-secrets
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: app-with-external-secrets
      app.kubernetes.io/instance: test
  template:
    metadata:
      labels:
        app.kubernetes.io/name: app-with-external-secrets
        app.kubernetes.io/instance: test
      
    spec:
      serviceAccountName: app-with-external-secrets
      containers:
        
        - name: app-with-external-secrets-app-with-external-secrets
          image: nginx/app-with-external-secrets:latest
          imagePullPolicy: IfNotPresent
          
          
          volumeMounts:
          
            - name: config-data
              mountPath: 
              
              subPath: config-data
          
          envFrom:
          
            - secretRef:
                name: api-credentials
            - secretRef:
                name: database-credentials
          
          env:
          
            - name: SPELLBOOK_NAME
              value: "default"
            - name: CHAPTER_NAME
              value: "default"
            - name: SPELL_NAME
              value: "app-with-external-secrets"
            - name: APP_ENV
              value: "production"
            - name: LOG_LEVEL
              value: "info"
          
            
          ports:
            - name: http
              containerPort: 80
              protocol: TCP
      
      volumes:
      
        - name: config-data
          secret:
            secretName: config-data
