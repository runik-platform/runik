---
# Source: summon/templates/summon.yaml
apiVersion: apps/v1
kind: Deployment
metadata:
  name: app-with-checksums
  labels:
    app.kubernetes.io/name: app-with-checksums
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: default
    app.kubernetes.io/managed-by: Helm
    spelbook: default
    chapter: default
    spell: app-with-checksums
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: app-with-checksums
      app.kubernetes.io/instance: test
  template:
    metadata:
      labels:
        app.kubernetes.io/name: app-with-checksums
        app.kubernetes.io/instance: test
      
      annotations:
        checksum/configmap-app-config: 677116dae315c0826fe02b26408cc532ba1f98993ca331ad5f0c3dbdcd02c7a1
        checksum/configmap-env-config: 1bcfd02d8c8aaf2fddda01d0bb1e1def171defd047b66151db26f5eaffcce635
        checksum/secret-db-credentials: 03ce83692df7c1dc25609ec0d8888d94469dc4031a9ccc48a77304b3cabe159a
        checksum/secret-tls-config: 7d1b52ee1ca843e901acb09886247fecaf3822db007da58696c961c681592933
    spec:
      serviceAccountName: app-with-checksums
      containers:
        
        - name: app-with-checksums-app-with-checksums
          image: nginx/app-with-checksums:latest
          imagePullPolicy: IfNotPresent
          
          
          volumeMounts:
          
            - name: config-yml
              
              mountPath: /app/config/config.yml
              
              subPath: config-yml
            - name: tls-pem
              mountPath: /app/tls
              
              subPath: tls-pem
          
          envFrom:
          
            - configMapRef:
                name: env-config
            - secretRef:
                name: db-credentials
          
          env:
          
            - name: SPELLBOOK_NAME
              value: "default"
            - name: CHAPTER_NAME
              value: "default"
            - name: SPELL_NAME
              value: "app-with-checksums"
          
            
          ports:
            - name: http
              containerPort: 80
              protocol: TCP
      
      volumes:
      
        - name: config-yml
          configMap:
            name: config-yml
        - name: tls-pem
          secret:
            secretName: tls-pem
