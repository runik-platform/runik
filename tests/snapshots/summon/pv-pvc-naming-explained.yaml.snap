---
# Source: summon/templates/summon.yaml
apiVersion: apps/v1
kind: Deployment
metadata:
  name: pv-naming-demo
  labels:
    app.kubernetes.io/name: pv-naming-demo
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: default
    app.kubernetes.io/managed-by: Helm
    spelbook: default
    chapter: default
    spell: pv-naming-demo
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: pv-naming-demo
      app.kubernetes.io/instance: test
  template:
    metadata:
      labels:
        app.kubernetes.io/name: pv-naming-demo
        app.kubernetes.io/instance: test
      
    spec:
      serviceAccountName: pv-naming-demo
      containers:
        
        - name: pv-naming-demo-pv-naming-demo
          image: nginx/pv-naming-demo:latest
          imagePullPolicy: IfNotPresent
          
          
          volumeMounts:
          
            - name: data1
              mountPath: /data1
            - name: data2
              mountPath: /data2
            - name: data3
              mountPath: /data3
            - name: data4
              mountPath: /data4
            - name: dynamic
              mountPath: /dynamic
            - name: preexisting
              mountPath: /preexisting
          
          
          env:
          
            - name: SPELLBOOK_NAME
              value: "default"
            - name: CHAPTER_NAME
              value: "default"
            - name: SPELL_NAME
              value: "pv-naming-demo"
          
      
      volumes:
      
        - name: data1
          persistentVolumeClaim:
            claimName: pv-naming-demo-data1
        - name: data2
          persistentVolumeClaim:
            claimName: my-custom-pvc
        - name: data3
          persistentVolumeClaim:
            claimName: pv-naming-demo-data3
        - name: data4
          persistentVolumeClaim:
            claimName: custom-pvc-name
        - name: dynamic
          persistentVolumeClaim:
            claimName: pv-naming-demo-dynamic
        - name: preexisting
          persistentVolumeClaim:
            claimName: pv-naming-demo-preexisting
