apiVersion: v1
kind: ServiceAccount
metadata:
  name: pv-naming-demo
  labels:
    app.kubernetes.io/name: pv-naming-demo
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: default
    app.kubernetes.io/managed-by: Helm
    spelbook: default
    chapter: default
    spell: pv-naming-demo
---
# Source: summon/templates/summon.yaml
apiVersion: v1
kind: PersistentVolume
metadata:
    
  name: pv-naming-demo-data1
  labels:
    app.kubernetes.io/name: pv-naming-demo
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: default
    app.kubernetes.io/managed-by: Helm
    spelbook: default
    chapter: default
    spell: pv-naming-demo
    volume: data1
spec:
  storageClassName: "s3-csi"
  capacity:
    storage: 10Gi
  accessModes:
    - ReadWriteMany
  persistentVolumeReclaimPolicy: Retain
  
  csi:
    
    driver: ru.yandex.s3.csi
    volumeHandle: bucket/data1
    
    volumeAttributes:
      mounter: "geesefs"
---
