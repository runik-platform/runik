apiVersion: v1
kind: ServiceAccount
metadata:
  name: security-test
  labels:
    app.kubernetes.io/name: security-test
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: example
    app.kubernetes.io/managed-by: Helm
    spelbook: example
    chapter: test
    spell: security-test
---
# Source: summon/templates/summon.yaml
apiVersion: v1
kind: Service
metadata:
  name: security-test
  labels:
    app.kubernetes.io/name: security-test
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: example
    app.kubernetes.io/managed-by: Helm
    spelbook: example
    chapter: test
    spell: security-test
spec:
  type: ClusterIP
  ports:
    - port: 8080
      protocol: TCP
      name: http
  selector:
    app.kubernetes.io/name: security-test
    app.kubernetes.io/instance: test
---
# Source: summon/templates/summon.yaml
apiVersion: apps/v1
kind: Deployment
metadata:
  name: security-test
  labels:
    app.kubernetes.io/name: security-test
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: example
    app.kubernetes.io/managed-by: Helm
    spelbook: example
    chapter: test
    spell: security-test
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: security-test
      app.kubernetes.io/instance: test
  template:
    metadata:
      labels:
        app.kubernetes.io/name: security-test
        app.kubernetes.io/instance: test
      
    spec:
      serviceAccountName: security-test
      securityContext:
        fsGroup: 2000
        runAsGroup: 3000
        runAsNonRoot: true
        runAsUser: 1000
      containers:
        
        - name: security-test-security-test
          image: nginx:alpine
          imagePullPolicy: IfNotPresent
          
          resources:
            limits:
              cpu: 100m
              memory: 128Mi
            requests:
              cpu: 50m
              memory: 64Mi
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              add:
              - NET_BIND_SERVICE
              drop:
              - ALL
            readOnlyRootFilesystem: true
          
          
          
          env:
          
            - name: SPELLBOOK_NAME
              value: "example"
            - name: CHAPTER_NAME
              value: "test"
            - name: SPELL_NAME
              value: "security-test"
---
