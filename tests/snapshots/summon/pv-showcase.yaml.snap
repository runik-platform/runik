# Source: summon/templates/summon.yaml
apiVersion: v1
kind: Service
metadata:
  name: pv-showcase
  labels:
    app.kubernetes.io/name: pv-showcase
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: default
    app.kubernetes.io/managed-by: Helm
    spelbook: default
    chapter: default
    spell: pv-showcase
spec:
  type: ClusterIP
  ports:
    - port: 80
      protocol: TCP
      name: http
  selector:
    app.kubernetes.io/name: pv-showcase
    app.kubernetes.io/instance: test
---
# Source: summon/templates/summon.yaml
apiVersion: apps/v1
kind: Deployment
metadata:
  name: pv-showcase
  labels:
    app.kubernetes.io/name: pv-showcase
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: default
    app.kubernetes.io/managed-by: Helm
    spelbook: default
    chapter: default
    spell: pv-showcase
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: pv-showcase
      app.kubernetes.io/instance: test
  template:
    metadata:
      labels:
        app.kubernetes.io/name: pv-showcase
        app.kubernetes.io/instance: test
      
    spec:
      serviceAccountName: pv-showcase
      containers:
        
        - name: pv-showcase-pv-showcase
          image: busybox/pv-showcase:latest
          imagePullPolicy: IfNotPresent
          
          
          volumeMounts:
          
            - name: azure-files
              mountPath: /mnt/azure
            - name: gcp-filestore
              mountPath: /mnt/gcp
            - name: nfs-csi
              mountPath: /mnt/nfs
            - name: s3-storage
              mountPath: /mnt/s3
          
          
          env:
          
            - name: SPELLBOOK_NAME
              value: "default"
            - name: CHAPTER_NAME
              value: "default"
            - name: SPELL_NAME
              value: "pv-showcase"
          
      
      volumes:
      
        - name: azure-files
          persistentVolumeClaim:
            claimName: pv-showcase-azure-files
        - name: gcp-filestore
          persistentVolumeClaim:
            claimName: pv-showcase-gcp-filestore
        - name: nfs-csi
          persistentVolumeClaim:
            claimName: pv-showcase-nfs-csi
        - name: s3-storage
          persistentVolumeClaim:
            claimName: pv-showcase-s3-storage
