    spelbook: default
    chapter: default
    spell: pv-showcase
spec:
  
  volumeName: pv-showcase-azure-files
  
  storageClassName: "azurefile-csi"
  accessModes:
    - ReadWriteMany
  resources:
    requests:
      storage: 50Gi
