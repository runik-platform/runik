---
# Source: summon/templates/summon.yaml
apiVersion: v1
kind: ServiceAccount
metadata:
  name: pv-showcase
  labels:
    app.kubernetes.io/name: pv-showcase
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: default
    app.kubernetes.io/managed-by: Helm
    spelbook: default
    chapter: default
    spell: pv-showcase
---
# Source: summon/templates/summon.yaml
apiVersion: v1
kind: PersistentVolume
metadata:
    
  name: pv-showcase-azure-files
  labels:
    app.kubernetes.io/name: pv-showcase
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: default
    app.kubernetes.io/managed-by: Helm
    spelbook: default
    chapter: default
    spell: pv-showcase
    volume: azure-files
spec:
  storageClassName: "azurefile-csi"
  capacity:
    storage: 50Gi
  accessModes:
    - ReadWriteMany
  persistentVolumeReclaimPolicy: Retain
  
  csi:
    
    driver: file.csi.azure.com
    volumeHandle: azure-share-001
    
    volumeAttributes:
      resourceGroup: "myResourceGroup"
      shareName: "myshare"
      storageAccount: "mystorageaccount"
    
    nodeStageSecretRef:
      name: azure-secret
      namespace: glyphs-release
---
# Source: summon/templates/summon.yaml
apiVersion: v1
kind: PersistentVolume
metadata:
    
  name: pv-showcase-gcp-filestore
  labels:
    app.kubernetes.io/name: pv-showcase
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: default
    app.kubernetes.io/managed-by: Helm
    spelbook: default
    chapter: default
    spell: pv-showcase
    volume: gcp-filestore
spec:
  storageClassName: "filestore-csi"
  capacity:
    storage: 1Ti
  accessModes:
    - ReadWriteMany
  persistentVolumeReclaimPolicy: Retain
  
  csi:
    
    driver: filestore.csi.storage.gke.io
    volumeHandle: filestore-instance-1/vol1
    
    volumeAttributes:
      ip: "10.0.0.2"
      volume: "vol1"
---
# Source: summon/templates/summon.yaml
apiVersion: v1
kind: PersistentVolume
metadata:
    
  name: pv-showcase-nfs-csi
  labels:
    app.kubernetes.io/name: pv-showcase
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: default
    app.kubernetes.io/managed-by: Helm
    spelbook: default
    chapter: default
    spell: pv-showcase
    volume: nfs-csi
spec:
  storageClassName: "nfs-csi"
  capacity:
    storage: 200Gi
  accessModes:
    - ReadWriteMany
  persistentVolumeReclaimPolicy: Retain
  
  csi:
    
    driver: nfs.csi.k8s.io
    volumeHandle: nfs-server.example.com/exports/data
    
    volumeAttributes:
      server: "nfs-server.example.com"
      share: "/exports/data"
---
# Source: summon/templates/summon.yaml
apiVersion: v1
kind: PersistentVolume
metadata:
    
  name: pv-showcase-s3-storage
  labels:
    app.kubernetes.io/name: pv-showcase
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: default
    app.kubernetes.io/managed-by: Helm
    spelbook: default
    chapter: default
    spell: pv-showcase
    volume: s3-storage
spec:
  storageClassName: "csi-s3"
  capacity:
    storage: 100Gi
  accessModes:
    - ReadWriteMany
  persistentVolumeReclaimPolicy: Retain
  
  csi:
    
    driver: ru.yandex.s3.csi
    volumeHandle: my-s3-bucket/data
    
    volumeAttributes:
      bucket: "my-s3-bucket"
      mounter: "geesefs"
      options: "--memory-limit 2000 --dir-mode 0755 --file-mode 0644"
      region: "us-west-2"
---
