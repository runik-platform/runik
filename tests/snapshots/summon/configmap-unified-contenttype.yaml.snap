# Source: summon/templates/summon.yaml
apiVersion: apps/v1
kind: Deployment
metadata:
  name: app-with-unified-contenttype
  labels:
    app.kubernetes.io/name: app-with-unified-contenttype
    app.kubernetes.io/instance: test
    app.kubernetes.io/part-of: default
    app.kubernetes.io/managed-by: Helm
    spelbook: default
    chapter: default
    spell: app-with-unified-contenttype
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: app-with-unified-contenttype
      app.kubernetes.io/instance: test
  template:
    metadata:
      labels:
        app.kubernetes.io/name: app-with-unified-contenttype
        app.kubernetes.io/instance: test
      
      annotations:
        checksum/configmap-app-config-json: 834d98dd14f747b4d51f27f88641343d191fa853af6d191e6f05565025814c76
        checksum/configmap-app-config-yaml: 49b2e7c53eb04c3aa38f801a889362cf79e9fc7e8cc6d08706be57d8a07f6e03
        checksum/configmap-env-config: 7cc79492f78d94cf7f89376eb38ffc43cbaf78157b051ff772440204101331be
        checksum/secret-db-credentials: 6d57f649b77bea1a58c9d95f9dec5c93120ea606d067832e91c04fbaa1175165
        checksum/secret-tls-cert: 7d1b52ee1ca843e901acb09886247fecaf3822db007da58696c961c681592933
    spec:
      serviceAccountName: app-with-unified-contenttype
      containers:
        
        - name: app-with-unified-contenttype-app-with-unified-contenttype
          image: nginx/app-with-unified-contenttype:latest
          imagePullPolicy: IfNotPresent
          
          
          volumeMounts:
          
            - name: settings-json
              
              mountPath: /app/settings/settings.json
              
              subPath: settings-json
            - name: config-yml
              
              mountPath: /app/config/config.yml
              
              subPath: config-yml
            - name: cert-pem
              mountPath: /app/certs
              
              subPath: cert-pem
          
          envFrom:
          
            - configMapRef:
                name: env-config
            - secretRef:
                name: db-credentials
          
          env:
          
            - name: SPELLBOOK_NAME
              value: "default"
            - name: CHAPTER_NAME
              value: "default"
            - name: SPELL_NAME
              value: "app-with-unified-contenttype"
          
      
      volumes:
      
        - name: settings-json
          configMap:
            name: settings-json
        - name: config-yml
          configMap:
            name: config-yml
        - name: cert-pem
          secret:
            secretName: cert-pem
